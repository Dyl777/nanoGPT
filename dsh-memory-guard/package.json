{
  "name": "dsh-memory-guard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Injects the workspace agent memory into every prompt assembly.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
