@Modulu::TransformerHeuristics

@Technique::TransformerHeuristics::[reproduce]

@Comment::[Paper: Vaswani et al. 2017, arXiv:1706.03762. Graded recreates every table/figure heuristic. Local probes check the same math on tensors; BLEU numbers are the published values.]

from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd()))

from graded.arxiv_llm_lib import (
    paper_1706_fig_positional_encoding,
    paper_1706_eq3_lr_curve,
    paper_1706_table1_complexity,
    paper_1706_table2_bleu,
    paper_1706_table3_ablations,
    paper_1706_table4_parsing,
    paper_1706_fig2_attention_mechanics,
    paper_1706_eq1_attention_identity,
    paper_1706_label_smoothing_entropy,
)

@Impl::TransformerHeuristics::reproduce{
_ = "reproduce published Transformer heuristics"
@}

@Graded::FigPE_Sinusoidal{
plot_ok, pe_relative_mse = paper_1706_fig_positional_encoding()
@}::endpoints::[plot_ok=plot_ok, pe_relative_mse=pe_relative_mse]::commandplot["plt.imshow"]

