@GradedClass::TransformerPaper::[FigPE_Sinusoidal, Eq3_WarmupLR, Table1_Complexity, Table2_WMTBleu, Table3_Ablations, Table4_ConstituencyParsing, Fig2_AttentionMechanics, Eq1_AttentionIdentity, LabelSmoothingEntropy]

@Apply::AllOps
@Run::shuffleAll
@Save::All::endpoints[plot_ok, pe_relative_mse, lr_peak_step, self_attn_cheaper_n_lt_d, paper_bleu_en_de_big, paper_bleu_en_fr_big, best_head_count_table3A, paper_wsj_transformer_f1, causal_mask_ok, multihead_concat_ok, softmax_row_err, residual_ln_shape_ok, label_smoothing_entropy_gap]
