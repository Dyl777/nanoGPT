_ = "reproduce published ConvMem hierarchy + long-context heuristics"
@}

@Graded::Table1_Main{
# Table 1 (s3.2): F1/Sub-EM over 6 methods x 2 sets x 6 lengths. ConvMem best training-free everywhere; OOD flips RL story (MemAgent 75.55->60.92 vs ConvMem 67.44->72.3); Mem-alpha F1 ~0-7, EM 0.0 always.
plot_ok, conv_hotpot, conv_wiki, mem_hotpot, mem_wiki = paper_2609_10441_table1_main()
@}::endpoints::[plot_ok=plot_ok, conv_hotpot=conv_hotpot, conv_wiki=conv_wiki, mem_hotpot=mem_hotpot, mem_wiki=mem_wiki]

@Graded::Fig1_Mechanism{
# Fig.1 (s2.3.1): parallel scan -> recursive Conv -> r=2 skip path -> A; depth O(log N), N_l ~= N0*alpha^l. Structural.
depth, n2, ws = paper_2609_10441_fig1_mechanism()
@}::endpoints::[depth=depth, n2=n2, ws=ws]

@Graded::Fig2_Workflow{
# Fig.2 (s2.4): decompose -> per-channel trees -> sub-answers (Eq.6) -> global A (Eq.7). Structural: 4 stages, Eq.6/7 indexed.
stages, e6, e7 = paper_2609_10441_fig2_workflow()
@}::endpoints::[stages=stages, e6=e6, e7=e7]

@Graded::Equations{
# Eq.1-8 identities: (h,r) levels {0,1,2}; concat Conv; skip buffer; per-channel + recursive Conv; two-stage aggregation; Tlatency O(log N). Local RSS-gate arithmetic.
levels, logN, rss_exit = paper_2609_10441_equations().values()
@}::endpoints::[levels=levels, logN=logN, rss_exit=rss_exit]

@Graded::Fig3_Backbones{
# Fig.3 (s3.2): ConvMem lifts 7B/32B/72B at all lengths; vanilla collapses (lost-in-the-middle). Model-agnostic, no adaptation.
plot_ok, flat = paper_2609_10441_fig3_backbones()
@}::endpoints::[plot_ok=plot_ok, flat=flat]

@Graded::Fig4_StrideSkip{
