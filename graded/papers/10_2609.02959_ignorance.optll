@PL::Python
@Task::Arxiv_2609_02959_Ignorance
@Modulu::PriorGeometry

@Technique::PriorGeometry::[reproduce]

@Comment::[Paper: The Geometry of Ignorance: LLMs Know When to Temper Bayesian Priors (Liu et al. 2026, arXiv:2609.02959). One unembedding direction encodes the corpus unigram: softmax(W d)=p_uni (Eq.1); y=lam*d+y_ctx (Eq.2); centered OLS fit c=0.7 (Eq.4/9); lam=dhat'y/beta (Eq.5); tempered Bayes p~p_uni^lam*L_ctx (Eq.7/12); intervention Eq.8; R2 Eq.11; nKL metric. Universal (4 families, learned not innate), declines with coherent context (Fig.3, shuffled/A-B controls), causal (Fig.4, random flat), |lam| falls with dim (Fig.5), distributed not single-neuron (Fig.10/G). One @Graded per table/figure (per-table granularity). Repo note: no public code found (0 issues reviewable) - text-faithful.]

from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd()))

from graded.arxiv_llm_lib import (
    paper_2609_02959_fig1_overview,
    paper_2609_02959_equations,
    paper_2609_02959_fig2_training,
