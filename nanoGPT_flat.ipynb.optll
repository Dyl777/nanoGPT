        "\"\"\"EncoderHead: bidirectional self-attention head (addernet variant).\"\"\"\n",
        "class EncoderHead(nn.Module):\n",
        "    def __init__(self, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.head_sz, self.emb_dim = head_sz, emb_dim\n",
        "        self.key = AdderConvLinear(emb_dim, head_sz, bias=False)\n",
        "        self.query = AdderConvLinear(emb_dim, head_sz, bias=False)\n",
        "        self.value = AdderConvLinear(emb_dim, head_sz, bias=False)\n",
        "\n",
        "    def forward(self, x):\n",
        "        B, T, C = x.shape\n",
        "        k = self.key(x)\n",
        "        q = self.query(x)\n",
        "        v = self.value(x)\n",
        "        wei = -(q.unsqueeze(-1) - k.unsqueeze(-2)).abs().sum(-1) * C ** -0.5\n",
        "        wei = F.softmax(wei, dim=-1)\n",
        "        out = -(wei.unsqueeze(-1) - v.unsqueeze(-2)).abs().sum(-2)\n",
        "        return out\n",
        "\n",
        "\n",
        "\"\"\"CrossHead: cross-attention head (addernet variant).\"\"\"\n",
        "class CrossHead(nn.Module):\n",
        "    def __init__(self, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.head_sz, self.emb_dim = head_sz, emb_dim\n",
        "        self.key = AdderConvLinear(emb_dim, head_sz, bias=False)\n",
        "        self.query = AdderConvLinear(emb_dim, head_sz, bias=False)\n",
        "        self.value = AdderConvLinear(emb_dim, head_sz, bias=False)\n",
        "\n",
        "    def forward(self, x, enc):\n",
        "        B, T, C = x.shape\n",
        "        k = self.key(enc)\n",
        "        q = self.query(x)\n",
        "        v = self.value(enc)\n",
        "        wei = -(q.unsqueeze(-1) - k.unsqueeze(-2)).abs().sum(-1) * C ** -0.5\n",
        "        wei = F.softmax(wei, dim=-1)\n",
        "        out = -(wei.unsqueeze(-1) - v.unsqueeze(-2)).abs().sum(-2)\n",
        "        return out\n",
        "\n",
        "\n",
        "\"\"\"EncoderBlock: bidirectional multi-head attention + FFN (addernet, regularisedbn).\"\"\"\n",
        "class EncoderBlock(nn.Module):\n",
        "    def __init__(self, emb_dim, n_heads):\n",
        "        super().__init__()\n",
        "        head_sz = emb_dim // n_heads\n",
        "        self.heads = nn.ModuleList([EncoderHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
        "        self.proj = AdderConvLinear(n_heads * head_sz, emb_dim)\n",
        "        self.ffwd = FeedForward(emb_dim)\n",
        "        self.ln1 = RegularisedBN(emb_dim)\n",
        "        self.ln2 = RegularisedBN(emb_dim)\n",
        "\n",
        "    def forward(self, x):\n",
        "        out = torch.cat([h(x) for h in self.heads], dim=-1)\n",
        "        x = x + self.proj(out)\n",
        "        x = x + self.ffwd(self.ln2(x))\n",
        "        return x\n",
        "\n",
        "\n",
        "\"\"\"CrossBlock: causal self-attn + cross-attn to encoder + FFN (addernet, regularisedbn).\"\"\"\n",
        "class CrossBlock(nn.Module):\n",
        "    def __init__(self, emb_dim, n_heads):\n",
        "        super().__init__()\n",
        "        head_sz = emb_dim // n_heads\n",
        "        self.self_attn = MultiHead(n_heads, head_sz, emb_dim)\n",
        "        self.cross_heads = nn.ModuleList([CrossHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
        "        self.cross_proj = AdderConvLinear(n_heads * head_sz, emb_dim)\n",
        "        self.ffwd = FeedForward(emb_dim)\n",
        "        self.ln1 = RegularisedBN(emb_dim)\n",
        "        self.ln2 = RegularisedBN(emb_dim)\n",
        "        self.ln3 = RegularisedBN(emb_dim)\n",
        "\n",
        "    def forward(self, x, enc):\n",
        "        x = x + self.self_attn(self.ln1(x))\n",
        "        cross = torch.cat([h(self.ln2(x), enc) for h in self.cross_heads], dim=-1)\n",
        "        x = x + self.cross_proj(cross)\n",
