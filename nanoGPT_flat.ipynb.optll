        "# ALWAYS-PRESENT runner: ConvMem end-to-end | Wires s15 NIAH builder + convmem_run + F1/EM/Sub-EM over needle docs | emits outputs/convmem_results.json | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Builds needle+distractor docs, runs the hierarchy per channel, grades sub-answers \"\"\"\n",
        "\"\"\"against needle golds, reports per-channel and global metrics with the trace ledger.\"\"\"\n",
        "import json as _json4\n",
        "def run_convmem_benchmark(needles, distractors, queries, W=200, S=40, out_path=\"outputs/convmem_results.json\"):\n",
        "    from pathlib import Path as _P\n",
        "    recs = []\n",
        "    for q, gold in queries:\n",
        "        docs = convmem_build_niah([n for n, _ in needles], distractors)\n",
