      "source": [
        "# ALWAYS-PRESENT implicit single-block patch (live Lemma 7 + Lemma 8/Thm 9) | Paper Lemma 7 (pre-norm input dW, Thm 7 row) + Lemma 8 (outer bias db, Thm 8 row) + Thm 9 (outer weight dW, Llama row) | graded 12_Thm1_Patch/12_Table1_Framework | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Rank-1 input patch on net[0].weight (both paths) plus exact output patch: bias \"\"\"\n",
        "\"\"\"(Theorem 8) if present, else Theorem-9 down-weight form with y = hC (Llama row).\"\"\"\n",
        "\"\"\"Returns deltas + diagnostics, touches nothing.\"\"\"\n",
        "def iw_states(blk, seq, dev):\n",
        "    \"\"\"Run one block on an EMBEDDED sequence; capture (v, z, h) at last position.\"\"\"\n",
        "    \"\"\"v = ln2 input (post-attn residual), z = ffwd input (post-norm), h = down-proj input.\"\"\"\n",
        "    \"\"\"Returns (states dict, block output).\"\"\"\n",
        "    import torch as _t\n",
        "    cap = {}\n",
        "    def _cap(key):\n",
        "        def fn(m, i, o):\n",
        "            cap[key] = i[0].detach()\n",
        "        return fn\n",
        "    h1 = blk.ln2.register_forward_hook(_cap(\"v\"))\n",
        "    h2 = blk.ffwd.net[0].register_forward_hook(_cap(\"z\"))\n",
        "    h3 = blk.ffwd.net[2].register_forward_hook(_cap(\"h\"))\n",
        "    try:\n",
        "        with _t.no_grad():\n",
        "            out = blk(seq.to(dev))\n",
        "    finally:\n",
        "        h1.remove()\n",
        "        h2.remove()\n",
        "        h3.remove()\n",
        "    st = {k: cap[k][0, -1, :].double().cpu().numpy() for k in (\"v\", \"z\", \"h\")}\n",
        "    return st, out.detach()\n",
        "\n",
        "def iw_deltas_for_block(blk, S, SC):\n",
        "    \"\"\"Lemma-7 input patch + Lemma-8/Theorem-9 output patch from reduced/full states.\"\"\"\n",
        "    import torch as _t\n",
        "    import numpy as _np\n",
        "    z = _t.as_tensor(_np.asarray(S[\"z\"], dtype=float)).double()\n",
        "    zC = _t.as_tensor(_np.asarray(SC[\"z\"], dtype=float)).double()\n",
        "    dv = _t.as_tensor(_np.asarray(SC[\"v\"], dtype=float)).double() - _t.as_tensor(_np.asarray(S[\"v\"], dtype=float)).double()\n",
        "    W1 = blk.ffwd.net[0].weight.detach().double()\n",
        "    if W1.dim() == 4:\n",
        "        W1 = W1.squeeze(-1).squeeze(-1)\n",
        "    denom = float(z @ z)\n",
        "    dW1 = ((_t.mv(W1, zC - z))[:, None] * z[None, :]) / max(denom, 1e-30) if denom > 0 else _t.zeros_like(W1)\n",
        "    out = {\"dW1\": dW1, \"dv_norm\": float(dv.norm().item()), \"denom_z\": denom,\n",
        "           \"rank_dW1\": int(_t.linalg.matrix_rank(dW1).item())}\n",
        "    if getattr(blk.ffwd.net[2], \"bias\", None) is not None:\n",
        "        out.update({\"site\": \"out-bias (Theorem 8)\", \"db2\": dv})\n",
        "    else:\n",
        "        hC = _t.as_tensor(_np.asarray(SC[\"h\"], dtype=float)).double()\n",
        "        ynorm = float(hC @ hC)\n",
        "        dW2 = ((dv)[:, None] * hC[None, :]) / max(ynorm, 1e-30) if ynorm > 0 else _t.zeros(W1.shape[1], hC.shape[0]).double()\n",
        "        out.update({\"site\": \"down-weight (Theorem 9)\", \"dW2\": dW2, \"denom_hC\": ynorm})\n",
        "    return out\n",
        "\n",
        "def iw_apply_to_clone(cblk, d):\n",
        "    \"\"\"Add deltas to a CLONED block in place (original never touched).\"\"\"\n",
        "    W1 = cblk.ffwd.net[0].weight\n",
        "    add = d[\"dW1\"].to(W1.dtype)\n",
        "    if W1.dim() == 4:\n",
        "        add = add.unsqueeze(-1).unsqueeze(-1)\n",
        "    W1.data.add_(add)\n",
        "    if d[\"site\"].startswith(\"out-bias\"):\n",
        "        b = cblk.ffwd.net[2].bias\n",
        "        b.data.add_(d[\"db2\"].to(b.dtype))\n",
        "    else:\n",
        "        W2 = cblk.ffwd.net[2].weight\n",
        "        add2 = d[\"dW2\"].to(W2.dtype)\n",
        "        if W2.dim() == 4:\n",
        "            add2 = add2.unsqueeze(-1).unsqueeze(-1)\n",
        "        W2.data.add_(add2)\n",
        "    return cblk\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT implicit multi-layer patch (live Algorithm 1) | Paper Alg.1 lines 2-19 (record targets full-context; sequential single-block updates) + Thm 2 induction on the last position | graded 12_Alg1/12_Fig2_Thm2 | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Patch a deep-copied model so reduced-context forward matches full-context forward.\"\"\"\n",
        "\"\"\"Induction runs on the last (query) position: same token and position in both passes.\"\"\"\n",
        "\"\"\"The reduced pass carries computed states forward (honest error accumulation, no forcing).\"\"\"\n",
        "\"\"\"Original model never touched.\"\"\"\n",
        "def iw_embed(model, ids, dev):\n",
        "    import torch as _t\n",
        "    xb = _t.tensor([ids], dtype=_t.long).to(dev)\n",
        "    with _t.no_grad():\n",
        "        return (model.token_embedding(xb) + model.position_embedding(\n",
        "            _t.arange(xb.shape[1], device=dev).unsqueeze(0))).detach()\n",
        "\n",
        "def iw_patch_model(model, ids_full, ids_red):\n",
        "    import torch as _t\n",
        "    import copy as _copy\n",
        "    import numpy as _np\n",
        "    dev = next(model.parameters()).device\n",
        "    model.eval()\n",
        "    clone = _copy.deepcopy(model).to(dev).eval()\n",
        "    with _t.no_grad():\n",
        "        logits_f = model(_t.tensor([ids_full], dtype=_t.long).to(dev))\n",
        "    h_f = iw_embed(model, ids_full, dev)\n",
        "    full_states, full_outs = [], []\n",
        "    for blk in model.blocks:\n",
        "        st, out = iw_states(blk, h_f, dev)\n",
        "        full_states.append(st)\n",
        "        full_outs.append(out)\n",
        "        h_f = out\n",
        "    h_r = iw_embed(clone, ids_red, dev)\n",
        "    diags = []\n",
        "    for l, blk in enumerate(model.blocks):\n",
        "        S, out_r = iw_states(clone.blocks[l], h_r, dev)\n",
        "        d = iw_deltas_for_block(blk, S, full_states[l])\n",
        "        iw_apply_to_clone(clone.blocks[l], d)\n",
        "        with _t.no_grad():\n",
        "            out_p = clone.blocks[l](h_r)\n",
        "        resid = float(_np.linalg.norm(\n",
        "            (out_p[0, -1, :].double().cpu().numpy() - full_outs[l][0, -1, :].double().cpu().numpy()), _np.inf))\n",
        "        diags.append({\"layer\": l, \"site\": d[\"site\"], \"rank_dW1\": d[\"rank_dW1\"],\n",
        "                      \"dv_norm\": d[\"dv_norm\"], \"linf_vs_target\": resid})\n",
        "        h_r = out_p\n",
        "    with _t.no_grad():\n",
        "        logits_p = clone(_t.tensor([ids_red], dtype=_t.long).to(dev))\n",
        "    fin = float(_np.linalg.norm((logits_p[0, -1, :].double().cpu().numpy() -\n",
        "                                 logits_f[0, -1, :].double().cpu().numpy()), _np.inf))\n",
        "    return clone, {\"layers\": diags, \"final_linf\": fin,\n",
        "                   \"logits_full\": logits_f.detach(), \"logits_patched\": logits_p.detach()}\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT implicit-patch metrics + plot (live s4 analog) | Paper s4 (token match, L_inf logits, TVD = 0.5*||p-q||_1, per-token curves, forced-continuation protocol note) | graded 12_Fig3_Text/12_Fig4_Summary/12_Fig5_Image | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Compare patched-reduced vs full-context logits: L_inf, TVD, token match + curves.\"\"\"\n",
        "def iw_tvd(logits_p, logits_f):\n",
        "    import torch as _t\n",
        "    pp = _t.softmax(logits_p.double(), dim=-1)\n",
        "    qq = _t.softmax(logits_f.double(), dim=-1)\n",
        "    return float(0.5 * (pp - qq).abs().sum().item())\n",
        "\n",
        "def iw_compare(logits_p, logits_f, span=None):\n",
        "    import torch as _t\n",
        "    import numpy as _np\n",
        "    lp = logits_p[0].double().cpu()\n",
        "    lf = logits_f[0].double().cpu()\n",
        "    idx = range(lp.shape[0]) if span is None else range(*span)\n",
        "    linf, tvds, match = [], [], []\n",
        "    for t in idx:\n",
        "        linf.append(float((lp[t] - lf[t]).abs().max().item()))\n",
        "        tvds.append(iw_tvd(lp[t], lf[t]))\n",
        "        match.append(1 if int(lp[t].argmax()) == int(lf[t].argmax()) else 0)\n",
        "    return {\"linf\": linf, \"tvd\": tvds, \"match\": match,\n",
        "            \"max_linf\": max(linf), \"mean_tvd\": sum(tvds) / max(1, len(tvds)),\n",
        "            \"match_rate\": sum(match) / max(1, len(match))}\n",
        "\n",
        "def iw_plot_equiv(cmp, out_prefix=\"outputs/iw_live\", tokens=None):\n",
        "    \"\"\"Live Fig.3 analog: per-position L_inf + TVD curves, mismatches marked.\"\"\"\n",
        "    import matplotlib.pyplot as _plt\n",
        "    _plt.rcParams.update({\"figure.facecolor\": \"white\", \"axes.grid\": True,\n",
        "                          \"grid.alpha\": 0.25, \"font.size\": 10})\n",
        "    n = len(cmp[\"linf\"])\n",
        "    xs = range(n)\n",
        "    fig, axes = _plt.subplots(2, 1, figsize=(10, 5.6), sharex=True)\n",
        "    axes[0].plot(xs, [max(v, 1e-12) for v in cmp[\"linf\"]], \"o-\", ms=3.5, label=\"patched vs full\")\n",
        "    for t, m in enumerate(cmp[\"match\"]):\n",
        "        if not m:\n",
        "            axes[0].plot(t, max(cmp[\"linf\"][t], 1e-12), \"rx\", ms=9, mew=2)\n",
        "    axes[0].set_yscale(\"log\")\n",
        "    axes[0].set_ylabel(\"Linf Norm Logit Difference\")\n",
        "    axes[0].legend(fontsize=8)\n",
        "    axes[1].plot(xs, [max(v, 1e-12) for v in cmp[\"tvd\"]], \"o-\", ms=3.5, color=\"#55a868\")\n",
        "    axes[1].set_yscale(\"log\")\n",
        "    axes[1].set_ylabel(\"Total Variation Distance\")\n",
        "    if tokens is not None:\n",
        "        axes[1].set_xticks(list(xs))\n",
        "        axes[1].set_xticklabels(tokens, rotation=55, ha=\"right\", fontsize=7.5)\n",
        "    axes[1].set_xlabel(\"Query position\")\n",
        "    fig.tight_layout()\n",
        "    fig.savefig(out_prefix + \"_equiv.png\", dpi=150, bbox_inches=\"tight\")\n",
        "    _plt.close(fig)\n",
        "    return out_prefix + \"_equiv.png\"\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
