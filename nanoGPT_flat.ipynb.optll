      "source": [
        "# ALWAYS-PRESENT \u00a729 KeepKV composition (paper \u00a73.3-4.5) | Plain preset: any evictor supplies the keep/evict split per head, KeepKV merges evicted into most-similar retained (threshold T) with ZIP weights; plus the periodic-lossless byte/schedule plan (external full store + resident compressed + reloads) | NOT a new axis (combination precedent).\n",
        "import torch as _t27\n",
        "def keepkv_preset(harness, evictor=None, budget=32, threshold=0.8, seed=0):\n",
        "    \"\"\"KeepKV over an evictor split, per head (paper \u00a74.5 pattern).\n",
        "\n",
        "    evictor: NoneEvictor-style keep-set source (default: H2O top-K); pass any\n",
        "        \u00a727 evictor instance. Merging follows Alg.1 with current-step unnormalized scores as ZIP weights\n",
        "        (exactness per Thm.3 needs unnormalized exp scores: the log terms do not survive normalization);\n",
        "        accumulated scores drive evictor selection only.\n",
        "    Returns mass (represented-token), output error (vote-aware), bytes, sag-vs-zip.\n",
        "    Returns mass (vote-aware), output error (vote-aware), bytes, sag-vs-zip.\n",
        "    \"\"\"\n",
        "    kk = KeepKVCompressor(threshold)\n",
        "    if evictor is None:\n",
        "        evictor = H2OEvictor()\n",
        "    mass, err, nbytes, sag, zerr = [], [], 0, [], []\n",
        "    for k, c in harness.cache.items():\n",
        "        S = c[\"S\"]\n",
        "        T = c[\"K\"].shape[0]\n",
        "        W = min(8, T)\n",
        "        kept = evictor.select(S.sum(0), min(budget, T), win=S[-W:], recent_w=6, seed=seed)\n",
        "        acc = S.sum(0)\n",
        "        Kh, Vh, meta = kk.compress(c[\"K\"], c[\"V\"], keep=kept, scores=_t27.exp(\n",
        "            c[\"qlast\"].unsqueeze(0) @ c[\"K\"].T / (c[\"head_dim\"] ** 0.5)).squeeze(0))\n",
        "        nbytes += meta[\"bytes\"]\n",
        "        o_full = S[-1] @ c[\"V\"]\n",
        "        o_z, s_z = kk.merged_attention(Kh, Vh, meta[\"votes\"], c[\"qlast\"], c[\"head_dim\"])\n",
        "        err.append(float((o_z - o_full).norm() / (o_full.norm() + 1e-12)))\n",
        "        mass.append(float(S[-1][meta[\"represented\"]].sum()))\n",
        "        ev = [i for i in range(T) if i not in set(kept.tolist())]\n",
        "        if ev:\n",
        "            e0 = ev[0]\n",
        "            Kn = c[\"K\"] / c[\"K\"].norm(dim=-1, keepdim=True).clamp_min(1e-12)\n",
        "            sims = Kn[e0] @ Kn[kept].T\n",
        "            cc = int(kept[int(sims.argmax())])\n",
        "            krc, vrc = _keepkv_convex(c[\"K\"], c[\"V\"], e0, cc)\n",
        "            src = float(torch.exp(c[\"qlast\"] @ krc / (c[\"head_dim\"] ** 0.5)))\n",
        "            rest = [i for i in range(T) if i not in (e0, cc)]\n",
        "            cur = _t27.exp(c[\"qlast\"].unsqueeze(0) @ c[\"K\"].T / (c[\"head_dim\"] ** 0.5)).squeeze(0)\n",
        "            oc = (cur[rest] @ c[\"V\"][rest] + src * vrc) / (cur[rest].sum() + src)\n",
        "            sag.append(float((oc - o_full).norm()))\n",
        "            se0 = float(cur[e0])\n",
        "            sc0 = float(cur[cc])\n",
        "            krz, vrz, prz = kk.zip_merge(c[\"K\"], c[\"V\"], e0, cc, se0, sc0)\n",
        "            srz = float(torch.exp(c[\"qlast\"] @ krz / (c[\"head_dim\"] ** 0.5)))\n",
        "            oz = (cur[rest] @ c[\"V\"][rest] + prz * srz * vrz) / (cur[rest].sum() + prz * srz)\n",
        "            zerr.append(float((oz - o_full).norm()))\n",
        "    return {\"recipe\": {\"split\": type(evictor).__name__, \"merge\": \"ZIP votes (T=%.2f)\" % threshold},\n",
        "            \"mass\": float(sum(mass) / max(1, len(mass))),\n",
        "            \"out_err\": float(sum(err) / max(1, len(err))), \"bytes\": nbytes,\n",
        "            \"sag_mean\": float(sum(sag) / max(1, len(sag))),\n",
        "            \"zip_mean\": float(sum(zerr) / max(1, len(zerr)))}\n",
        "def _keepkv_convex(K, V, e, c):\n",
        "    Kn = K / K.norm(dim=-1, keepdim=True).clamp_min(1e-12)\n",
        "    sims = Kn[[e, c]] @ Kn[c]\n",
        "    w = _t27.softmax(sims, dim=0)\n",
        "    return w[0] * K[e] + w[1] * K[c], w[0] * V[e] + w[1] * V[c]\n",
        "def keepkv_periodic_plan(spec, period=64, resident_ratio=0.2):\n",
        "    \"\"\"Periodic lossless scheme (paper \u00a73.3): full cache lives externally;\n",
        "    resident compressed reps reload every period steps. Policy simulation\n",
        "    (declared): exact byte math, reload schedule; transfer timing stand-in.\n",
        "    \"\"\"\n",
        "    full = 2 * spec[\"T\"] * spec[\"H\"] * spec[\"hs\"] * spec[\"bpe\"] * spec[\"L\"]\n",
        "    resident = int(full * resident_ratio)\n",
        "    reloads = max(1, spec[\"T\"] // max(1, period))\n",
        "    return {\"external_bytes\": full, \"resident_bytes\": resident,\n",
        "            \"reload_every\": period, \"n_reloads\": reloads,\n",
        "            \"reload_bytes\": resident * reloads,\n",
        "            \"effective_residency\": resident / max(1, full)}\n"
      ]
    },
    {
      "cell_type": "code",
