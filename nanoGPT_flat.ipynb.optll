    @Impl::Scale::small256{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Scale small256 (emb 256, 8 layers, 8 heads, ~4M). First scale where probe \"\"\"\n",
