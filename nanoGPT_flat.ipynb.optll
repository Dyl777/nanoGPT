        "               \"d_speedup_03_07\": (tg[0] / tg[2]) if tg[0] and tg[2] else None,\n",
        "               \"pred_speedup_03_07\": (0.3 / 0.7) ** -2.04,\n",
        "               \"norm_in_band\": [r[\"r_star_band\"] for r in rows]}\n",
        "    out = {\"rows\": rows, \"verdict\": verdict}\n",
        "    _P(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P(out_path).write_text(_json3.dumps(out, indent=2, default=str))\n",
        "    return out\n"
      ]
    },
    {
