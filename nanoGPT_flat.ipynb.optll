        "\"\"\"Multi-head self-attention module.\"\"\"\n",
        "class MultiHead(nn.Module):\n",
        "    def __init__(self, n_heads, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.n_heads, self.head_sz, self.emb_dim = n_heads, head_sz, emb_dim\n",
@Impl::Attn::mqa{
        "        # MQA: n_heads queries share ONE key/value (Shazeer 2019)\n",
        "        self.queries = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(n_heads)])\n",
        "        self.key = QKVLinear(emb_dim, head_sz, bias=False)\n",
        "        self.value = QKVLinear(emb_dim, head_sz, bias=False)\n",
}@}
@Impl::Attn::gqa{
        "        # GQA: queries grouped over n_kv_heads key/values (Ainslie et al. 2023)\n",
        "        self.n_kv_heads = max(1, n_heads // 2)\n",
        "        self.queries = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(n_heads)])\n",
        "        self.keys = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(self.n_kv_heads)])\n",
        "        self.values = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(self.n_kv_heads)])\n",
}@}
@Impl::Attn::vanillaatten{
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::mla{
        "        # MLA: compression lives inside each Head\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::dsa{
        "        # DSA: sparsity lives inside each Head\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::tokenformer{
        "        # TokenFormer: capacity lives in each Head's parameter tokens\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::tpa{
        "        # TPA: factorization lives inside each Head\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
        @Impl::Attn::linearatten{
        "        # Linear attention: kernel recurrence lives inside each Head (Katharopoulos et al. 2020)\n",
        "        self.heads = nn.ModuleList([LinearAttnHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::loglinearatten{
        "        # Log-linear attention: Fenwick buckets live inside each Head (Guo et al. 2026)\n",
        "        self.heads = nn.ModuleList([LogLinearAttnHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::locallinearatten{
        "        # Local linear attention: windowed regression lives inside each Head (Zuo et al. 2025)\n",
        "        self.heads = nn.ModuleList([LocalLinearAttnHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::kimilinear{
        "        # KIMI linear: KDA recurrence + gates live inside each Head (Kimi Team 2025)\n",
        "        self.heads = nn.ModuleList([KimiLinearHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
"        self.proj = QKVLinear(n_heads * head_sz, emb_dim)\n",
        "        self.register_buffer(\"tril\", torch.tril(torch.ones(ctx_len, ctx_len)))\n",
        "\n",
        "    def forward(self, x):\n",
        "        B, T, C = x.shape\n",
@Impl::Attn::mqa{
        "        k = self.key(x)\n",
        "        v = self.value(x)\n",
        "        outs = []\n",
        "        for q_layer in self.queries:\n",
        "            q = q_layer(x)\n",
        "            wei = attn_scores(q, k) * (self.head_sz ** -0.5)\n",
        "            wei = wei.masked_fill(self.tril[:T, :T] == 0, float(\"-inf\"))\n",
        "            wei = F.softmax(wei, dim=-1)\n",
        "            outs.append(attn_combine(wei, v))\n",
        "        out = torch.cat(outs, dim=-1)\n",
}@}
@Impl::Attn::gqa{
        "        ks = [k_layer(x) for k_layer in self.keys]\n",
        "        vs = [v_layer(x) for v_layer in self.values]\n",
        "        outs = []\n",
        "        for i, q_layer in enumerate(self.queries):\n",
        "            q = q_layer(x)\n",
        "            k = ks[(i * self.n_kv_heads) // self.n_heads]\n",
        "            v = vs[(i * self.n_kv_heads) // self.n_heads]\n",
        "            wei = attn_scores(q, k) * (self.head_sz ** -0.5)\n",
        "            wei = wei.masked_fill(self.tril[:T, :T] == 0, float(\"-inf\"))\n",
        "            wei = F.softmax(wei, dim=-1)\n",
        "            outs.append(attn_combine(wei, v))\n",
        "        out = torch.cat(outs, dim=-1)\n",
}@}
@Impl::Attn::vanillaatten{
