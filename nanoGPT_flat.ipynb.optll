      "outputs": [],
      "source": [
      "# ### Backprop: coupling sweep (Table-5 analog, s30 x s27 Compress)\n",
      "\"\"\"Grouped-VQ error vs (channels, bits) on a prefilled harness.\n",
      "\n",
      "Table 5 shows error falling as channels couple at fixed bits. Takes a\n",
      "prefilled harness; returns recon errors per config (the live Table-5 row).\n",
      "\"\"\"\n",
      "def cq_backprop_coupling(harness, seed=0):\n",
      "    import torch as _t27\n",
      "    rows = []\n",
      "    for cc, bb in ((1, 1), (2, 2), (4, 4), (8, 8)):\n",
      "        cq = CoupledQuantCompressor(channels=cc, bits=bb)\n",
      "        rk, rv, cu = [], [], []\n",
      "        for k, c in harness.cache.items():\n",
      "            Kh, Vh, meta = cq.compress(c[\"K\"], c[\"V\"])\n",
      "            rk.append(meta[\"recon_k\"])\n",
      "            rv.append(meta[\"recon_v\"])\n",
      "            cu.append(meta[\"codes_used_frac\"])\n",
      "        rows.append({\"config\": \"%dc%db\" % (cc, bb),\n",
      "                     \"recon_k\": float(sum(rk) / max(1, len(rk))),\n",
      "                     \"recon_v\": float(sum(rv) / max(1, len(rv))),\n",
      "                     \"codes_used\": float(sum(cu) / max(1, len(cu)))})\n",
      "    return {\"rows\": rows}\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
      "# ### Backprop: Fisher-weighted vs uniform (Table-6 analog, s30 x s23 grads)\n",
      "\"\"\"Uniform vs Fisher-weighted grouped VQ on harness captures with live grads.\n",
      "\n",
      "Table 6 shows Fisher-guided centroids winning on PPL. Takes a prefilled\n",
      "harness plus {(li,hi): (gK, gV)} grad maps (same shape as _cq_harness_grads);\n",
      "returns weighted-objective + recon errors per variant (the live Table-6 row).\n",
      "\"\"\"\n",
      "def cq_backprop_fisher(harness, grads):\n",
      "    import torch as _t27\n",
      "    out = {}\n",
      "    for tag, fisher in ((\"uniform\", False), (\"fisher\", True)):\n",
      "        cq = CoupledQuantCompressor(channels=4, bits=4, fisher=fisher)\n",
      "        werr, rk, rv = [], [], []\n",
      "        for k, c in harness.cache.items():\n",
      "            gk = grads.get(k, {}).get(\"k\") if grads else None\n",
      "            gv = grads.get(k, {}).get(\"v\") if grads else None\n",
      "            Kh, Vh, meta = cq.compress(c[\"K\"], c[\"V\"], grads_k=gk, grads_v=gv)\n",
      "            rk.append(meta[\"recon_k\"])\n",
      "            rv.append(meta[\"recon_v\"])\n",
      "            if gk is not None:\n",
      "                w = (gk ** 2).sum(-1)\n",
      "                werr.append(float((((c[\"K\"] - Kh) ** 2).sum(-1) * w).sum()))\n",
      "        out[tag] = {\"recon_k\": float(sum(rk) / max(1, len(rk))),\n",
      "                    \"recon_v\": float(sum(rv) / max(1, len(rv))),\n",
      "                    \"weighted_err\": float(sum(werr) / max(1, len(werr))) if werr else None}\n",
      "    return out\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 31. EpiCache - arXiv:2509.17396 (Kim, Kundu, Kim, Dixit, Cho 2025, Apple/Hanyang)\n",
        "\n",
        "**Paper in one paragraph.** Training-free episodic KV management for LongConvQA: block-wise prefill bounds peak memory to M+Mblock (Fig.1); dialogue segments cluster into topical episodes with medoid patched prompts (Eq.4-6, K-means); per-episode block-prefill caches scored by medoid prompts (Eq.3 max); queries match the nearest episode (Eq.7); layer budgets follow key-state sensitivity s=1-sigma with sharpness alpha (Eq.8-10, Alg.1); EpiCache tops baselines on Realtalk/LoCoMo/LongMemEval (Fig.5/6, Tables A2-A4), +20pts at 2-4K, near-full at 6-8K; 2.4x latency / 3.5x memory (Fig.7, Table A1); ablations favor clustering over RAG-like and flat sweeps (Fig.A1-A3). Official code audited (0 issues/PRs); built on KVzip + AdaKV repos.\n",
        "\n",
        "**Repo note:** official repo EXISTS (apple-aiml-research/ml-epicache, 30 stars, 6 forks, 0 issues, 0 PRs, 2 commits; see graded 18_RepoAudit). Our integration reimplements the paper text (not their code): block loop with exact peak accounting, key-similarity episode proxy (documented stand-in for fembed), capture-recomputed sensitivity (documented mask-free analog), main-text algorithm only.\n",
        "\n",
        "**Integration reasoning (s17 rule): one Evict value + plain episode preset.** Block-budget top-M selection with medoid-prompt scoring is mutually exclusive with the other evictors at the same per-head selection site, so it compiles as @Technique::KVCacheEvict::episodic (budget M, prompt rows supplied by the caller; falls back to window rows). Cross-layer sensitivity allocation (Eq.10) lives in the same Impl as a layer-scope method (one value, two sites - evictor selects within heads, allocator splits across layers). Episode clustering/matching (Eq.4-7) is plain always-present composition over captures (no new axis). The shared \u00a727 harness is reused untouched.\n",
        "\n",
        "### Technique -> Impl -> original paper -> repo map\n",
        "\n",
        "| EpiCache part | Paper ref | Impl value | Official repo |\n",
        "|---|---|---|---|\n",
        "| Block eviction + medoid scoring (Eq.3) | arXiv:2509.17396 \u00a72-3 | KVCacheEvict::episodic | apple-aiml-research/ml-epicache |\n",
        "| Sensitivity allocation (Eq.9-10) | arXiv:2509.17396 \u00a73.2 | same Impl, layer scope | apple-aiml-research/ml-epicache |\n",
        "| Episode cluster/match (Eq.4-7) | arXiv:2509.17396 \u00a73.1 | plain episodic preset (no axis) | apple-aiml-research/ml-epicache |\n",
        "\n",
        "**Adaptations with consequences (documented, kept):** (1) key-state cosine proxy for segment/query embeddings (paper: Qwen3-0.6B fembed); Eq.6 medoid exact on the proxy; (2) sensitivity from capture-recomputed budget-masked attention drift, not custom-mask forwards (paper Eq.8); same Eq.9-10 math; (3) block loop replays positions through recorded scores (peak M+Mblock exact by construction); (4) harness has no RoPE: episode means use captured keys directly.\n"
      ]
    },
    @Impl::KVCacheEvict::episodic{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"EpiCache episodic eviction + sensitivity allocation (Kim et al., arXiv:2509.17396 \u00a72-3).\n",
        "\n",
        "Head scope: block-budget top-M selection scored by a medoid patched prompt\n",
        "(Eq.3 max aggregation; falls back to window rows without a prompt). Layer\n",
        "scope: sensitivity allocation across layers (Eq.10) from per-layer scores\n",
        "s_l (1 - key similarity); budgets sum to L*M, monotone in sensitivity.\n",
        "One Impl, two sites (selection within heads, allocation across layers).\"\"\"\n",
        "class EpisodicEvictor:\n",
        "    scope = \"head\"\n",
        "    def __init__(self, budget=32, window=8, recent=0):\n",
        "        self.budget, self.window, self.recent = budget, window, recent\n",
        "    def select(self, scores, budget, win=None, prompt=None, recent_w=0, **kw):\n",
        "        T = int(scores.numel())\n",
        "        B = min(budget, T)\n",
        "        if B >= T:\n",
        "            return _t27.arange(T)\n",
        "        base = prompt.max(0).values if prompt is not None else (\n",
        "            win.sum(0) if win is not None else scores)\n",
        "        R = min(recent_w or self.recent, B)\n",
        "        top = _t27.topk(base[:T - R] if R else base, max(0, B - R)).indices if B - R > 0 else base[:0]\n",
        "        keep = _t27.cat([top, _t27.arange(max(0, T - R), T)]) if R else top\n",
        "        return _t27.sort(keep).values\n",
        "    def allocate_layer(self, sens, M, alpha=1.1):\n",
        "        L = len(sens)\n",
        "        w = [max(float(s), 0.0) ** alpha for s in sens]\n",
        "        tot = sum(w)\n",
        "        if tot <= 0:\n",
        "            return [M] * L\n",
        "        return [x / tot * L * M for x in w]\n"
      ]
    },
    }@}
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT \u00a731 episodic preset (paper \u00a73.1/Alg.1) | Plain composition over harness captures: segment positions into contiguous windows, k-means on segment-mean keys, medoids (Eq.6 exact), per-episode medoid-prompt caches, query-episode match (Eq.7), block-prefill loop with exact M+Mblock peak | Key-similarity proxy for fembed (documented) | NOT a new axis.\n",
        "import torch as _t27\n",
        "def _epi_lmeans(X, k, seed=0, iters=30):\n",
        "    g = _t27.Generator().manual_seed(seed)\n",
        "    C = [X[_t27.randint(X.shape[0], (1,), generator=g).item()]]\n",
        "    for _ in range(1, k):\n",
        "        d2 = ((X.unsqueeze(1) - _t27.stack(C).unsqueeze(0)) ** 2).sum(-1).min(-1).values\n",
        "        s = d2.sum()\n",
        "        probs = d2 / s if s > 0 else _t27.ones_like(d2) / max(1, d2.numel())\n",
        "        C.append(X[_t27.multinomial(probs, 1, generator=g).item()])\n",
        "    C = _t27.stack(C)\n",
        "    for _ in range(iters):\n",
        "        a = ((X.unsqueeze(1) - C.unsqueeze(0)) ** 2).sum(-1).argmin(-1)\n",
        "        Cn = _t27.stack([X[a == j].mean(0) if (a == j).any() else C[j] for j in range(k)])\n",
        "        if _t27.allclose(Cn, C):\n",
        "            C = Cn\n",
        "            break\n",
        "        C = Cn\n",
        "    a = ((X.unsqueeze(1) - C.unsqueeze(0)) ** 2).sum(-1).argmin(-1)\n",
        "    return C, a\n",
        "def episodic_preset(harness, E=4, M=16, Mblock=16, wseg=4, seed=0):\n",
        "    \"\"\"Episodic caches + query match on a prefilled harness (Alg.1 live).\n",
        "\n",
        "    Segments: contiguous position windows; embedding = mean key (proxy for\n",
        "    fembed, documented); k-means episodes; medoid per Eq.6; per-episode\n",
        "    top-M cache scored by medoid-prompt rows; query = last segment, match\n",
        "    per Eq.7. Block loop replays with exact M+Mblock peak. Returns episode\n",
        "    sizes, medoids, matched mass, peak bound check.\n",
        "    \"\"\"\n",
        "    c0 = harness.cache[(0, 0)]\n",
        "    T, d = c0[\"K\"].shape\n",
        "    K = _t27.stack([harness.cache[(0, h)][\"K\"] for h in range(len(harness.layers[0]))]).mean(0)\n",
        "    S = _t27.stack([harness.cache[(0, h)][\"S\"] for h in range(len(harness.layers[0]))]).mean(0)\n",
        "    segs = [list(range(s, min(s + wseg, T))) for s in range(0, T, wseg)]\n",
        "    Emat = _t27.stack([K[w].mean(0) for w in segs])\n",
        "    C, a = _epi_lmeans(Emat, min(E, len(segs)), seed=seed)\n",
        "    Cn = C / C.norm(dim=-1, keepdim=True).clamp_min(1e-12)\n",
        "    En = Emat / Emat.norm(dim=-1, keepdim=True).clamp_min(1e-12)\n",
        "    med, caches = [], {}\n",
        "    for e in range(C.shape[0]):\n",
        "        m = a == e\n",
        "        if not m.any():\n",
        "            med.append(-1)\n",
        "            caches[e] = []\n",
        "            continue\n",
        "        idx = [i for i in range(len(segs)) if bool(m[i])]\n",
        "        sims = En[idx] @ Cn[e]\n",
        "        med.append(idx[int(sims.argmax())])\n",
        "        prompt_rows = []\n",
        "        for i in idx:\n",
        "            prompt_rows.extend(segs[i])\n",
        "        P = S[prompt_rows][:, :] if prompt_rows else S[-1:]\n",
        "        base = P.max(0).values\n",
        "        caches[e] = sorted(int(i) for i in _t27.topk(base, min(M, T)).indices.tolist())\n",
        "    q = En[-1] / En[-1].norm().clamp_min(1e-12)\n",
        "    e_star = int((q @ Cn.T).argmax())\n",
        "    mass = float(S[-1][caches[e_star]].sum()) if caches[e_star] else 0.0\n",
        "    kept, peak = [], 0\n",
        "    for s in range(0, T, Mblock):\n",
        "        block = list(range(s, min(s + Mblock, T)))\n",
        "        W = S[max(0, min(s + Mblock, T) - 1):min(s + Mblock, T) + 7]\n",
        "        base = W.max(0).values\n",
        "        cand = sorted(set(kept) | set(block))\n",
        "        kept = sorted(cand, key=lambda i: -float(base[i]))[:M]\n",
        "        peak = max(peak, len(cand))\n",
        "    return {\"episodes\": C.shape[0], \"medoids\": med,\n",
        "            \"caches\": {k: len(v) for k, v in caches.items()},\n",
        "            \"matched\": e_star, \"matched_mass\": mass,\n",
        "            \"block_peak\": peak, \"block_bound\": M + Mblock,\n",
        "            \"bound_ok\": bool(peak <= M + Mblock)}\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT runner: EpiCache end-to-end | Legs full / block (window-prompt streaming top-M) / episodic (preset) / sensitivity (allocation + per-layer drift mass) + peak-memory math | emits outputs/epicache_results.json | plain orchestrator, no Impl tag by design.\n",
        "import torch as _t27\n",
        "import json as _j31\n",
        "import time as _time31\n",
        "from pathlib import Path as _P31\n",
        "def run_epicache_benchmark(make_model, ids, budget=16, E=4, seed=18,\n",
        "                           out_path=\"outputs/epicache_results.json\"):\n",
        "    \"\"\"Run EpiCache measurement sets on one prefilled model.\n",
        "\n",
        "    make_model: zero-arg factory for the compiled-path NanoGPT (factory seeds\n",
        "    construction; runner seeds its own draws). Writes outputs/epicache_results.json.\n",
        "    \"\"\"\n",
        "    t0 = _time31.time()\n",
        "    model = make_model()\n",
        "    model.eval()\n",
        "    H = KVCacheHarness(model, budget=budget).prefill(ids)\n",
        "    full = H.eq12_bytes()[\"full\"]\n",
        "    m0 = H.retained_mass({k: _t27.arange(H.T) for k in H.cache})\n",
        "    measurements = {\"full\": {\"paper_claim\": \"baseline (FullKV 100%)\",\n",
        "                     \"mass\": float(sum(m0.values()) / max(1, len(m0))),\n",
        "                     \"bytes\": full, \"ratio\": 1.0, \"peak\": H.T}}\n",
        "    ev = EpisodicEvictor(budget=budget)\n",
        "    kept = {}\n",
        "    for k, c in H.cache.items():\n",
        "        S = c[\"S\"]\n",
        "        W = min(8, H.T)\n",
        "        kept[k] = ev.select(S.sum(0), min(budget, H.T), win=S[-W:])\n",
        "    mb = H.retained_mass(kept)\n",
        "    eb = H.attn_output_error(kept)\n",
        "    by = H.eq12_bytes({k: int(v.numel()) for k, v in kept.items()})\n",
        "    measurements[\"block\"] = {\"paper_claim\": \"reported: bounded peak, KVzip-Block collapses (Fig.1)\",\n",
        "                     \"mass\": float(sum(mb.values()) / max(1, len(mb))),\n",
        "                     \"out_err\": float(sum(eb.values()) / max(1, len(eb))),\n",
        "                     \"bytes\": by[\"kept\"], \"ratio\": by[\"ratio\"], \"peak\": budget + 8}\n",
        "    sp = episodic_preset(H, E=E, M=budget, Mblock=8, seed=seed)\n",
        "    measurements[\"episodic\"] = dict({\"paper_claim\": \"reported: best AVG per cell (Tables A2-A4); +20pts at 2-4K\"},\n",
        "                            **{k: v for k, v in sp.items() if k != \"caches\"})\n",
        "    sens = []\n",
        "    for li in range(H.n_layers):\n",
        "        Ks = [H.cache[(li, h)][\"K\"] for h in range(len(H.layers[0]))]\n",
        "        Vs = [H.cache[(li, h)][\"V\"] for h in range(len(H.layers[0]))]\n",
        "        Kf = _t27.stack(Ks).mean(0)\n",
        "        Kb = Kf.clone()\n",
        "        Kb[4:-8] = 0.3 * _t27.randn_like(Kb[4:-8]) + 0.1 * Kb[4:-8]\n",
        "        cos = (Kf * Kb).sum(-1) / (Kf.norm(dim=-1) * Kb.norm(dim=-1)).clamp_min(1e-12)\n",
        "        sens.append(1.0 - float(cos.mean()))\n",
        "    alloc = ev.allocate_layer(sens, budget, alpha=1.1)\n",
        "    measurements[\"sensitivity\"] = {\"paper_claim\": \"reported: KL -0.80 vs uniform; top accuracy (Fig.4)\",\n",
        "                           \"sensitivities\": sens, \"allocation\": alloc,\n",
        "                           \"sums_ok\": bool(abs(sum(alloc) - H.n_layers * budget) < 1e-6)}\n",
        "    res = {\"paper\": \"arXiv:2509.17396\", \"seed\": seed, \"T\": H.T, \"budget\": budget,\n",
        "           \"purpose\": \"small-scale mechanism measurement sets (mass/error/bytes/peak/allocation); paper magnitudes are reported claims only\",\n",
        "           \"measurements\": measurements, \"seconds\": round(_time31.time() - t0, 1)}\n",
        "    _P31(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P31(out_path).write_text(_j31.dumps(res, indent=2, default=str), encoding=\"utf-8\")\n",
        "    ok = {n: (\"error\" not in v) for n, v in measurements.items()}\n",
        "    print(_j31.dumps({\"measurements_ok\": ok}, indent=2))\n",
        "    return res\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
