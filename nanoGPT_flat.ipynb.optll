    @Impl::Scale::faithful512{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Scale faithful512 (emb 512, 12 layers, 8 heads, ~25M). Closest-to-paper nanoGPT: \"\"\"\n",
        "\"\"\"wide enough for shrinkage effects to show, deep enough for a contiguous signal \"\"\"\n",
        "\"\"\"band with non-trivial oracle-layer variation. Pair with word20k+ and ctx256+.\"\"\"\n",
        "SCALE = {\"emb_dim\": 512, \"n_layers\": 12, \"n_heads\": 8}\n",
        "model = NanoGPT(vocab_sz, SCALE[\"emb_dim\"], ctx_len, SCALE[\"n_layers\"], SCALE[\"n_heads\"]).to(device)\n",
        "n_params_tot = sum(p.numel() for p in model.parameters())\n",
        "print(f\"faithful512 {n_params_tot / 1e6:.2f} M parameters\")\n"
      ]
    }
