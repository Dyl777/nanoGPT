      "source": [
        "# ALWAYS-PRESENT runner: implicit-patch end-to-end | Wires s25 cells B-D: position-aligned reduced context, Algorithm-1 patched clone, L_inf/TVD/token-match vs full context, float32 + float64 measurement sets | emits outputs/implicitpatch_results.json | plain codeblock, no Impl tag by design.\n",
        "def run_implicitpatch_benchmark(make_model_fn, context_text, query_text, pad_tok=0, seed=0,\n",
        "                                out_path=\"outputs/implicitpatch_results.json\"):\n",
        "    \"\"\"Claim test: patched model without context == original model with context (Thm 2 live).\"\"\"\n",
        "    \"\"\"No training (identities are weight-agnostic); original never touched (clone patched).\"\"\"\n",
        "    \"\"\"Reduced input = pad prefix + query at equal length (position-aligned reduced context).\"\"\"\n",
        "    import json as _j\n",
        "    import time as _t\n",
        "    import torch as _tt\n",
        "    from pathlib import Path as _P\n",
        "    t0 = _t.time()\n",
        "    ctx_ids = [token_to_int.get(c, 0) for c in context_text]\n",
        "    q_ids = [token_to_int.get(c, 0) for c in query_text]\n",
        "    ids_full = ctx_ids + q_ids\n",
        "    ids_red = [pad_tok] * len(ctx_ids) + q_ids\n",
        "    unk = sum(1 for c in (context_text + query_text) if c not in token_to_int)\n",
        "    measurements = {}\n",
        "    for dtype_name, dtype in ((\"float32\", _tt.float32), (\"float64\", _tt.float64)):\n",
        "        model = make_model_fn().to(dtype)\n",
        "        clone, diag = iw_patch_model(model, ids_full, ids_red)\n",
        "        cmp = iw_compare(diag[\"logits_patched\"], diag[\"logits_full\"],\n",
        "                         span=(len(ctx_ids), len(ids_full)))\n",
        "        plot = iw_plot_equiv(cmp, out_prefix=\"outputs/iw_live_%s\" % dtype_name,\n",
        "                             tokens=list(query_text))\n",
        "        measurements[dtype_name] = {\"linf_last\": cmp[\"linf\"][-1], \"tvd_last\": cmp[\"tvd\"][-1],\n",
        "                            \"match_last\": cmp[\"match\"][-1],\n",
        "                            \"span_max_linf\": cmp[\"max_linf\"], \"span_mean_tvd\": cmp[\"mean_tvd\"],\n",
        "                            \"span_match_rate\": cmp[\"match_rate\"],\n",
        "                            \"final_linf\": diag[\"final_linf\"],\n",
        "                            \"per_layer\": diag[\"layers\"], \"plot\": plot}\n",
        "    res = {\"paper\": \"arXiv:2511.17864\", \"seed\": seed,\n",
        "           \"context_len\": len(ctx_ids), \"query_len\": len(q_ids),\n",
        "           \"n_unknown_chars\": unk, \"reduced\": \"pad-prefix position-aligned\",\n",
        "           \"measurements\": measurements, \"seconds\": round(_t.time() - t0, 1)}\n",
        "    _P(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P(out_path).write_text(_j.dumps(res, indent=2, default=str), encoding=\"utf-8\")\n",
        "    print(_j.dumps({k: {kk: vv[kk] for kk in (\"linf_last\", \"tvd_last\", \"match_last\")}\n",
        "                      for k, vv in measurements.items()}, indent=2))\n",
        "    return res\n"
      ]
    },
    {
