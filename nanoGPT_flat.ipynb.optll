    }@}
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Build dataset.\"\"\"\n",
        "def build_dataset(txtfile, ctx_len):\n",
        "    with open(txtfile) as f:\n",
        "        text = f.read()\n",
        "    tokens = sorted(list(set(text)))\n",
        "    token_to_int = {t: i for i, t in enumerate(tokens)}\n",
        "    encode = lambda tokens: [token_to_int[t] for t in tokens]\n",
        "    data = torch.tensor(encode(text), dtype=torch.long)\n",
        "    n = int(0.9 * len(data))\n",
        "    train_data, val_data = data[:n], data[n:]\n",
        "    batch_sz_loc = 32\n",
        "    def get_batch(split):\n",
        "        d = train_data if split == \"train\" else val_data\n",
        "        ix = torch.randint(len(d) - ctx_len, (batch_sz_loc,))\n",
        "        xb = torch.stack([d[i:i+ctx_len] for i in ix])\n",
        "        yb = torch.stack([d[i+1:i+ctx_len+1] for i in ix])\n",
        "        return xb, yb\n",
        "    return get_batch\n",
        "get_batch = build_dataset(filepath, ctx_len)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Xavier initialisation.\"\"\"\n",
        "def xavier_init(m):\n",
        "    if isinstance(m, (nn.Linear, nn.Embedding)):\n",
        "        torch.nn.init.xavier_uniform_(m.weight)\n",
        "    elif isinstance(m, (nn.Conv2d,)):\n",
        "        torch.nn.init.xavier_uniform_(m.weight)\n",
        "xavier_init(model)\n",
        "model.to(device)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "@torch.no_grad()\n",
        "def estimate_losses(model, val_loader, loss_fn, n_tokens, val_iter=5):\n",
        "    model.eval()\n",
        "    losses = []\n",
        "    for batch_idx, (xb, yb) in enumerate(val_loader):\n",
        "        if batch_idx >= val_iter:\n",
        "            break\n",
        "        xb, yb = xb.to(device), yb.to(device)\n",
        "        logits = model(xb)\n",
        "        loss = loss_fn(logits.view(-1, logits.size(-1)), yb.view(-1))\n",
        "        losses.append(loss.item())\n",
        "    return np.mean(losses).item()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 9. Training Loop"
      ]
    },
    @Impl::State::layernorm{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Training loop (layernorm variant).\"\"\"\n",
        "# Note: AdderNet paper uses SGD+momentum 0.9 + cosine LR schedule (CNN recipe).\n",
        "# We use AdamW (nanoGPT's standard) since this is a Transformer.\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "optimizer = optim.AdamW(model.parameters(), lr=3e-4)\n",
        "n_epochs = 3\n",
        "batch_lim = 50\n",
        "xb, yb = get_batch(\"train\")\n",
        "xb, yb = xb.to(device), yb.to(device)\n",
        "for epoch in range(n_epochs):\n",
        "    model.train()\n",
        "    losses = []\n",
        "    for batch_idx in range(batch_lim):\n",
        "        logits = model(xb)\n",
        "        loss = loss_fn(logits.view(-1, logits.size(-1)), yb.view(-1))\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        losses.append(loss.item())\n",
        "        xb, yb = get_batch(\"train\")\n",
        "        xb, yb = xb.to(device), yb.to(device)\n",
        "    avg_loss = np.mean(losses).item()\n",
        "    print(f\"Epoch {epoch+1}/{n_epochs}  loss={avg_loss:.4f}\")\n",
        "print(\"Training complete!\")\n"
      ]
    }
    }@},
    @Impl::State::regularisedbn{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Training loop (regularisedbn variant) with regularisation loss.\"\"\"\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "optimizer = optim.AdamW(model.parameters(), lr=3e-4)\n",
        "n_epochs = 3\n",
        "batch_lim = 50\n",
        "for epoch in range(n_epochs):\n",
        "    model.train()\n",
        "    losses = []\n",
        "    for batch_idx in range(batch_lim):\n",
        "        xb, yb = get_batch(\"train\")\n",
        "        xb, yb = xb.to(device), yb.to(device)\n",
        "        logits = model(xb)\n",
        "        loss = loss_fn(logits.view(-1, logits.size(-1)), yb.view(-1))\n",
        "        reg_loss = sum(m.get_regularisation() for m in model.modules()\n",
        "                      if hasattr(m, 'get_regularisation'))\n",
        "        loss = loss + reg_loss\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        losses.append(loss.item())\n",
        "    avg_loss = np.mean(losses).item()\n",
        "    print(f\"Epoch {epoch+1}/{n_epochs}  loss={avg_loss:.4f}\")\n",
        "print(\"Training complete!\")\n"
      ]
    }
    }@},
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Generate text and save/load model.\"\"\"\n",
        "start = torch.zeros((1, 1), dtype=torch.long)\n",
        "gen = model.generate(start, max_new_tokens=100)\n",
        "gen = decode(gen[0].tolist())\n",
        "print(f\"\\nGenerated text:\\n{gen}\")\n",
        "print(\"Done!\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 33. Dust \u2013 Pretraining Transformers Without Backpropagation (Dahal, Mandal, G\u00fclbahar, Vegesna 2026, QLabs report)\n",
        "\n",
        "Source: qlabs.sh/research/dust (Oct 2026, no arXiv id assigned yet); code: github.com/qlabs-eng/dust (MIT). Claim: the first zeroth-order method competitive with backprop at pretraining transformer language models - Dust perturbs activations (node perturbation) independently at every token, so each token is a virtual population member and one forward pass evaluates the whole population in parallel.\n",
        "\n",
        "**What the paper does.** Add Gaussian noise to every linear layer's output independently per token; reward each token's noise by the loss drop it produced (centered across draws); the reward-weighted noise averaged over draws estimates the error at that layer's output (Eq. 2), and its outer product with the cached layer input is the weight gradient (Eq. 3) - the same outer product backprop forms at every Linear; only the error source differs (population reward vs chain rule). Attention internals (keys/values) are credited through the attention output over current and future tokens with decay gamma instead of the token's own loss. Interference control: separate passes per layer type, cached clean forward, the head jittered on cached logits. Reported results: tuned backprop matched/exceeded from a few hundred draws at 100k tokens and ~1k draws at 1M tokens; a power-law fit puts the 20M-token limit at 4.431 vs backprop's 4.633 (loosely constrained - the ladder is still falling); ~10^3-10^4x more compute-efficient than weight-space ES (EGGROLL) from 1M tokens (extrapolated); a 243M-parameter model outperforms a 120x smaller one at most population sizes; cosine(estimate, backprop) rises with population and stays aligned up to 1B tokens (fitted cos(K) = c/(1 + c/K)).\n",
        "\n",
        "**What runs here (smoke scale, honest).** `run_dust_benchmark` clones the compiled model (the live weights are never touched) and measures: (1) the cosine ladder - mean cosine between the Dust gradient estimate and the true backprop gradient per layer type at populations 16/64/256 on one batch (the paper's Fig. 5 diagnostic - the backward call in this measurement arm is deliberate, it is the paper's own reference); (2) a forward-only Dust training curve vs a backprop control arm on the same windows/init. The estimator cells themselves never call `.backward()` (grep-able; the update path sets p.grad from the estimate and steps SGD). Simplifications vs the paper's tuned estimator - no 256-column head slabs, no per-block attention re-execution scoring (a decayed direct-loss credit instead), no residual-mixing scalar ES (this model has none), no multi-GPU population - are recorded in the code docstrings and in outputs/dust_results.json. Graded recreation (corpus entry 20, `graded/figures/qlabs_dust/`): every published table reproduced exactly - Fig.2/Table 1 ladder cells, Fig.4 overparameterization cells, Fig.5/App.G cosine-law fits, App.D/E/F tables - as 5 PNGs + metrics.json, with local Eq.1/2/3/4 probes (the Eq.2/3 probe fits Eq.5's law at RMSE 0.03)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT estimator: Dust (QLabs 2026) forward-only node perturbation estimator + SGD step.\n",
        "# Adapts the paper's minimal implementation (github.com/qlabs-eng/dust, MIT) to the compiled NanoGPT\n",
        "# Used by the s9 Train::dust impl and by s33's diagnostics - same functions, never copies.\n",
        "# No .backward() anywhere in this cell; the s33 reference gradient is torch.autograd.grad.\n",
        "\"\"\"Dust: pretraining transformers without backpropagation (QLabs 2026).\"\"\"\n",
        "\"\"\"Per-token node perturbation: every Linear/Embedding output is jittered.\"\"\"\n",
        "\"\"\"Rewards are per-token loss drops, centered across each draw chunk; the\"\"\"\n",
        "\"\"\"reward-weighted noise is the estimated output error, and its outer product\"\"\"\n",
        "\"\"\"with the cached input is the weight gradient (paper Eq. 1-3).\"\"\"\n",
        "\"\"\"Key/value sites sum future rewards with decay gamma (attention-internal\"\"\"\n",
        "\"\"\"credit, direct-loss variant). Simplifications vs the paper's code, never\"\"\"\n",
        "\"\"\"claimed as equal: no 256-column head slabs (logits jittered whole), no\"\"\"\n",
        "\"\"\"per-block attention re-execution scoring, no residual-mixing scalars (this\"\"\"\n",
        "\"\"\"model has none), no multi-GPU population split. Exact tuned estimator:\"\"\"\n",
        "\"\"\"qlabs-eng/dust dust.py.\"\"\"\n",
        "import copy as _c33\n",
        "import json as _j33\n",
        "import re as _re33\n",
        "import time as _time33\n",
        "import torch as _t33\n",
        "import torch.nn.functional as _F33\n",
        "\n",
        "_KV_RE33 = _re33.compile(r\"(^|[._])(k|v|wk|wv|key|value|keys|values|k_proj|v_proj)([._]|$)\")\n",
        "\n",
        "\n",
        "def _dust_logits(model, x):\n",
        "    \"\"\"Logits from either a plain forward or a (logits, loss) tuple return.\"\"\"\n",
        "    out = model(x)\n",
        "    return out[0] if isinstance(out, tuple) else out\n",
        "\n",
        "\n",
        "def _dust_token_ce(logits, y):\n",
        "    \"\"\"Per-token CE with the notebook's ignore_index=-1 convention.\"\"\"\n",
        "    V = logits.shape[-1]\n",
        "    return _F33.cross_entropy(logits.float().reshape(-1, V), y.reshape(-1),\n",
        "                              reduction=\"none\", ignore_index=-1).view(y.shape)\n",
        "\n",
        "\n",
        "def _dust_sites(model, kv_gamma=0.98):\n",
        "    \"\"\"(name, module, gamma) for every trainable site.\"\"\"\n",
        "    \"\"\"gamma>0 = future-token credit (attention keys/values); 0 = own-token.\"\"\"\n",
        "    \"\"\"Fused QKV-style projections stay at 0 (the q part dominates a fused\"\"\"\n",
        "    \"\"\"output; splitting it is future work).\"\"\"\n",
        "    sites = []\n",
        "    for name, mod in model.named_modules():\n",
        "        if isinstance(mod, _t33.nn.Embedding):\n",
        "            sites.append((name, mod, 0.0))\n",
        "        elif isinstance(mod, _t33.nn.Linear):\n",
        "            ln = name.lower()\n",
        "            fused = (\"qkv\" in ln) or (\"c_attn\" in ln)\n",
        "            sites.append((name, mod, 0.0 if fused else (kv_gamma if _KV_RE33.search(ln) else 0.0)))\n",
        "        elif name.endswith(\"lm_head\") and getattr(mod, \"weight\", None) is not None:\n",
        "            sites.append((name, mod, 0.0))\n",
        "    return sites\n",
        "\n",
        "\n",
        "def _dust_group_of(name):\n",
        "    \"\"\"Layer-type label for the cosine ladder (mirrors the paper's Fig. 5).\"\"\"\n",
        "    n = name.lower()\n",
        "    if \"lm_head\" in n:\n",
        "        return \"head\"\n",
        "    if \"embedding\" in n or \"wte\" in n or \"wpe\" in n:\n",
        "        return \"embed\"\n",
        "    if \"attn\" in n:\n",
        "        return \"attention\"\n",
        "    if \"ffwd\" in n or \"mlp\" in n or \".fc\" in n or \"fc1\" in n or \"fc2\" in n:\n",
        "        return \"mlp\"\n",
        "    return \"other\"\n",
        "\n",
        "\n",
        "def _dust_decay(reward, gamma):\n",
        "    \"\"\"r_t <- sum over s>=t of gamma^(s-t) r_s (paper's decayed future credit).\"\"\"\n",
        "    out = _t33.empty_like(reward)\n",
        "    acc = _t33.zeros_like(reward[..., 0])\n",
        "    for t in range(reward.shape[-1] - 1, -1, -1):\n",
        "        acc = reward[..., t] + gamma * acc\n",
        "        out[..., t] = acc\n",
        "    return out\n",
        "\n",
        "\n",
        "def _dust_expand_noise(a, n, B, T):\n",
        "    \"\"\"Align a noise tensor to (n, B, T, D) for the reward-weighted average.\"\"\"\n",
        "    a = a.float()\n",
        "    if a.dim() == 2:\n",
        "        return a.view(1, 1, a.shape[0], -1).expand(n, B, T, -1)\n",
        "    if a.dim() == 3 and a.shape[0] == n * B:\n",
        "        return a.view(n, B, T, -1)\n",
        "    if a.dim() == 3 and a.shape[0] == B:\n",
        "        return a.view(1, B, T, -1).expand(n, B, T, -1)\n",
        "    if a.dim() == 3 and a.shape[0] == 1:\n",
        "        return a.view(1, 1, T, -1).expand(n, B, T, -1)\n",
        "    if a.dim() == 4:\n",
        "        return a\n",
        "    raise ValueError(\"unexpected noise shape %s\" % (tuple(a.shape),))\n",
        "\n",
        "\n",
        "class _DustState:\n",
        "    \"\"\"Hook state: clean-pass capture + per-draw jitter injection.\"\"\"\n",
        "\n",
        "    def __init__(self, sites, gen):\n",
        "        self.sites = sites\n",
        "        self.gen = gen\n",
        "        self.capture = False\n",
        "        self.jitter = None\n",
        "        self.sigma = {}\n",
        "        self.inputs = {}\n",
        "        self.noise = {}\n",
        "        self.hooks = []\n",
        "\n",
        "    def attach(self, model):\n",
        "        for name, mod, _g in self.sites:\n",
        "            def hook(mod, args, output, _name=name):\n",
        "                if self.capture and args and _t33.is_tensor(args[0]):\n",
        "                    self.inputs[_name] = args[0].detach()\n",
        "                if self.jitter is not None and _name in self.jitter:\n",
        "                    a = _t33.randn(tuple(output.shape), device=output.device,\n",
        "                                   generator=self.gen).to(output.dtype)\n",
        "                    self.noise[_name] = a\n",
        "                    return output + self.sigma[_name] * a\n",
        "                return None\n",
        "            self.hooks.append(mod.register_forward_hook(hook))\n",
        "\n",
        "    def close(self):\n",
        "        for h in self.hooks:\n",
        "            h.remove()\n",
        "        self.hooks = []\n",
        "\n",
        "\n",
        "def _dust_capture(model, state, x, y):\n",
        "    \"\"\"Clean forward: caches every site's input and the per-token losses.\"\"\"\n",
        "    state.capture = True\n",
        "    state.jitter = None\n",
        "    try:\n",
        "        with _t33.no_grad():\n",
        "            clean = _dust_token_ce(_dust_logits(model, x), y)\n",
        "    finally:\n",
        "        state.capture = False\n",
        "    return clean\n",
        "\n",
        "\n",
        "def _dust_group_errors(model, state, x, y, names, draws, sigma, gamma, chunk, clean):\n",
        "    \"\"\"Centered loss-drop rewards -> error estimates for one site group.\"\"\"\n",
        "    B, T = x.shape\n",
        "    mods = dict((n, m) for n, m, _g in state.sites)\n",
        "    errs = {}\n",
        "    for name in names:\n",
        "        w = mods[name].weight\n",
        "        out_w = w.shape[1] if isinstance(mods[name], _t33.nn.Embedding) else w.shape[0]\n",
        "        errs[name] = _t33.zeros(B, T, out_w, device=x.device, dtype=_t33.float32)\n",
        "    state.sigma = dict((n, sigma) for n in names)\n",
        "    used, bad = 0, []\n",
        "    while used < draws:\n",
        "        n = min(chunk, draws - used)\n",
        "        state.jitter = set(names)\n",
        "        state.noise = {}\n",
        "        try:\n",
        "            with _t33.no_grad():\n",
        "                logits = _dust_logits(model, x.repeat(n, 1))\n",
        "                pert = _dust_token_ce(logits, y.repeat(n, 1)).view(n, B, T)\n",
        "        finally:\n",
        "            state.jitter = None\n",
        "        reward = clean.unsqueeze(0) - pert\n",
        "        if n > 1:\n",
        "            reward = reward - reward.mean(0, keepdim=True)\n",
        "        if gamma > 0:\n",
        "            reward = _dust_decay(reward, gamma)\n",
        "        rw = reward.float()\n",
        "        for name in list(names):\n",
        "            try:\n",
        "                a = _dust_expand_noise(state.noise[name], n, B, T)\n",
        "                errs[name] -= _t33.einsum(\"nbt,nbtd->btd\", rw, a) / sigma / draws\n",
        "            except Exception:\n",
        "                bad.append(name)\n",
        "                names.remove(name)\n",
        "                errs.pop(name, None)\n",
        "        used += n\n",
        "    return errs, bad\n",
        "\n",
        "\n",
        "def _dust_reassemble(state, name, mod, error):\n",
        "    \"\"\"Outer product with the cached input (scatter-add for embeddings).\"\"\"\n",
        "    xin = state.inputs.get(name)\n",
        "    if xin is None:\n",
        "        return None\n",
        "    if isinstance(mod, _t33.nn.Embedding):\n",
        "        idx = xin.reshape(-1).to(_t33.long)\n",
        "        e = error.float().reshape(-1, error.shape[-1])\n",
        "        if idx.numel() and e.shape[0] != idx.numel() and e.shape[0] % idx.numel() == 0:\n",
        "            idx = idx.repeat(e.shape[0] // idx.numel())\n",
        "        if idx.numel() != e.shape[0]:\n",
        "            return None\n",
        "        return _t33.zeros_like(mod.weight, dtype=_t33.float32).index_add_(0, idx, e)\n",
        "    xf = xin.float()\n",
        "    if xf.dim() == 2:\n",
        "        xf = xf.reshape(1, xf.shape[0], -1).expand(error.shape[0], -1, -1)\n",
        "    if xf.dim() != 3 or xf.shape[:2] != error.shape[:2] or xf.shape[-1] != mod.weight.shape[1]:\n",
        "        return None\n",
        "    return _t33.einsum(\"btd,bti->di\", error.float(), xf)\n",
        "\n",
        "\n",
        "def _dust_gradients(model, x, y, population=64, seed=33, gamma=0.98, chunk=8,\n",
        "                    sigma_direct=0.2, sigma_kv=0.1, sigma_head=0.05):\n",
        "    \"\"\"Weight-gradient estimate from forward draws only (never .backward()).\"\"\"\n",
        "    sites = _dust_sites(model, kv_gamma=gamma)\n",
        "    mods = dict((n, m) for n, m, _g in sites)\n",
        "    groups = {\"direct\": [], \"kv\": [], \"embed\": [], \"head\": []}\n",
        "    for name, mod, g in sites:\n",
        "        if \"lm_head\" in name:\n",
        "            groups[\"head\"].append(name)\n",
        "        elif isinstance(mod, _t33.nn.Embedding):\n",
        "            groups[\"embed\"].append(name)\n",
        "        elif g > 0:\n",
        "            groups[\"kv\"].append(name)\n",
        "        else:\n",
        "            groups[\"direct\"].append(name)\n",
        "    alloc = {\"direct\": population, \"kv\": max(population // 2, 1),\n",
        "             \"embed\": max(population // 4, 1), \"head\": population}\n",
        "    sigmas = {\"direct\": sigma_direct, \"kv\": sigma_kv, \"embed\": sigma_direct, \"head\": sigma_head}\n",
        "    gen = _t33.Generator(device=x.device).manual_seed(seed)\n",
        "    state = _DustState(sites, gen)\n",
        "    state.attach(model)\n",
        "    try:\n",
        "        clean = _dust_capture(model, state, x, y)\n",
        "        grads, skipped = {}, []\n",
        "        for gname in (\"direct\", \"kv\", \"embed\", \"head\"):\n",
        "            names = groups[gname]\n",
        "            if not names:\n",
        "                continue\n",
        "            errs, bad = _dust_group_errors(model, state, x, y, names, alloc[gname],\n",
        "                                           sigmas[gname], gamma if gname == \"kv\" else 0.0,\n",
        "                                           chunk, clean)\n",
        "            skipped.extend(bad)\n",
        "            for name, err in errs.items():\n",
        "                g = _dust_reassemble(state, name, mods[name], err)\n",
        "                if g is None:\n",
        "                    skipped.append(name)\n",
        "                else:\n",
        "                    grads[name + \".weight\"] = g\n",
        "        valid = int((y != -1).sum()) or int(y.numel())\n",
        "        for k in grads:\n",
        "            grads[k] = (grads[k] / valid).float()\n",
        "        meta = {\"allocation\": alloc, \"sigma\": sigmas, \"chunk\": chunk, \"gamma\": gamma,\n",
        "                \"population\": population, \"sites_by_group\": {k: len(v) for k, v in groups.items()},\n",
        "                \"skipped_sites\": skipped, \"valid_tokens\": valid,\n",
        "                \"clean_loss\": float(clean[(y != -1)].mean()) if bool((y != -1).any()) else float(\"nan\")}\n",
        "        return grads, meta\n",
        "    finally:\n",
        "        state.close()\n",
        "\n",
        "\n",
        "def _dust_apply_grads(model, grads):\n",
        "    \"\"\"Set p.grad from the estimate, summing tied parameters (wte <-> lm_head).\"\"\"\n",
        "    seen, applied = {}, 0\n",
        "    for name, p in model.named_parameters(remove_duplicate=False):\n",
        "        g = grads.get(name)\n",
        "        if g is None:\n",
        "            continue\n",
        "        pid = id(p)\n",
        "        if pid not in seen:\n",
        "            seen[pid] = g.clone()\n",
        "            applied += 1\n",
        "        else:\n",
        "            seen[pid] += g\n",
        "    for name, p in model.named_parameters(remove_duplicate=False):\n",
        "        if id(p) in seen:\n",
        "            p.grad = seen[id(p)].to(p.dtype)\n",
        "    return applied\n",
        "\n",
        "\n",
        "def _dust_train_step(model, x, y, optimizer, population, seed, gamma, chunk):\n",
        "    \"\"\"One forward-only update: estimates -> p.grad -> SGD step (no backward).\"\"\"\n",
        "    model.zero_grad(set_to_none=True)\n",
        "    grads, meta = _dust_gradients(model, x, y, population=population, seed=seed,\n",
        "                                  gamma=gamma, chunk=chunk)\n",
        "    _dust_apply_grads(model, grads)\n",
        "    optimizer.step()\n",
        "    return meta\n",
        "\n",
        "\n",
        "def _dust_fineweb_ids(model, docs=64, max_chars=4_000_000):\n",
        "    \"\"\"FineWeb (HuggingFaceFW/fineweb, sample-10BT) slice for Dust pretraining.\"\"\"\n",
        "    \"\"\"The paper pretrains on FineWeb; this streams a bounded slice at\"\"\"\n",
        "    \"\"\"execution time only (Hub fetch, cached under data/external/hf like\"\"\"\n",
        "    \"\"\"the external suites). Returns (ids, provenance) or (None, reason);\"\"\"\n",
        "    \"\"\"the ids are tiktoken gpt2 token ids and are usable only when the\"\"\"\n",
        "    \"\"\"compiled vocab is gpt2bpe (50257); otherwise the loop keeps the\"\"\"\n",
        "    \"\"\"in-repo corpus and records the exact reason (never faked numbers).\"\"\"\n",
        "    V = int(model.token_embedding.num_embeddings)\n",
        "    if V != 50257:\n",
        "        return None, \"compiled vocab is %d, not gpt2bpe (50257); token ids would be out of range\" % V\n",
        "    try:\n",
        "        import tiktoken as _tkt\n",
        "        from datasets import load_dataset as _lds\n",
        "    except Exception as e:  # noqa: BLE001\n",
        "        return None, \"tiktoken/datasets unavailable: %s\" % e\n",
        "    try:\n",
        "        ds = _lds(\"HuggingFaceFW/fineweb\", \"sample-10BT\", split=\"train\", streaming=True,\n",
        "                  cache_dir=\"data/external/hf\")\n",
        "        parts, total = [], 0\n",
        "        for row in ds:\n",
        "            t = row.get(\"text\") or \"\"\n",
        "            parts.append(t)\n",
        "            total += len(t)\n",
        "            if len(parts) >= int(docs) or total >= int(max_chars):\n",
        "                break\n",
        "        text = \"\\n\".join(parts)\n",
        "        ids = _tkt.get_encoding(\"gpt2\").encode(text, allowed_special=set())\n",
        "        return ids, (\"FineWeb sample-10BT streaming (%d docs, %d chars -> %d gpt2-BPE tokens)\"\n",
        "                     % (len(parts), len(text), len(ids)))\n",
        "    except Exception as e:  # noqa: BLE001 - fail-soft: the runner keeps the local corpus\n",
        "        return None, \"fineweb fetch failed: %s\" % str(e)[:200]"
      ]
    },
    @Impl::Train::backprop{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Training loop (Train::backprop variant).\"\"\"\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "optimizer = optim.AdamW(model.parameters(), lr=3e-4)\n",
        "n_epochs = 3\n",
        "batch_lim = 50\n",
        "for epoch in range(n_epochs):\n",
        "    model.train()\n",
        "    losses = []\n",
        "    for batch_idx in range(batch_lim):\n",
        "        xb, yb = get_batch(\"train\")\n",
        "        xb, yb = xb.to(device), yb.to(device)\n",
        "        logits = model(xb)\n",
        "        loss = loss_fn(logits.view(-1, logits.size(-1)), yb.view(-1))\n",
        "        loss = loss + _train_reg_loss(model)\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        losses.append(loss.item())\n",
        "    avg_loss = np.mean(losses).item()\n",
        "    print(f\"Epoch {epoch+1}/{n_epochs}  loss={avg_loss:.4f}\")\n",
        "print(\"Training complete!\")\n"
      ]
    },
    }@}
    @Impl::Train::dust{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Training loop (Train::dust variant): Dust (QLabs 2026) forward-only pretraining.\"\"\"\n",
        "# The paper's zeroth-order algorithm replaces the backward pass here: the same\n",
        "# schedule and logging as the Train::backprop loop, but the update comes from the\n",
        "# estimator (population rewards; no .backward() anywhere on this path). One step\n",
        "# costs ~(population/chunk) copies of the batch forward - the paper's own tradeoff,\n",
        "# so pick Train::dust for the result, not for speed.\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "optimizer = optim.SGD(model.parameters(), lr=0.25, momentum=0.95)\n",
        "n_epochs = 3\n",
        "batch_lim = 50\n",
        "dust_population = 64\n",
        "dust_gamma = 0.98\n",
        "dust_chunk = 8\n",
        "dust_train_history = []\n",
        "_fw_ids, _fw_note = _dust_fineweb_ids(model)\n",
        "if _fw_ids is not None:\n",
        "    dust_data_source = _fw_note\n",
        "    _fw = torch.as_tensor(_fw_ids, dtype=torch.long)\n",
        "else:\n",
        "    dust_data_source = \"in-repo corpus (data/tiny_shakespeare.txt); FineWeb not used: %s\" % _fw_note\n",
        "    _fw = None\n",
        "_dctx = int(globals().get(\"block_size\", 64))\n",
        "_dbs = int(globals().get(\"batch_size\", 32))\n",
        "\n",
        "\n",
        "def _dust_batch():\n",
        "    \"\"\"Minibatch for a Dust step: FineWeb windows when available, else s7's loader.\"\"\"\n",
        "    if _fw is not None:\n",
        "        ix = torch.randint(max(len(_fw) - _dctx - 1, 1), (_dbs,))\n",
        "        rows = torch.stack([_fw[i:i + _dctx + 1] for i in ix])\n",
        "        return rows[:, :-1].to(device), rows[:, 1:].to(device)\n",
        "    xb, yb = get_batch(\"train\")\n",
        "    return xb.to(device), yb.to(device)\n",
        "\n",
        "\n",
        "for epoch in range(n_epochs):\n",
        "    model.train()\n",
        "    losses = []\n",
        "    for batch_idx in range(batch_lim):\n",
        "        xb, yb = _dust_batch()\n",
        "        with torch.no_grad():\n",
        "            _l = _dust_token_ce(_dust_logits(model, xb), yb)\n",
        "        _m = yb != -1\n",
        "        losses.append(float(_l[_m].mean()) if bool(_m.any()) else float(\"nan\"))\n",
        "        _dust_train_step(model, xb, yb, optimizer, dust_population,\n",
        "                         33 + len(dust_train_history), dust_gamma, dust_chunk)\n",
        "        dust_train_history.append(losses[-1])\n",
        "    avg_loss = np.mean(losses).item()\n",
        "    print(f\"Epoch {epoch+1}/{n_epochs}  loss={avg_loss:.4f}  (Dust forward-only, population {dust_population})\")\n",
        "print(\"Dust training complete!\")"
      ]
    },
    }@}
