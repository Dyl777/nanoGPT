        "\"\"\"Context 64 (repo default, ~10 words). QA pairs truncate to answer tails; paired \"\"\"\n",
        "\"\"\"probing still runs (same pipeline) but length-confound risk is highest here.\"\"\"\n",
        "ctx_len = 64\n",
        "model.ctx_len = ctx_len\n",
