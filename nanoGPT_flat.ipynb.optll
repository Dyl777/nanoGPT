      "source": [
        "## 16. Wired Grokking \u2013 nanoGPT Itself on Modular Arithmetic (Quantifying the Memorization-to-Generalization Transition, Kataria 2026, arXiv:2609.10657, s7 open question)",
        "",
        "The §14 lab reproduces the paper's MLP experiment beside the model. THE PAPER'S OWN OPEN QUESTION (§7: unmeasured data-fraction exponents for attention architectures) demands the transformer itself grok - so these cells wire nanoGPT directly: fixed-width arithmetic strings (`023+045=068|`, zero-padded so answer spans sit at deterministic positions) encoded with the EXISTING char vocab, trained with the UNCHANGED causal-LM objective (next-token loss; no new heads, no logic change), scored by greedy exact-match on the answer span for train vs held-out pairs (the paper's Tmem>99%/Tgrok>95% operationalization, transposed from MLP logits to sequence decoding). Two documented deviations from §2: minibatches instead of full-batch (transformer scale), greedy-decode metric instead of argmax logits (same >99%/>95% thresholds). All cells plain ALWAYS-PRESENT codeblocks (bundle rule): one training harness, no new Techniques.",
        ""
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT wired arithmetic corpus | Paper s2 Tasks (add_mod_113/div_mod_97, D in {0.3,0.5,0.7,0.97}) transposed to fixed-width strings on the EXISTING char vocab | graded 05_Setup | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Pairs become text: zero-padded operands, answer span at fixed offset, '|' terminator.\"\"\"\n",
        "\"\"\"Split is BY PAIR (train D fraction, test complement) - the paper's split, not a token \"\"\"\n",
        "\"\"\"split. Char vocab encodes everything (s11 Vocab::char64); longer ctx (s11 Context) fits.\"\"\"\n",
        "def wired_arith_corpus(P=113, op=\"add\", D=0.5, seed=0):\n",
        "    import torch as _t\n",
        "    g = _t.Generator().manual_seed(seed)\n",
        "    w = len(str(P - 1))\n",
        "    if op == \"add\":\n",
        "        pairs = [(a, b, (a + b) % P) for a in range(P) for b in range(P)]\n",
        "        fmt = lambda a, b, c: f\"{a:0{w}d}+{b:0{w}d}={c:0{w}d}|\"\n",
        "    else:\n",
        "        inv = {b: pow(b, P - 2, P) for b in range(1, P)}\n",
        "        pairs = [(a, b, (a * inv[b]) % P) for a in range(P) for b in range(1, P)]\n",
        "        fmt = lambda a, b, c: f\"{a:0{w}d}*{b:0{w}d}={c:0{w}d}|\"\n",
        "    perm = _t.randperm(len(pairs), generator=g).tolist()\n",
        "    ntr = int(D * len(pairs))\n",
        "    strs_tr = [fmt(*pairs[i]) for i in perm[:ntr]]\n",
        "    strs_te = [fmt(*pairs[i]) for i in perm[ntr:]]\n",
        "    L = len(strs_tr[0])\n",
        "    ans_at = (L - w - 1, L - 1)\n",
        "    return strs_tr, strs_te, ans_at, P\n",
        "\n",
        "def wired_encode_batch(strs, ctx_len):\n",
        "    import torch as _t\n",
        "    ids = [[token_to_int.get(c, 0) for c in s] for s in strs]\n",
        "    return _t.tensor(ids, dtype=_t.long)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT wired grokking loop | Paper s2 recipe (AdamW(0.9,0.98), Tmem/Tgrok/gap clocks, norm tracking s5) on the UNCHANGED NanoGPT class + causal loss | graded 05_Setup/05_Fig7_Norms | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Trains NanoGPT (any s11 Scale/Context/Vocab combo) on arithmetic strings; metric is \"\"\"\n",
        "\"\"\"greedy exact-match over the answer span (paper thresholds kept: >99% train, >95% \"\"\"\n",
        "\"\"\"test). Logs acc curves + weight norm; returns clocks via grok_regime_clocks and the \"\"\"\n",
        "\"\"\"norm ratio via grok_norm_ratio (paper median 0.42, r* in 0.3-0.5). Minibatch deviation \"\"\"\n",
        "\"\"\"from full-batch documented in s16 header (transformer scale).\"\"\"\n",
        "def wired_answer_em(model, X, ans_at, batch=256):\n",
        "    model.eval()\n",
        "    a0, a1 = ans_at\n",
        "    hits, n = 0, 0\n",
        "    with torch.no_grad():\n",
        "        for i in range(0, len(X), batch):\n",
        "            xb = X[i:i + batch].to(next(model.parameters()).device)\n",
        "            pred = model(xb)[:, a0 - 1:a1 - 1, :].argmax(-1)\n",
        "            hits += (pred == xb[:, a0:a1]).all(1).sum().item()\n",
        "            n += len(xb)\n",
        "    return hits / max(1, n)\n",
        "\n",
        "def wired_grok_train(model, strs_tr, strs_te, ans_at, eta=0.003, lam=0.3, steps=5000, batch=128, log_every=100, seed=0):\n",
        "    torch.manual_seed(seed)\n",
        "    dev = next(model.parameters()).device\n",
        "    Xtr = wired_encode_batch(strs_tr, model.ctx_len).to(dev)\n",
        "    Xte = wired_encode_batch(strs_te, model.ctx_len).to(dev)\n",
        "    opt = torch.optim.AdamW(model.parameters(), lr=eta, betas=(0.9, 0.98), weight_decay=lam)\n",
        "    loss_fn = torch.nn.CrossEntropyLoss()\n",
        "    tr_acc, te_acc, norms = [], [], []\n",
        "    for s in range(steps):\n",
        "        model.train()\n",
        "        ix = torch.randint(len(Xtr), (batch,))\n",
        "        xb = Xtr[ix]\n",
        "        opt.zero_grad()\n",
        "        lg = model(xb)\n",
        "        loss_fn(lg.reshape(-1, lg.shape[-1]), xb.view(-1)).backward()\n",
        "        opt.step()\n",
        "        if (s + 1) % log_every == 0:\n",
        "            tr_acc.append(wired_answer_em(model, Xtr, ans_at))\n",
        "            te_acc.append(wired_answer_em(model, Xte, ans_at))\n",
        "            norms.append(grok_weight_norm(model))\n",
        "    Tmem, Tgrok, gap = grok_regime_clocks(tr_acc, te_acc)\n",
        "    ratio, in_band = (None, False)\n",
        "    if Tmem is not None and Tgrok is not None:\n",
        "        ratio, in_band = grok_norm_ratio(norms, Tmem, Tgrok)\n",
        "    return {\"train\": tr_acc, \"test\": te_acc, \"norms\": norms, \"Tmem\": Tmem,\n",
        "            \"Tgrok\": Tgrok, \"gap\": gap, \"norm_ratio\": ratio, \"r_star_band\": in_band}\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT wired D-sweep (the paper's s7 open question, run on nanoGPT) | Paper Eq.2 (D^-2.04 predicts ~4.1x per doubling), s4 (lam* phase gate), s5 (norm ratio) | graded 05_Table1_Exponents/05_Fig5_Phase/05_Fig7_Norms | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Sweeps D fractions on the SAME model; compares measured Tgrok ratios to predicted.\"\"\"\n",
        "\"\"\"A D-driven speedup near 4x per doubling on a transformer = the paper's structural \"\"\"\n",
        "\"\"\"prediction confirmed outside MLPs; phase gate + norm band checked per run. Small P \"\"\"\n",
        "\"\"\"(e.g. mod 7/13) keeps this CPU-feasible as a smoke test before full mod-113 runs.\"\"\"\n",
        "def wired_d_sweep(make_model_fn, P=13, op=\"add\", Ds=(0.3, 0.5, 0.7, 0.97), eta=0.003, lam=0.3, steps=2000, seed=0):\n",
        "    rows = []\n",
        "    for D in Ds:\n",
        "        strs_tr, strs_te, ans_at, _ = wired_arith_corpus(P, op, D, seed)\n",
        "        model = make_model_fn()\n",
        "        h = wired_grok_train(model, strs_tr, strs_te, ans_at, eta, lam, steps=steps, seed=seed)\n",
        "        pred = grok_predict_tgrok(H=64, D=D, eta=eta, lam=lam)\n",
        "        rows.append({\"D\": D, \"Tmem\": h[\"Tmem\"], \"Tgrok\": h[\"Tgrok\"], \"gap\": h[\"gap\"],\n",
        "                   \"norm_ratio\": h[\"norm_ratio\"], \"r_star_band\": h[\"r_star_band\"],\n",
        "                   \"phase\": grok_phase(lam), \"pred_rel\": pred})\n",
        "        print(f\"D={D} Tmem={h['Tmem']} Tgrok={h['Tgrok']} gap={h['gap']} ratio={h['norm_ratio']} phase={rows[-1]['phase']}\")\n",
        "    return rows\n"
      ]
    },
