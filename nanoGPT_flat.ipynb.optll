        "key = nn.Linear(emb_dim, head_sz, bias=False)\n"
      ]
    }
    }@},
    @Impl::Model::addernetmatmul{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Impl: K projection",
        "- **addernetmatmul**: `AdderConvLinear` (Toeplitz\u2013convolution with L1-distance)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "key = AdderConvLinear(emb_dim, head_sz, bias=False)\n"
      ]
    }
    }@},
    @Impl::Model::matmul{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Impl: V projection",
        "- **matmul**: `nn.Linear(emb_dim, head_sz)`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "value = nn.Linear(emb_dim, head_sz, bias=False)\n"
      ]
    }
    }@},
    @Impl::Model::addernetmatmul{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Impl: V projection",
        "- **addernetmatmul**: `AdderConvLinear` (Toeplitz\u2013convolution with L1-distance)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "value = AdderConvLinear(emb_dim, head_sz, bias=False)\n"
      ]
    }
    }@},
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "x = torch.randn(batch_sz, ctx_len, emb_dim)\n",
        "q = query(x)\n",
        "k = key(x)\n",
        "v = value(x)\n"
      ]
    },
    @Impl::Model::matmul{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Impl: Attention scores",
        "- **matmul**: `q @ k^T / sqrt(d_k)`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "k_q_sim = q @ k.transpose(2, 1) / np.sqrt(head_sz)\n",
        "print(f\"{k_q_sim.shape=}\")\n"
      ]
    }
    }@},
    @Impl::Model::addernetmatmul{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Impl: Attention scores",
        "- **addernetmatmul**: Toeplitz\u2013convolution with L1-distance (`-|q - k| / sqrt(d_k)`)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "k_q_sim = -(q.unsqueeze(2) - k.unsqueeze(1)).abs().sum(-1) / np.sqrt(head_sz)\n",
        "print(f\"{k_q_sim.shape=}\")\n"
      ]
    }
    }@},
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "tril = torch.tril(torch.ones(ctx_len, ctx_len))\n",
        "k_q_sim = k_q_sim.masked_fill(tril == 0, float(\"-inf\"))\n",
        "attn_weights = F.softmax(k_q_sim, dim=2)\n",
        "print(f\"{attn_weights.shape=}\")\n"
      ]
    },
    @Impl::Model::matmul{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Impl: Attention output",
        "- **matmul**: `attn_weights @ v`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "attn_out = attn_weights @ v\n",
        "print(f\"{attn_out.shape=}\")\n"
      ]
    }
    }@},
    @Impl::Model::addernetmatmul{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Impl: Attention output",
        "- **addernetmatmul**: Toeplitz\u2013convolution with L1-distance (`-|attn_weights - v|`)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "attn_out = -(attn_weights.unsqueeze(-1) - v.unsqueeze(2)).abs().sum(dim=2)\n",
        "print(f\"{attn_out.shape=}\")\n"
      ]
    }
    }@},
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Head \u2013 Single Self-Attention Head",
        "Each head implements its own Q, K, V projections, attention scores, and output."
      ]
    },
    @Impl::Attn::vanillaatten{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Standard self-attention",
        "Scaled dot-product attention with a causal mask: each position attends to itself and earlier positions."
      ]
    }
    }@},
    @Impl::Attn::mqa{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Multi-Query Attention (Shazeer 2019)",
        "All query heads share a single key/value head, so the KV cache shrinks by the number of heads.",
        "Each head below accepts an optional shared `kv`; the sharing itself is wired up in `MultiHead`."
      ]
    }
    }@},
    @Impl::Attn::gqa{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Grouped-Query Attention (Ainslie et al. 2023)",
        "Query heads are split into groups that share key/value heads: fewer KVs than full multi-head attention,",
        "more than single-query attention. Group routing is wired up in `MultiHead`."
      ]
    }
    }@},
    @Impl::Attn::mla{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Multi-head Latent Attention (DeepSeek-AI 2024)",
        "Keys and values are low-rank: inputs are compressed to a small latent vector that is cached,",
        "then projected back up per head. Queries stay full-rank."
      ]
    }
    }@},
    @Impl::Attn::dsa{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Sparse attention (DeepSeek NSA-inspired)",
        "On top of the causal mask, each query keeps a local window plus strided distant positions,",
        "then filters to the top-k scores before the softmax. Near-dense on tiny contexts; pays off at long ones."
      ]
    }
    }@},
    @Impl::Attn::tokenformer{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Token-parameter attention (TokenFormer, Wang et al. 2025)",
        "Linear projections are replaced by attention over learnable parameter tokens: input tokens act as queries",
        "while parameters serve as keys and values. Capacity grows by adding new key-value parameter pairs,",
        "so the model scales without retraining from scratch."
      ]
    }
    }@},
    @Impl::Attn::tpa{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Tensor Product Attention (Zhang et al. 2026)",
        "Each projection is factorized as a sum of R rank-1 tensor products: a compact mixing factor times",
        "token features. Only the small factors need caching, and the factorization composes with rotary",
        "position embeddings, unlike KV-compression approaches."
      ]
    }
    }@},
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Projection and score functions",
        "Defined once here and reused by every attention module below."
      ]
    },
    @Impl::Model::matmul{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Standard projections and dot-product scores.\"\"\"\n",
        "QKVLinear = nn.Linear\n",
        "def attn_scores(q, k):\n",
        "    return q @ k.transpose(-2, -1)\n",
        "def attn_combine(wei, v):\n",
        "    return wei @ v\n"
      ]
    }
    }@},
    @Impl::Model::addernetmatmul{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"AdderNet projections and L1 scores (no multiplies).\"\"\"\n",
        "QKVLinear = AdderConvLinear\n",
        "def attn_scores(q, k):\n",
        "    return -(q.unsqueeze(-1) - k.unsqueeze(-2)).abs().sum(-1)\n",
        "def attn_combine(wei, v):\n",
        "    return -(wei.unsqueeze(-1) - v.unsqueeze(-2)).abs().sum(-2)\n"
      ]
    }
    }@},
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Single self-attention head.\"\"\"\n",
        "class Head(nn.Module):\n",
        "    def __init__(self, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.head_sz, self.emb_dim = head_sz, emb_dim\n",
        "        self.key = QKVLinear(emb_dim, head_sz, bias=False)\n",
        "        self.query = QKVLinear(emb_dim, head_sz, bias=False)\n",
        "        self.value = QKVLinear(emb_dim, head_sz, bias=False)\n",
@Impl::Attn::mla{
        "        # MLA latent projections (used instead of key/value)\n",
        "        self.kv_down = QKVLinear(emb_dim, max(16, head_sz // 2), bias=False)\n",
        "        self.k_up = QKVLinear(max(16, head_sz // 2), head_sz, bias=False)\n",
        "        self.v_up = QKVLinear(max(16, head_sz // 2), head_sz, bias=False)\n",
}@}
@Impl::Attn::tokenformer{
        "        # Token-parameter tokens: parameters as keys/values (added pairs scale capacity)\n",
        "        self.p_keys = nn.Parameter(torch.randn(64, head_sz) * 0.02)\n",
        "        self.p_values = nn.Parameter(torch.randn(64, head_sz) * 0.02)\n",
}@}
@Impl::Attn::tpa{
        "        # TPA: each projection is a sum of R rank-1 tensor products (Zhang et al. 2026)\n",
        "        self.tpa_rank = 2\n",
        "        self.a_q = QKVLinear(emb_dim, self.tpa_rank, bias=False)\n",
        "        self.b_q = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(self.tpa_rank)])\n",
        "        self.a_k = QKVLinear(emb_dim, self.tpa_rank, bias=False)\n",
        "        self.b_k = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(self.tpa_rank)])\n",
        "        self.a_v = QKVLinear(emb_dim, self.tpa_rank, bias=False)\n",
        "        self.b_v = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(self.tpa_rank)])\n",
}@}
        "        self.register_buffer(\"tril\", torch.tril(torch.ones(ctx_len, ctx_len)))\n",
        "\n",
        "    def forward(self, x, kv=None):\n",
        "        B, T, C = x.shape\n",
        "        q = self.query(x)\n",
        "        k = self.key(x)\n",
        "        v = self.value(x)\n",
@Impl::Attn::mla{
        "        c = self.kv_down(x)\n",
        "        k = self.k_up(c)\n",
        "        v = self.v_up(c)\n",
}@}
@Impl::Attn::tpa{
        "        # TPA: rebuild q/k/v from rank-R factors (mean over R outer products)\n",
        "        aq = self.a_q(x)\n",
        "        bq = torch.stack([l(x) for l in self.b_q], dim=-1)\n",
        "        q = (aq.unsqueeze(-2) * bq).sum(-1) / self.tpa_rank\n",
        "        ak = self.a_k(x)\n",
        "        bk = torch.stack([l(x) for l in self.b_k], dim=-1)\n",
        "        k = (ak.unsqueeze(-2) * bk).sum(-1) / self.tpa_rank\n",
        "        av = self.a_v(x)\n",
        "        bv = torch.stack([l(x) for l in self.b_v], dim=-1)\n",
        "        v = (av.unsqueeze(-2) * bv).sum(-1) / self.tpa_rank\n",
}@}
        "        if kv is not None:\n",
        "            k, v = kv\n",
        "        wei = attn_scores(q, k) * (C ** -0.5)\n",
        "        wei = wei.masked_fill(self.tril[:T, :T] == 0, float(\"-inf\"))\n",
@Impl::Attn::dsa{
        "        idx = torch.arange(T, device=x.device)\n",
        "        local = (idx.unsqueeze(0) - idx.unsqueeze(1) < 32)\n",
        "        strided = ((idx.unsqueeze(0) - idx.unsqueeze(1)) % 8 == 0)\n",
        "        wei = wei.masked_fill(~((self.tril[:T, :T] > 0) & (local | strided)), float(\"-inf\"))\n",
        "        k_top = min(32, T)\n",
        "        topv, _ = wei.topk(k_top, dim=-1)\n",
        "        wei = wei.masked_fill(wei < topv[..., -1].unsqueeze(-1), float(\"-inf\"))\n",
}@}
        "        wei = F.softmax(wei, dim=-1)\n",
        "        out = attn_combine(wei, v)\n",
@Impl::Attn::tokenformer{
        "        # Token-parameter attention overrides the token-mixing output above\n",
        "        p_k = self.p_keys.unsqueeze(0).expand(B, -1, -1)\n",
        "        p_v = self.p_values.unsqueeze(0).expand(B, -1, -1)\n",
        "        tok_wei = attn_scores(q, p_k) * (C ** -0.5)\n",
        "        tok_wei = F.softmax(tok_wei, dim=-1)\n",
        "        out = attn_combine(tok_wei, p_v)\n",
}@}
        "        return out\n"
      ]
    },
    @Impl::Attn::vanillaatten{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Multi-Head Self-Attention Demo"
      ]
    }
    }@},
    @Impl::Attn::vanillaatten{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Multi-head self-attention demo.\"\"\"\n",
        "n_heads = 2\n",
        "heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
        "attn_outs = [head(x) for head in heads]\n",
        "attn_out = torch.cat(attn_outs, dim=2)\n"
      ]
    }
    }@},
    @Impl::Attn::vanillaatten{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Projection",
        "Mix information across heads with a final projection."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "proj = QKVLinear(n_heads * head_sz, emb_dim)\n"
      ]
    }
    }@},
    @Impl::Attn::vanillaatten{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "multi_attn_out = proj(attn_out)\n",
        "print(f\"{multi_attn_out.shape=}\")\n"
      ]
    }
    }@},
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. MultiHead \u2013 Full Multi-Head Attention Module"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Multi-head self-attention module.\"\"\"\n",
        "class MultiHead(nn.Module):\n",
        "    def __init__(self, n_heads, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.n_heads = n_heads\n",
@Impl::Attn::mqa{
        "        # MQA: n_heads queries share ONE key/value (Shazeer 2019)\n",
        "        self.queries = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(n_heads)])\n",
        "        self.key = QKVLinear(emb_dim, head_sz, bias=False)\n",
        "        self.value = QKVLinear(emb_dim, head_sz, bias=False)\n",
}@}
@Impl::Attn::gqa{
        "        # GQA: queries grouped over n_kv_heads key/values (Ainslie et al. 2023)\n",
        "        self.n_kv_heads = max(1, n_heads // 2)\n",
        "        self.queries = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(n_heads)])\n",
        "        self.keys = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(self.n_kv_heads)])\n",
        "        self.values = nn.ModuleList([QKVLinear(emb_dim, head_sz, bias=False) for _ in range(self.n_kv_heads)])\n",
}@}
@Impl::Attn::vanillaatten{
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::mla{
        "        # MLA: compression lives inside each Head\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::dsa{
        "        # DSA: sparsity lives inside each Head\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::tokenformer{
        "        # TokenFormer: capacity lives in each Head's parameter tokens\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
@Impl::Attn::tpa{
        "        # TPA: factorization lives inside each Head\n",
        "        self.heads = nn.ModuleList([Head(head_sz, emb_dim) for _ in range(n_heads)])\n",
}@}
        "        self.proj = QKVLinear(n_heads * head_sz, emb_dim)\n",
        "        self.register_buffer(\"tril\", torch.tril(torch.ones(ctx_len, ctx_len)))\n",
        "\n",
        "    def forward(self, x):\n",
        "        B, T, C = x.shape\n",
@Impl::Attn::mqa{
        "        k = self.key(x)\n",
        "        v = self.value(x)\n",
        "        outs = []\n",
        "        for q_layer in self.queries:\n",
        "            q = q_layer(x)\n",
        "            wei = attn_scores(q, k) * (C ** -0.5)\n",
        "            wei = wei.masked_fill(self.tril[:T, :T] == 0, float(\"-inf\"))\n",
        "            wei = F.softmax(wei, dim=-1)\n",
        "            outs.append(attn_combine(wei, v))\n",
        "        out = torch.cat(outs, dim=-1)\n",
}@}
@Impl::Attn::gqa{
        "        ks = [k_layer(x) for k_layer in self.keys]\n",
        "        vs = [v_layer(x) for v_layer in self.values]\n",
        "        outs = []\n",
        "        for i, q_layer in enumerate(self.queries):\n",
        "            q = q_layer(x)\n",
        "            k = ks[(i * self.n_kv_heads) // self.n_heads]\n",
        "            v = vs[(i * self.n_kv_heads) // self.n_heads]\n",
        "            wei = attn_scores(q, k) * (C ** -0.5)\n",
        "            wei = wei.masked_fill(self.tril[:T, :T] == 0, float(\"-inf\"))\n",
        "            wei = F.softmax(wei, dim=-1)\n",
        "            outs.append(attn_combine(wei, v))\n",
        "        out = torch.cat(outs, dim=-1)\n",
}@}
@Impl::Attn::vanillaatten{
        "        out = torch.cat([h(x) for h in self.heads], dim=-1)\n",
}@}
@Impl::Attn::mla{
        "        out = torch.cat([h(x) for h in self.heads], dim=-1)\n",
}@}
@Impl::Attn::dsa{
        "        out = torch.cat([h(x) for h in self.heads], dim=-1)\n",
}@}
@Impl::Attn::tokenformer{
        "        out = torch.cat([h(x) for h in self.heads], dim=-1)\n",
}@}
@Impl::Attn::tpa{
        "        out = torch.cat([h(x) for h in self.heads], dim=-1)\n",
}@}
        "        return self.proj(out)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. FeedForward"
      ]
    },
    @Impl::Model::matmul{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Feed-forward network (matmul variant).\"\"\"\n",
        "class FeedForward(nn.Module):\n",
        "    def __init__(self, emb_dim):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(emb_dim, 4 * emb_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Linear(4 * emb_dim, emb_dim),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.net(x)\n"
      ]
    }
    }@},
    @Impl::Model::addernetmatmul{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Feed-forward network (addernet variant).\"\"\"\n",
        "class FeedForward(nn.Module):\n",
        "    def __init__(self, emb_dim):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            AdderConvLinear(emb_dim, 4 * emb_dim),\n",
        "            nn.GELU(),\n",
        "            AdderConvLinear(4 * emb_dim, emb_dim),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.net(x)\n"
      ]
    }
    }@},
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Block \u2013 Decoder Block",
        "",
        "Normalization technique: `layernorm` uses `nn.LayerNorm` (standard for Transformers).",
        "`regularisedbn` uses `RegularisedBN` from Wang et al. arXiv:2210.05153."
      ]
    },
    @Impl::State::regularisedbn{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"RegularisedBN: Batch Normalization with regularisation for Transformers.\n",
        "Based on Wang et al., 'Understanding the Failure of Batch Normalization\n",
        "for Transformers in NLP', arXiv:2210.05153, 2022.\"\"\"\n",
        "class RegularisedBN(nn.Module):\n",
        "    \"\"\"BatchNorm1d with a regularisation penalty that stabilises training\n",
        "    by penalising deviations of batch statistics from running statistics.\"\"\"\n",
        "    def __init__(self, num_features, eps=1e-5, momentum=0.1, reg_lambda=0.01):\n",
        "        super().__init__()\n",
        "        self.bn = nn.BatchNorm1d(num_features, eps=eps, momentum=momentum)\n",
        "        self.reg_lambda = reg_lambda\n",
        "        self._reg_loss = 0.0\n",
        "\n",
        "    def forward(self, x):\n",
        "        x_t = x.transpose(1, 2)  # (B, C, T) for BatchNorm1d\n",
        "        out = self.bn(x_t)\n",
        "        out = out.transpose(1, 2)\n",
        "        if self.training:\n",
        "            batch_mean = x_t.mean(dim=(0, 2))\n",
        "            batch_var = x_t.var(dim=(0, 2), unbiased=False)\n",
        "            reg = ((self.bn.running_mean - batch_mean) ** 2).sum() + \\\n",
        "                  ((self.bn.running_var - batch_var) ** 2).sum()\n",
        "            self._reg_loss = self.reg_lambda * reg\n",
        "        else:\n",
        "            self._reg_loss = 0.0\n",
        "        return out\n",
        "\n",
        "    def get_regularisation(self):\n",
        "        return self._reg_loss\n"
      ]
    }
    }@},
    @Impl::State::layernorm{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Decoder block (layernorm variant).\"\"\"\n",
        "# Note: AdderNet paper uses BatchNorm after each adder layer (CNN recipe).\n",
        "# We use LayerNorm, which is the standard normalization for Transformers.\n",
        "class Block(nn.Module):\n",
        "    def __init__(self, emb_dim, n_heads):\n",
        "        super().__init__()\n",
        "        head_sz = emb_dim // n_heads\n",
        "        self.self_attn = MultiHead(n_heads, head_sz, emb_dim)\n",
        "        self.self_attn_dropout = nn.Dropout(0.1)\n",
        "        self.ffwd = FeedForward(emb_dim)\n",
        "        self.ln1 = nn.LayerNorm(emb_dim)\n",
        "        self.ln2 = nn.LayerNorm(emb_dim)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = x + self.self_attn_dropout(self.self_attn(self.ln1(x)))\n",
        "        x = x + self.ffwd(self.ln2(x))\n",
        "        return x\n"
      ]
    }
    }@},
    @Impl::State::regularisedbn{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Decoder block (regularisedbn variant).\"\"\"\n",
        "class Block(nn.Module):\n",
        "    def __init__(self, emb_dim, n_heads):\n",
        "        super().__init__()\n",
        "        head_sz = emb_dim // n_heads\n",
        "        self.self_attn = MultiHead(n_heads, head_sz, emb_dim)\n",
        "        self.self_attn_dropout = nn.Dropout(0.1)\n",
        "        self.ffwd = FeedForward(emb_dim)\n",
        "        self.ln1 = RegularisedBN(emb_dim)\n",
        "        self.ln2 = RegularisedBN(emb_dim)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = x + self.self_attn_dropout(self.self_attn(self.ln1(x)))\n",
        "        x = x + self.ffwd(self.ln2(x))\n",
        "        return x\n"
      ]
    }
    }@},
    @Impl::Arch::decoderonly{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 8. NanoGPT \u2013 Full Decoder-only Transformer"
      ]
    }
    }@},
    @Impl::Arch::encoderdecoder{
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 8. EncoderDecoderTransformer \u2013 Encoder-Decoder Architecture",
        "",
        "A full encoder-decoder Transformer (Vaswani et al., 2017).",
        "The **encoder** stack is bidirectional \u2014 each `EncoderBlock` attends over the",
        "whole sequence with no causal mask \u2014 while the **decoder** stack reuses the",
        "causal `Block` to produce next-token predictions conditioned on the encoder output."
      ]
    }
    }@},
    @Impl::Model::matmul,Arch::decoderonly{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"NanoGPT: Decoder-only Transformer (matmul variant).\"\"\"\n",
        "class NanoGPT(nn.Module):\n",
        "    def __init__(self, vocab_sz, emb_dim, ctx_len, n_layers, n_heads):\n",
        "        super().__init__()\n",
        "        self.ctx_len = ctx_len\n",
        "        self.token_embedding = nn.Embedding(vocab_sz, emb_dim)\n",
        "        self.position_embedding = nn.Embedding(ctx_len, emb_dim)\n",
        "        self.blocks = nn.Sequential(*[\n",
        "            Block(emb_dim, n_heads) for _ in range(n_layers)\n",
        "        ])\n",
        "        self.ln_final = nn.LayerNorm(emb_dim)\n",
        "        self.lm_head = nn.Linear(emb_dim, vocab_sz)\n",
        "\n",
        "    def forward(self, x):\n",
        "        B, T = x.shape\n",
        "        pos = torch.arange(0, T, dtype=torch.long, device=x.device)\n",
        "        tok_emb = self.token_embedding(x)\n",
        "        pos_emb = self.position_embedding(pos)\n",
        "        x = tok_emb + pos_emb\n",
        "        x = self.blocks(x)\n",
        "        x = self.ln_final(x)\n",
        "        logits = self.lm_head(x)\n",
        "        return logits\n",
        "\n",
        "    def generate(self, x, max_new_tokens):\n",
        "        for _ in range(max_new_tokens):\n",
        "            x_crop = x[:, -self.ctx_len:]\n",
        "            logits = self(x_crop)\n",
        "            logits = logits[:, -1, :]\n",
        "            probs = F.softmax(logits, dim=-1)\n",
        "            x_next = torch.multinomial(probs, num_samples=1)\n",
        "            x = torch.cat((x, x_next), dim=1)\n",
        "        return x\n"
      ]
    }
    }@},
    @Impl::Model::addernetmatmul,Arch::decoderonly{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"NanoGPT: Decoder-only Transformer (addernet variant).\"\"\"\n",
        "class NanoGPT(nn.Module):\n",
        "    def __init__(self, vocab_sz, emb_dim, ctx_len, n_layers, n_heads):\n",
        "        super().__init__()\n",
        "        self.ctx_len = ctx_len\n",
        "        self.token_embedding = nn.Embedding(vocab_sz, emb_dim)\n",
        "        self.position_embedding = nn.Embedding(ctx_len, emb_dim)\n",
        "        self.blocks = nn.Sequential(*[\n",
        "            Block(emb_dim, n_heads) for _ in range(n_layers)\n",
        "        ])\n",
        "        self.ln_final = nn.LayerNorm(emb_dim)\n",
        "        self.lm_head = AdderConvLinear(emb_dim, vocab_sz)\n",
        "\n",
        "    def forward(self, x):\n",
        "        B, T = x.shape\n",
        "        pos = torch.arange(0, T, dtype=torch.long, device=x.device)\n",
        "        tok_emb = self.token_embedding(x)\n",
        "        pos_emb = self.position_embedding(pos)\n",
        "        x = tok_emb + pos_emb\n",
        "        x = self.blocks(x)\n",
        "        x = self.ln_final(x)\n",
        "        logits = self.lm_head(x)\n",
        "        return logits\n",
        "\n",
        "    def generate(self, x, max_new_tokens):\n",
        "        for _ in range(max_new_tokens):\n",
        "            x_crop = x[:, -self.ctx_len:]\n",
        "            logits = self(x_crop)\n",
        "            logits = logits[:, -1, :]\n",
        "            probs = F.softmax(logits, dim=-1)\n",
        "            x_next = torch.multinomial(probs, num_samples=1)\n",
        "            x = torch.cat((x, x_next), dim=1)\n",
        "        return x\n"
      ]
    }
    }@},
    @Impl::Model::matmul,State::layernorm,Arch::encoderdecoder{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"EncoderHead: bidirectional self-attention head (matmul variant).\"\"\"\n",
        "class EncoderHead(nn.Module):\n",
        "    def __init__(self, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.head_sz, self.emb_dim = head_sz, emb_dim\n",
        "        self.key = nn.Linear(emb_dim, head_sz, bias=False)\n",
        "        self.query = nn.Linear(emb_dim, head_sz, bias=False)\n",
        "        self.value = nn.Linear(emb_dim, head_sz, bias=False)\n",
        "\n",
        "    def forward(self, x):\n",
        "        B, T, C = x.shape\n",
        "        k = self.key(x)\n",
        "        q = self.query(x)\n",
        "        v = self.value(x)\n",
        "        wei = q @ k.transpose(-2, -1) * C ** -0.5\n",
        "        wei = F.softmax(wei, dim=-1)\n",
        "        out = wei @ v\n",
        "        return out\n",
        "\n",
        "\n",
        "\"\"\"CrossHead: cross-attention head, queries from decoder, keys/values from encoder (matmul).\"\"\"\n",
        "class CrossHead(nn.Module):\n",
        "    def __init__(self, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.head_sz, self.emb_dim = head_sz, emb_dim\n",
        "        self.key = nn.Linear(emb_dim, head_sz, bias=False)\n",
        "        self.query = nn.Linear(emb_dim, head_sz, bias=False)\n",
        "        self.value = nn.Linear(emb_dim, head_sz, bias=False)\n",
        "\n",
        "    def forward(self, x, enc):\n",
        "        B, T, C = x.shape\n",
        "        k = self.key(enc)\n",
        "        q = self.query(x)\n",
        "        v = self.value(enc)\n",
        "        wei = q @ k.transpose(-2, -1) * C ** -0.5\n",
        "        wei = F.softmax(wei, dim=-1)\n",
        "        out = wei @ v\n",
        "        return out\n",
        "\n",
        "\n",
        "\"\"\"EncoderBlock: bidirectional multi-head attention + FFN (matmul, layernorm).\"\"\"\n",
        "class EncoderBlock(nn.Module):\n",
        "    def __init__(self, emb_dim, n_heads):\n",
        "        super().__init__()\n",
        "        head_sz = emb_dim // n_heads\n",
        "        self.heads = nn.ModuleList([EncoderHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
        "        self.proj = nn.Linear(n_heads * head_sz, emb_dim)\n",
        "        self.ffwd = FeedForward(emb_dim)\n",
        "        self.ln1 = nn.LayerNorm(emb_dim)\n",
        "        self.ln2 = nn.LayerNorm(emb_dim)\n",
        "\n",
        "    def forward(self, x):\n",
        "        out = torch.cat([h(x) for h in self.heads], dim=-1)\n",
        "        x = x + self.proj(out)\n",
        "        x = x + self.ffwd(self.ln2(x))\n",
        "        return x\n",
        "\n",
        "\n",
        "\"\"\"CrossBlock: causal self-attn + cross-attn to encoder + FFN (matmul, layernorm).\"\"\"\n",
        "class CrossBlock(nn.Module):\n",
        "    def __init__(self, emb_dim, n_heads):\n",
        "        super().__init__()\n",
        "        head_sz = emb_dim // n_heads\n",
        "        self.self_attn = MultiHead(n_heads, head_sz, emb_dim)\n",
        "        self.cross_heads = nn.ModuleList([CrossHead(head_sz, emb_dim) for _ in range(n_heads)])\n",
        "        self.cross_proj = nn.Linear(n_heads * head_sz, emb_dim)\n",
        "        self.ffwd = FeedForward(emb_dim)\n",
        "        self.ln1 = nn.LayerNorm(emb_dim)\n",
        "        self.ln2 = nn.LayerNorm(emb_dim)\n",
        "        self.ln3 = nn.LayerNorm(emb_dim)\n",
        "\n",
        "    def forward(self, x, enc):\n",
        "        x = x + self.self_attn(self.ln1(x))\n",
        "        cross = torch.cat([h(self.ln2(x), enc) for h in self.cross_heads], dim=-1)\n",
        "        x = x + self.cross_proj(cross)\n",
        "        x = x + self.ffwd(self.ln3(x))\n",
        "        return x\n"
      ]
    }
