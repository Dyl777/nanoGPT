        "\"\"\"Context 256 (~40 words): short QA pairs fit whole. New position table, so this \"\"\"\n",
        "\"\"\"Impl re-seats position_embedding then requires retraining (no logic change).\"\"\"\n",
        "ctx_len = 256\n",
        "model.position_embedding = torch.nn.Embedding(ctx_len, model.token_embedding.weight.shape[1]).to(device)\n",
