        "\"\"\"B*H*T^2 floats per layer (~67M at B=8,H=8,T=1024) - shrink batch and/or compose \"\"\"\n",
        "\"\"\"with Attn::slidingwindow past this point. Pairs need no packing below ~150 words.\"\"\"\n",
        "ctx_len = 1024\n",
