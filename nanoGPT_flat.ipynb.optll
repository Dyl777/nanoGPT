      "source": [
        "# ALWAYS-PRESENT runner: KeepKV end-to-end | Legs full / evict-only (H2O) / convex-merge / keepkv (votes+ZIP) / keepkv+pyramid-sets + periodic byte plan | emits outputs/keepkv_results.json | plain orchestrator, no Impl tag by design.\n",
        "import torch as _t27\n",
        "import json as _j29\n",
        "import time as _time29\n",
        "from pathlib import Path as _P29\n",
        "def run_keepkv_benchmark(make_model, ids, budget=32, seed=16,\n",
        "                         out_path=\"outputs/keepkv_results.json\"):\n",
        "    \"\"\"Run KeepKV measurement sets on one prefilled model.\n",
        "\n",
        "    make_model: zero-arg factory for the compiled-path NanoGPT (factory seeds\n",
        "    construction; runner seeds its own draws). Writes outputs/keepkv_results.json.\n",
        "    \"\"\"\n",
        "    t0 = _time29.time()\n",
        "    model = make_model()\n",
        "    model.eval()\n",
        "    H = KVCacheHarness(model, budget=budget).prefill(ids)\n",
        "    full = H.eq12_bytes()[\"full\"]\n",
        "    m0 = H.retained_mass({k: _t27.arange(H.T) for k in H.cache})\n",
        "    measurements = {\"full\": {\"paper_claim\": \"baseline (FullKV 100%)\",\n",
        "                     \"mass\": float(sum(m0.values()) / max(1, len(m0))),\n",
        "                     \"bytes\": full, \"ratio\": 1.0}}\n",
        "    ev = H2OEvictor()\n",
        "    kept = {}\n",
        "    for k, c in H.cache.items():\n",
        "        S = c[\"S\"]\n",
        "        kept[k] = ev.select(S.sum(0), min(budget, H.T), win=S[-8:], recent_w=6, seed=seed)\n",
        "    me = H.retained_mass(kept)\n",
        "    ee = H.attn_output_error(kept)\n",
        "    be = H.eq12_bytes({k: int(v.numel()) for k, v in kept.items()})\n",
        "    measurements[\"evict_h2o\"] = {\"paper_claim\": \"reported: H2O baseline (Table 2, beaten by KeepKV)\",\n",
        "                         \"mass\": float(sum(me.values()) / max(1, len(me))),\n",
        "                         \"out_err\": float(sum(ee.values()) / max(1, len(ee))),\n",
        "                         \"bytes\": be[\"kept\"], \"ratio\": be[\"ratio\"]}\n",
        "    kk = KeepKVCompressor()\n",
        "    mc, ec, bc, sc, zc = [], [], 0, [], []\n",
        "    for k, c in H.cache.items():\n",
        "        S = c[\"S\"]\n",
        "        acc = S.sum(0)\n",
        "        Kh, Vh, meta = kk.compress(c[\"K\"], c[\"V\"], keep=kept[k], scores=_t27.exp(\n",
        "            c[\"qlast\"].unsqueeze(0) @ c[\"K\"].T / (c[\"head_dim\"] ** 0.5)).squeeze(0))\n",
        "        bc += meta[\"bytes\"]\n",
        "        o_full = S[-1] @ c[\"V\"]\n",
        "        o_z, s_z = kk.merged_attention(Kh, Vh, meta[\"votes\"], c[\"qlast\"], c[\"head_dim\"])\n",
        "        ec.append(float((o_z - o_full).norm() / (o_full.norm() + 1e-12)))\n",
        "        mc.append(float(S[-1][meta[\"represented\"]].sum()))\n",
        "        Kn = c[\"K\"] / c[\"K\"].norm(dim=-1, keepdim=True).clamp_min(1e-12)\n",
        "        evl = [i for i in range(H.T) if i not in set(kept[k].tolist())]\n",
        "        if evl:\n",
        "            e0 = evl[0]\n",
        "            sims = Kn[e0] @ Kn[kept[k]].T\n",
        "            cc = int(kept[k][int(sims.argmax())])\n",
        "            krc, vrc = _keepkv_convex(c[\"K\"], c[\"V\"], e0, cc)\n",
        "            src = float(torch.exp(c[\"qlast\"] @ krc / (c[\"head_dim\"] ** 0.5)))\n",
        "            rest = [i for i in range(H.T) if i not in (e0, cc)]\n",
        "            cur = _t27.exp(c[\"qlast\"].unsqueeze(0) @ c[\"K\"].T / (c[\"head_dim\"] ** 0.5)).squeeze(0)\n",
        "            oc = (cur[rest] @ c[\"V\"][rest] + src * vrc) / (cur[rest].sum() + src)\n",
        "            sc.append(float((oc - o_full).norm()))\n",
        "            krz, vrz, prz = kk.zip_merge(c[\"K\"], c[\"V\"], e0, cc, float(cur[e0]), float(cur[cc]))\n",
        "            srz = float(torch.exp(c[\"qlast\"] @ krz / (c[\"head_dim\"] ** 0.5)))\n",
        "            oz = (cur[rest] @ c[\"V\"][rest] + prz * srz * vrz) / (cur[rest].sum() + prz * srz)\n",
        "            zc.append(float((oz - o_full).norm()))\n",
        "    measurements[\"keepkv_h2o_sets\"] = {\"paper_claim\": \"reported: best AVG per band (Table 2); 255.99 tokens/s (Table 1)\",\n",
        "                               \"mass\": float(sum(mc) / max(1, len(mc))),\n",
        "                               \"out_err\": float(sum(ec) / max(1, len(ec))),\n",
        "                               \"bytes\": bc, \"ratio\": bc / max(1, full),\n",
        "                               \"sag_mean\": float(sum(sc) / max(1, len(sc))),\n",
        "                               \"zip_mean\": float(sum(zc) / max(1, len(zc)))}\n",
        "    measurements[\"convex_merge\"] = {\"paper_claim\": \"reported: convex merging always sags (Thm.2)\",\n",
        "                            \"sag_mean\": float(sum(sc) / max(1, len(sc)))}\n",
        "    spec = {\"T\": H.T, \"L\": H.n_layers, \"H\": len(H.layers[0]),\n",
        "            \"hs\": H.cache[(0, 0)][\"head_dim\"], \"bpe\": 4}\n",
        "    measurements[\"periodic\"] = dict({\"paper_claim\": \"headline scheme: external full store + reloads (policy simulation)\"},\n",
        "                            **keepkv_periodic_plan(spec))\n",
        "    res = {\"paper\": \"arXiv:2504.09936\", \"seed\": seed, \"T\": H.T, \"budget\": budget,\n",
        "           \"purpose\": \"small-scale mechanism measurement sets (mass/error/bytes/sag); paper magnitudes are reported claims only\",\n",
        "           \"measurements\": measurements, \"seconds\": round(_time29.time() - t0, 1)}\n",
        "    _P29(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P29(out_path).write_text(_j29.dumps(res, indent=2, default=str), encoding=\"utf-8\")\n",
        "    ok = {n: (\"error\" not in v) for n, v in measurements.items()}\n",
        "    print(_j29.dumps({\"measurements_ok\": ok}, indent=2))\n",
        "    return res\n"
      ]
    },
