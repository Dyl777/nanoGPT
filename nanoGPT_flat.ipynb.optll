        "# ALWAYS-PRESENT runner: grokking sweep end-to-end | Wraps s16 wired_d_sweep with predicted-vs-measured table + results JSON | emits outputs/grokking_results.json | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Runs the D-sweep on live models and scores the paper's claims: D-doubling speedup \"\"\"\n",
        "\"\"\"near 4.1x, lam>=1.0 groks, norm ratio in r* band. One row per D leg, verdict per claim.\"\"\"\n",
        "import json as _json3\n",
        "def run_grokking_benchmark(make_model_fn, P=113, op=\"add\", Ds=(0.3, 0.5, 0.7, 0.97), eta=0.003, lam=0.3, steps=5000, out_path=\"outputs/grokking_results.json\"):\n",
        "    from pathlib import Path as _P\n",
