    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Build dataset.\"\"\"\n",
        "def build_dataset(txtfile, ctx_len):\n",
        "    with open(txtfile) as f:\n",
        "        text = f.read()\n",
        "    tokens = sorted(list(set(text)))\n",
        "    token_to_int = {t: i for i, t in enumerate(tokens)}\n",
        "    encode = lambda tokens: [token_to_int[t] for t in tokens]\n",
        "    data = torch.tensor(encode(text), dtype=torch.long)\n",
        "    n = int(0.9 * len(data))\n",
        "    train_data, val_data = data[:n], data[n:]\n",
        "    batch_sz_loc = 32\n",
        "    def get_batch(split):\n",
        "        d = train_data if split == \"train\" else val_data\n",
        "        ix = torch.randint(len(d) - ctx_len, (batch_sz_loc,))\n",
        "        xb = torch.stack([d[i:i+ctx_len] for i in ix])\n",
        "        yb = torch.stack([d[i+1:i+ctx_len+1] for i in ix])\n",
        "        return xb, yb\n",
        "    return get_batch\n",
        "get_batch = build_dataset(filepath, ctx_len)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Xavier initialisation.\"\"\"\n",
        "def xavier_init(m):\n",
        "    if isinstance(m, (nn.Linear, nn.Embedding)):\n",
        "        torch.nn.init.xavier_uniform_(m.weight)\n",
        "    elif isinstance(m, (nn.Conv2d,)):\n",
        "        torch.nn.init.xavier_uniform_(m.weight)\n",
        "xavier_init(model)\n",
        "model.to(device)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "@torch.no_grad()\n",
        "def estimate_losses(model, val_loader, loss_fn, n_tokens, val_iter=5):\n",
        "    model.eval()\n",
        "    losses = []\n",
        "    for batch_idx, (xb, yb) in enumerate(val_loader):\n",
        "        if batch_idx >= val_iter:\n",
        "            break\n",
        "        xb, yb = xb.to(device), yb.to(device)\n",
        "        logits = model(xb)\n",
        "        loss = loss_fn(logits.view(-1, logits.size(-1)), yb.view(-1))\n",
        "        losses.append(loss.item())\n",
        "    return np.mean(losses).item()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 9. Training Loop"
      ]
    },
    @Impl::State::layernorm{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Training loop (layernorm variant).\"\"\"\n",
        "# Note: AdderNet paper uses SGD+momentum 0.9 + cosine LR schedule (CNN recipe).\n",
        "# We use AdamW (nanoGPT's standard) since this is a Transformer.\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "optimizer = optim.AdamW(model.parameters(), lr=3e-4)\n",
        "n_epochs = 3\n",
        "batch_lim = 50\n",
        "xb, yb = get_batch(\"train\")\n",
        "xb, yb = xb.to(device), yb.to(device)\n",
        "for epoch in range(n_epochs):\n",
        "    model.train()\n",
        "    losses = []\n",
        "    for batch_idx in range(batch_lim):\n",
        "        logits = model(xb)\n",
        "        loss = loss_fn(logits.view(-1, logits.size(-1)), yb.view(-1))\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        losses.append(loss.item())\n",
        "        xb, yb = get_batch(\"train\")\n",
        "        xb, yb = xb.to(device), yb.to(device)\n",
        "    avg_loss = np.mean(losses).item()\n",
        "    print(f\"Epoch {epoch+1}/{n_epochs}  loss={avg_loss:.4f}\")\n",
        "print(\"Training complete!\")\n"
      ]
    }
    }@},
    @Impl::State::regularisedbn{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Training loop (regularisedbn variant) with regularisation loss.\"\"\"\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "optimizer = optim.AdamW(model.parameters(), lr=3e-4)\n",
        "n_epochs = 3\n",
        "batch_lim = 50\n",
        "for epoch in range(n_epochs):\n",
        "    model.train()\n",
        "    losses = []\n",
        "    for batch_idx in range(batch_lim):\n",
        "        xb, yb = get_batch(\"train\")\n",
        "        xb, yb = xb.to(device), yb.to(device)\n",
        "        logits = model(xb)\n",
        "        loss = loss_fn(logits.view(-1, logits.size(-1)), yb.view(-1))\n",
        "        reg_loss = sum(m.get_regularisation() for m in model.modules()\n",
        "                      if hasattr(m, 'get_regularisation'))\n",
        "        loss = loss + reg_loss\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        losses.append(loss.item())\n",
        "    avg_loss = np.mean(losses).item()\n",
        "    print(f\"Epoch {epoch+1}/{n_epochs}  loss={avg_loss:.4f}\")\n",
        "print(\"Training complete!\")\n"
      ]
    }
    }@},
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Generate text and save/load model.\"\"\"\n",
        "start = torch.zeros((1, 1), dtype=torch.long)\n",
        "gen = model.generate(start, max_new_tokens=100)\n",
        "gen = decode(gen[0].tolist())\n",
        "print(f\"\\nGenerated text:\\n{gen}\")\n",
        "print(\"Done!\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 10. Hallucination Probing \u2013 The Hallucination Signal Is a Mean Shift: Why Simple Probes Suffice (Lee, Seo, Lim 2026, arXiv:2608.28930; LayerMix method)\n",
        "",
        "**Paper in one paragraph.** Hidden-state probes detect LLM hallucinations, but recent work piles on architectural complexity (cross-layer tracking, optimal-transport pseudo-labels, attention-gated subspaces) without characterising the signal geometry. This paper measures it in the controlled **paired-example paradigm** (factual vs hallucinated input pairs, 3x 7B models x 3 datasets: TruthfulQA N=4,135, HaluEval-Dialogue N=20,000, FaithDial N=5,848) and finds the signal is overwhelmingly **one mean-shift direction** \\(\\\\delta = \\\\mu_1 - \\\\mu_0\\\\): deleting it collapses detection to chance (0.499 AUROC); projecting onto it alone recovers 0.834; shrinkage LDA closes ~73% of the remaining Fisher gap, so apparent complexity is high-dimensional covariance-estimation noise, not non-linearity. A plain **L2-regularized logistic regression (C=0.001, 0.952 AUROC)** bounds or beats 12 engineered alternatives, and the signal spans a **contiguous layer band** (best layer varies: L14 Llama, L16 Mistral, L18 Qwen), so **LayerMix** \\u2014 CV-score every layer, keep top-K=5, train one probe per layer, average predictions \\u2014 matches oracle-layer performance (0.954) with ~35s overhead. Scope warning from the authors: paired-example only; the direction does NOT transfer to free-form generation (their pilot: 0.477) and mean shifts are near-orthogonal across datasets (cos~0.12).\n",
        "",
        "**How it helps this repo.** nanoGPT (char-level tiny-Shakespeare) cannot reproduce 7B QA numbers, but it adopts the *method*: freeze model \\u2192 last-token hidden states \\u2192 StandardScaler \\u2192 stratified 5-fold CV \\u2192 L2-LR probe. That simple probe is the bar every future detector must beat. LayerMix ports directly to the 3-layer nanoGPT stack (CV top-K + averaging, no oracle access). Diagnostics port too: length-confound check, mean-shift ablation, layer-wise AUROC curves, label-efficiency curves.\n",
        "",
        "**How it interacts with OPTAL.** Probes sit ON TOP of frozen hidden states extracted via forward hooks \\u2014 zero changes to nanoGPT logic, compatible with EVERY existing impl combo (matmul/addernet, layernorm/regularisedbn, decoder/encdec, vanilla/mqa/gqa/mla/dsa/tokenformer/tpa). Bundle rule: probe heads, corruption ops, extractor, and diagnostics are plain ALWAYS-PRESENT codeblocks (no Impl tags) that must exist in EVERY compiled path; branching them would retrain one model per probe for no reason. They share one site: N\u00d7d states + labels \\u2192 score). Branching is reserved for model-defining axes: Model/State/Arch/Attn/Vocab/Scale/Context. Exotic paper baselines (DoLa, HaloScope, CLAP, ...) stay as `@Graded` published-number checks in `graded/papers/03_*.optll`.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Paired-example dataset pipeline (LayerMix paper \\u00a75, common code, no Impl).\"\"\"\n",
        "\"\"\"Paper datasets: TruthfulQA (TQA, Lin et al. 2022b, N=4,135 QA pairs), \"\"\"\n",
        "\"\"\"HaluEval-Dialogue (HE, Li et al. 2023, N=20,000 dialogue turns), \"\"\"\n",
        "\"\"\"FaithDial (FD, Dziri et al. 2022, N=5,848 info-seeking dialogues). \"\"\"\n",
        "\"\"\"Paradigm: PAIRED examples \\u2014 each prompt appears once factual (y=0) and once \"\"\"\n",
        "\"\"\"hallucinated (y=1). This isolates representational geometry from \"\"\"\n",
        "\"\"\"generation-induced distribution shift (paper \\u00a75 Protocol). Hidden states are \"\"\"\n",
        "\"\"\"extracted at the LAST token position of each input sequence. \"\"\"\n",
        "\"\"\"nanoGPT adaptation: this repo is char-level tiny-Shakespeare, so the loader tries \"\"\"\n",
        "\"\"\"HuggingFace `datasets` first, then falls back to a synthetic Gaussian paired \"\"\"\n",
        "\"\"\"corpus with a planted mean shift (same geometry the paper measures), tokenized \"\"\"\n",
        "\"\"\"through the repo char vocabulary. No model logic is touched.\"\"\"\n",
        "def build_paired_corpus(dataset=\"TQA\", n_pairs=500, seed=0, use_hf=True):\n",
        "    import random\n",
        "    rng = random.Random(seed)\n",
        "    if use_hf:\n",
        "        try:\n",
        "            from datasets import load_dataset\n",
        "            name_map = {\n",
        "                \"TQA\": (\"truthfulqa/truthful_qa\", \"generation\"),\n",
        "                \"HE\": (\"pminervini/HaluEval\", \"dialogue\"),\n",
        "                \"FD\": (\"McGill-NLP/FaithDial\", None),\n",
        "            }\n",
        "            repo, conf = name_map.get(dataset, name_map[\"TQA\"])\n",
        "            ds = load_dataset(repo, conf, split=\"validation\" if dataset == \"TQA\" else \"test\")\n",
        "            pairs = []\n",
        "            for row in ds:\n",
        "                q = row.get(\"question\", row.get(\"prompt\", row.get(\"history\", \"\")))\n",
        "                good = row.get(\"best_answer\", row.get(\"correct_answer\", row.get(\"response\", \"\")))\n",
        "                bad = row.get(\"incorrect_answers\", row.get(\"hallucinated_response\", [\"?\"]))\n",
        "                bad = bad[0] if isinstance(bad, list) else bad\n",
        "                if q and good and bad:\n",
        "                    pairs.append((str(q), str(good), str(bad)))\n",
        "                if len(pairs) >= n_pairs:\n",
        "                    break\n",
        "            if pairs:\n",
        "                return pairs\n",
        "        except Exception as e:\n",
        "            print(f\"  HF load failed ({e}); using synthetic paired corpus.\")\n",
        "    vocab_chars = sorted(set(text))\n",
        "    topics = [\"Romeo\", \"dreams\", \"love\", \"night\", \"sword\", \"crown\"]\n",
        "    pairs = []\n",
        "    for i in range(n_pairs):\n",
        "        t = topics[i % len(topics)]\n",
        "        q = f\"Tell of {t}: \"\n",
        "        good = f\"{t} is true in the play. \"\n",
        "        bad = f\"{t} is false in the play. \"\n",
        "        pairs.append((q, good, bad))\n",
        "    return pairs\n",
        "\n",
        "def encode_paired(pairs, ctx_len):\n",
        "    \"\"\"Encode each (question, good, bad) into two fixed-length int rows.\"\"\"\n",
        "    rows, labels = [], []\n",
        "    for q, good, bad in pairs:\n",
        "        for ans, y in ((good, 0), (bad, 1)):\n",
        "            s = (q + ans)[-ctx_len:]\n",
        "            ids = [token_to_int.get(c, 0) for c in s]\n",
        "            ids = [0] * (ctx_len - len(ids)) + ids\n",
        "            rows.append(ids)\n",
        "            labels.append(y)\n",
        "    import torch as _t\n",
        "    return _t.tensor(rows, dtype=_t.long), _t.tensor(labels, dtype=_t.long)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Frozen hidden-state extractor + CV/AUROC utils (common code, no Impl).\"\"\"\n",
        "\"\"\"Paper \\u00a75: hidden states at the last token; StandardScaler fit on train only; \"\"\"\n",
        "\"\"\"stratified 5-fold CV; LayerMix scoring uses nested CV inside training folds. \"\"\"\n",
        "\"\"\"Implementation uses forward hooks on `model.blocks` (and `model.encoder` when \"\"\"\n",
        "\"\"\"present) so NO model logic changes. Works for NanoGPT and \"\"\"\n",
        "\"\"\"EncoderDecoderTransformer under every OPTAL impl combo.\"\"\"\n",
        "def extract_last_token_states(model, xb, layer_ids=None):\n",
        "    model.eval()\n",
        "    feats = {}\n",
        "    hooks = []\n",
        "    blocks = list(model.blocks) if hasattr(model, \"blocks\") else []\n",
        "    if hasattr(model, \"encoder\"):\n",
        "        blocks = list(model.encoder) + blocks\n",
        "    keep = set(layer_ids) if layer_ids is not None else None\n",
        "    for li, blk in enumerate(blocks):\n",
        "        if keep is not None and li not in keep:\n",
        "            continue\n",
        "        hooks.append(blk.register_forward_hook(\n",
        "            lambda m, inp, out, _li=li: feats.setdefault(_li, out.detach())))\n",
        "    with torch.no_grad():\n",
        "        _ = model(xb.to(next(model.parameters()).device))\n",
        "    for h in hooks:\n",
        "        h.remove()\n",
        "    return {li: feats[li][:, -1, :].float().cpu() for li in sorted(feats)}\n",
        "\n",
        "def standardize_fit_apply(Xtr, Xte):\n",
        "    mu, sd = Xtr.mean(0, keepdim=True), Xtr.std(0, keepdim=True).clamp_min(1e-12)\n",
        "    return (Xtr - mu) / sd, (Xte - mu) / sd\n",
        "\n",
        "def stratified_folds(y, k=5, seed=0):\n",
        "    g = torch.Generator().manual_seed(seed)\n",
        "    folds = [[] for _ in range(k)]\n",
        "    for c in y.unique():\n",
        "        idx = (y == c).nonzero(as_tuple=True)[0]\n",
        "        idx = idx[torch.randperm(len(idx), generator=g)]\n",
        "        for i, j in enumerate(idx.tolist()):\n",
        "            folds[i % k].append(j)\n",
        "    return [torch.tensor(f, dtype=torch.long) for f in folds]\n",
        "\n",
        "def auroc_score(y_true, y_score):\n",
        "    \"\"\"Mann-Whitney AUROC (no sklearn dependency).\"\"\"\n",
        "    y_true = y_true.reshape(-1).double()\n",
        "    y_score = y_score.reshape(-1).double()\n",
        "    order = torch.argsort(y_score)\n",
        "    ranks = torch.empty_like(order, dtype=torch.double)\n",
        "    ranks[order] = torch.arange(1, len(order) + 1, dtype=torch.double)\n",
        "    n1, n0 = y_true.sum(), (1 - y_true).sum()\n",
        "    if n1 == 0 or n0 == 0:\n",
        "        return 0.5\n",
        "    return float((ranks[y_true == 1].sum() - n1 * (n1 + 1) / 2) / (n1 * n0))\n",
        "\n",
        "def cv_auroc_for_probe(X, y, fit_predict, k=5, seed=0):\n",
        "    aucs = []\n",
        "    for fold in stratified_folds(y, k, seed):\n",
        "        te = fold\n",
        "        tr = torch.tensor([i for i in range(len(y)) if i not in set(te.tolist())])\n",
        "        Xtr, Xte = standardize_fit_apply(X[tr], X[te])\n",
        "        aucs.append(auroc_score(y[te], fit_predict(Xtr, y[tr], Xte)))\n",
        "    return float(sum(aucs) / len(aucs)), aucs\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Mean-shift geometry + linear probes (Paper \\u00a73, Table 1/2/8).\"\"\"\n",
        "\"\"\"\\u2022 delta = mu1 - mu0 (class centroids on train fold ONLY, per paper \\u00a73.1, to avoid \"\"\"\n",
        "\"\"\"  in-sample artifacts). Removing delta collapses detection to chance (0.499). \"\"\"\n",
        "\"\"\"\\u2022 1D projection onto delta: 0.834 AUROC (78% of above-chance unreg-LR signal). \"\"\"\n",
        "\"\"\"\\u2022 Fisher LDA gap (Table 2): raw 1D 0.834 vs L2-LR 0.952 (gap +0.118); shrinkage \"\"\"\n",
        "\"\"\"  LDA (Ledoit-Wolf 2004) reaches 0.920, closing ~73% \\u2014 the rest is covariance- \"\"\"\n",
        "\"\"\"  estimation noise, not non-linearity. ZCA whitening HURTS (0.790). \"\"\"\n",
        "\"\"\"\\u2022 Operational baseline: L2-regularized LR with C=0.001 (Fig.5 optimum). \"\"\"\n",
        "\"\"\"  All heads share one site: (N,d) states + labels -> scores. Each head below \"\"\"\n",
        "\"\"\"  lives in its own single-Impl cell.\"\"\"\n",
        "def class_centroids(X, y):\n",
        "    return X[y == 0].mean(0), X[y == 1].mean(0)\n",
        "\n",
        "def mean_shift_delta(X, y):\n",
        "    mu0, mu1 = class_centroids(X, y)\n",
        "    return mu1 - mu0\n",
        "\n",
        "def remove_mean_shift(X, y):\n",
        "    d = mean_shift_delta(X, y)\n",
        "    d = d / d.norm().clamp_min(1e-12)\n",
        "    return X - (X @ d).unsqueeze(1) * d.unsqueeze(0)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT probe head: l2lr_fit_predict | Paper s3, Tables 1-2-8, Fig.5 | site: (N,d) states + labels -> scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"L2-regularized logistic regression probe (Paper operational baseline, C=0.001).\"\"\"\n",
        "\"\"\"Mean 0.952 AUROC; bounds all 12 alternatives. L2 shrinkage suppresses noise in \"\"\"\n",
        "\"\"\"the residual dims (Fig.5 optimum C=0.001).\"\"\"\n",
        "def l2lr_fit_predict(Xtr, ytr, Xte, C=0.001, steps=2000, lr=0.5):\n",
        "    w = torch.zeros(Xtr.shape[1], dtype=torch.double)\n",
        "    b = torch.zeros((), dtype=torch.double)\n",
        "    lam = 1.0 / (C * len(Xtr))\n",
        "    Xd, yd = Xtr.double(), ytr.double()\n",
        "    for _ in range(steps):\n",
        "        p = torch.sigmoid(Xd @ w + b)\n",
        "        g = p - yd\n",
        "        w -= lr * (Xd.t() @ g / len(Xd) + lam * w)\n",
        "        b -= lr * g.mean()\n",
        "    return torch.sigmoid(Xte.double() @ w + b).float()\n"
      ]
    },
    {
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT probe head: fisherlda_fit_predict | Paper Table 2 Fisher column, App C | site: (N,d) states + labels -> scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Fisher LDA probe (Paper Table 2 Fisher column, App C).\"\"\"\n",
        "\"\"\"Projects onto w_F = Sw^-1 delta. Mean 0.834 1D; gap +0.118 to L2-LR.\"\"\"\n",
        "def fisherlda_fit_predict(Xtr, ytr, Xte, reg=1e-6):\n",
        "    Xd = Xtr.double()\n",
        "    mu0, mu1 = Xd[ytr == 0].mean(0), Xd[ytr == 1].mean(0)\n",
        "    Xc = torch.cat([Xd[ytr == 0] - mu0, Xd[ytr == 1] - mu1])\n",
        "    Sw = (Xc.t() @ Xc) / len(Xc) + reg * torch.eye(Xd.shape[1], dtype=torch.double)\n",
        "    w = torch.linalg.solve(Sw, (mu1 - mu0))\n",
        "    return (Xte.double() @ w).float()\n"
      ]
    },
    {
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT probe head: shrinkagelda_fit_predict | Paper s3.2, closes 73 percent of Fisher gap, 0.920 AUROC | site: (N,d) states + labels -> scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Shrinkage LDA probe (Ledoit-Wolf style, Paper closes 73 percent of Fisher gap).\"\"\"\n",
        "\"\"\"Reaches 0.920 mean AUROC; residual 0.032 may be non-Gaussian structure.\"\"\"\n",
        "def shrinkagelda_fit_predict(Xtr, ytr, Xte, alpha=0.5):\n",
        "    Xd = Xtr.double()\n",
        "    mu0, mu1 = Xd[ytr == 0].mean(0), Xd[ytr == 1].mean(0)\n",
        "    Xc = torch.cat([Xd[ytr == 0] - mu0, Xd[ytr == 1] - mu1])\n",
        "    Sw = (Xc.t() @ Xc) / len(Xc)\n",
        "    tr = Sw.diag().mean()\n",
        "    Sw_s = (1 - alpha) * Sw + alpha * tr * torch.eye(Xd.shape[1], dtype=torch.double)\n",
        "    w = torch.linalg.solve(Sw_s, (mu1 - mu0))\n",
        "    return (Xte.double() @ w).float()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Subspace probes (Paper \\u00a76 Table 16, App L; Table 3 oracle-layer rows).\"\"\"\n",
        "\"\"\"Taxonomy the paper verifies: mean-targeting beats variance-targeting. \"\"\"\n",
        "\"\"\"\\u2022 PLS-DA k=2: 0.910 (mean-targeting, but truncated; full-dim wins by 0.044). \"\"\"\n",
        "\"\"\"  PLS-DA comp.1 aligns with delta by construction in binary case (Barker-Rayens). \"\"\"\n",
        "\"\"\"\\u2022 SVD+LR k=100: 0.929 (variance-targeting, loses mean shift). \"\"\"\n",
        "\"\"\"\\u2022 MeanDiff (Zou et al. 2023 representation-engineering direction): 0.893. \"\"\"\n",
        "\"\"\"\\u2022 gcPCA/KM-Unsup: 0.699/0.765 (variance-targeting, worst). Full-dim L2-LR 0.952.\"\"\"\n",
        "\"\"\"  Each head below lives in its own single-Impl cell.\"\"\"\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT probe head: meandiff_fit_predict | Paper Table 16 (0.893), mean-targeting | site: (N,d) states + labels -> scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"MeanDiff probe (representation-engineering direction, Paper Table 16: 0.893).\"\"\"\n",
        "\"\"\"Score = X dot delta-hat. Mean-targeting; beats all variance methods.\"\"\"\n",
        "def meandiff_fit_predict(Xtr, ytr, Xte):\n",
        "    d = mean_shift_delta(Xtr.double(), ytr)\n",
        "    w = (d / d.norm().clamp_min(1e-12)).float()\n",
        "    return (Xte.float() @ w)\n",
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT probe head: svd_fit_predict, k=100 | Paper Table 16 (0.929), variance-targeting | site: (N,d) states + labels -> scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"SVD+LR probe k=100 (Paper Table 16: 0.929, variance-targeting).\"\"\"\n",
        "\"\"\"Top-k PCA then L2-LR. Loses mean shift; loses to full-dim by 0.023.\"\"\"\n",
        "def svd_fit_predict(Xtr, ytr, Xte, k=100):\n",
        "    mu = Xtr.double().mean(0, keepdim=True)\n",
        "    U, S, Vh = torch.linalg.svd(Xtr.double() - mu, full_matrices=False)\n",
        "    Vk = Vh[:min(k, Vh.shape[0])].t()\n",
        "    return l2lr_fit_predict((Xtr.double() @ Vk).float(), ytr, (Xte.double() @ Vk).float())\n",
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT probe head: plsda_fit_predict, k=2 | Paper Table 16 (0.910), mean-targeting truncated | site: (N,d) states + labels -> scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"PLS-DA probe k=2 (Paper Table 16: 0.910, mean-targeting but truncated).\"\"\"\n",
        "\"\"\"Component 1 aligns with delta by construction (Barker-Rayens 2003).\"\"\"\n",
        "def plsda_fit_predict(Xtr, ytr, Xte, k=2):\n",
        "    Xd = Xtr.double()\n",
        "    yc = (ytr.double() - ytr.double().mean()).unsqueeze(1)\n",
        "    Xc = Xd - Xd.mean(0, keepdim=True)\n",
        "    U, S, Vh = torch.linalg.svd(Xc.t() @ yc, full_matrices=False)\n",
        "    W = Vh[:1].t()\n",
        "    for _ in range(1, min(k, Xd.shape[1])):\n",
        "        T = Xc @ W\n",
        "        P = (Xc.t() @ T) / (T.t() @ T).clamp_min(1e-12)\n",
        "        Xc = Xc - T @ P.t()\n",
        "        U2, S2, Vh2 = torch.linalg.svd(Xc.t() @ yc, full_matrices=False)\n",
        "        W = torch.cat([W, Vh2[:1].t()], dim=1)\n",
        "    return l2lr_fit_predict((Xtr.double() @ W).float(), ytr, (Xte.double() @ W).float())\n",
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT probe head: mlp_fit_predict | Paper s6.3, App I, Table 14, boundary linear | site: (N,d) states + labels -> scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"MLP probe = SAPLMA-style baseline (Paper \\u00a76.3, App I, Table 14).\"\"\"\n",
        "\"\"\"Controlled MLP (256 units, ReLU, dropout 0.3) on the oracle layer differs from \"\"\"\n",
        "\"\"\"L2-LR by |delta|<=0.002 across all 9 conditions (mean both 0.952): the boundary \"\"\"\n",
        "\"\"\"is overwhelmingly LINEAR in the paired-example paradigm, so SAPLMA's 2-layer \"\"\"\n",
        "\"\"\"MLP (0.919, under-regularized) loses to properly regularized L2-LR (0.952).\"\"\"\n",
        "class _SaplmaMlp(torch.nn.Module):\n",
        "    def __init__(self, d, h=256, p=0.3):\n",
        "        super().__init__()\n",
        "        self.net = torch.nn.Sequential(torch.nn.Linear(d, h), torch.nn.ReLU(), torch.nn.Dropout(p), torch.nn.Linear(h, 1))\n",
        "    def forward(self, x):\n",
        "        return self.net(x).squeeze(-1)\n",
        "\n",
        "def mlp_fit_predict(Xtr, ytr, Xte, h=256, epochs=50, lr=1e-3):\n",
        "    m = _SaplmaMlp(Xtr.shape[1], h).float()\n",
        "    opt = torch.optim.Adam(m.parameters(), lr=lr)\n",
        "    loss_fn = torch.nn.BCEWithLogitsLoss()\n",
        "    m.train()\n",
        "    for _ in range(epochs):\n",
        "        opt.zero_grad()\n",
        "        loss_fn(m(Xtr.float()), ytr.float()).backward()\n",
        "        opt.step()\n",
        "    m.eval()\n",
        "    with torch.no_grad():\n",
        "        return torch.sigmoid(m(Xte.float()))\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"LayerMix aggregation (Paper \\u00a74, Algorithm 1; Tables 3/17).\"\"\"\n",
        "\"\"\"Stage 1 SCORING: for each layer l, L2-LR probe via stratified 5-fold CV; score \"\"\"\n",
        "\"\"\"  s_l = mean AUROC. Replaces oracle selection using training data only. \"\"\"\n",
        "\"\"\"Stage 2 SELECTION: L* = top-K layers (default K=5, stable for K in {3,5,7}, \"\"\"\n",
        "\"\"\"  Table 17b diffs <=0.002). Selected layers form a contiguous band (e.g. 16-20 \"\"\"\n",
        "\"\"\"  for Qwen2.5-7B). CV selection is the ONLY strategy matching the oracle; \"\"\"\n",
        "\"\"\"  Cohen's-d ranking picks scattered layers and fails (Table 17a). \"\"\"\n",
        "\"\"\"Stage 3 AGGREGATION: train f_l = LR(H(l), y; C=0.001) per selected layer on the \"\"\"\n",
        "\"\"\"  FULL train set; predict p(x) = (1/K) sum_l f_l(h(l)(x)) (Eq.1). Uniform averaging \"\"\"\n",
        "\"\"\"  = variance reduction without learned weights; dim does not scale with K. \"\"\"\n",
        "\"\"\"  Cost: one forward pass + ~30s scoring (N=5k) + ~5s probe training. \"\"\"\n",
        "\"\"\"Results: 0.954 mean (matches oracle 0.952, beats middle-layer heuristic 0.941 by \"\"\"\n",
        "\"\"\"  0.013 = 15-20% fewer false positives at recall 0.90; beats all-layer avg 0.944 \"\"\"\n",
        "\"\"\"  and CLAP 0.928 in 9/9 conditions). Each rule below lives in its own \"\"\"\n",
        "\"\"\"  single-Impl cell; diagnostics after them are common code.\"\"\"\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT aggregation rule: layermix_predict | Paper Alg.1, 0.954 mean, matches oracle | site: per-layer states + labels -> averaged scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"LayerMix aggregation rule (Paper Alg.1: CV top-K + per-layer L2-LR + average).\"\"\"\n",
        "\"\"\"Mean 0.954, matches oracle without oracle access, cost about 35 seconds.\"\"\"\n",
        "def layermix_predict(layer_states, y, K=5, C=0.001, seed=0):\n",
        "    scores = {}\n",
        "    for li, X in layer_states.items():\n",
        "        m, _ = cv_auroc_for_probe(X, y, lambda a, b, c: l2lr_fit_predict(a, b, c, C=C), k=5, seed=seed)\n",
        "        scores[li] = m\n",
        "    top = sorted(scores, key=scores.get, reverse=True)[:K]\n",
        "    probs = []\n",
        "    for li in top:\n",
        "        X = layer_states[li]\n",
        "        mu, sd = X.mean(0, keepdim=True), X.std(0, keepdim=True).clamp_min(1e-12)\n",
        "        Xn = (X - mu) / sd\n",
        "        w = torch.zeros(Xn.shape[1], dtype=torch.double)\n",
        "        b = torch.zeros((), dtype=torch.double)\n",
        "        lam = 1.0 / (C * len(Xn))\n",
        "        Xd, yd = Xn.double(), y.double()\n",
        "        for _ in range(2000):\n",
        "            p = torch.sigmoid(Xd @ w + b)\n",
        "            g = p - yd\n",
        "            w -= 0.5 * (Xd.t() @ g / len(Xd) + lam * w)\n",
        "            b -= 0.5 * g.mean()\n",
        "        probs.append(torch.sigmoid(Xn.double() @ w + b))\n",
        "    return sum(probs) / len(probs), top, scores\n",
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT aggregation rule: singleoracle_predict | Paper reference 0.952, needs oracle access | site: per-layer states + labels -> best-layer scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Single-oracle aggregation rule (Paper reference: best CV layer only, 0.952).\"\"\"\n",
        "\"\"\"Needs held-out oracle access; LayerMix matches it without that cost.\"\"\"\n",
        "def singleoracle_predict(layer_states, y, C=0.001, seed=0):\n",
        "    best, best_auc = None, -1.0\n",
        "    for li, X in layer_states.items():\n",
        "        m, _ = cv_auroc_for_probe(X, y, lambda a, b, c: l2lr_fit_predict(a, b, c, C=C), k=5, seed=seed)\n",
        "        if m > best_auc:\n",
        "            best, best_auc = li, m\n",
        "    X = layer_states[best]\n",
        "    mu, sd = X.mean(0, keepdim=True), X.std(0, keepdim=True).clamp_min(1e-12)\n",
        "    Xn = (X - mu) / sd\n",
        "    return l2lr_fit_predict(Xn, y, Xn, C=C), [best], {best: best_auc}\n",
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT aggregation rule: alllayeravg_predict | Paper 0.944 naive ensembling | site: per-layer states + labels -> averaged scores | plain codeblock, no Impl tag by design.\n",
        "\"\"\"All-layer-average rule (Paper: 0.944, naive ensembling without selection).\"\"\"\n",
        "\"\"\"Underperforms LayerMix: informed selection adds value beyond averaging.\"\"\"\n",
        "def alllayeravg_predict(layer_states, y, C=0.001):\n",
        "    probs = []\n",
        "    for li, X in layer_states.items():\n",
        "        mu, sd = X.mean(0, keepdim=True), X.std(0, keepdim=True).clamp_min(1e-12)\n",
        "        Xn = (X - mu) / sd\n",
        "        probs.append(l2lr_fit_predict(Xn, y, Xn, C=C))\n",
        "    return sum(probs) / len(probs), sorted(layer_states), {}\n",
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Diagnostics on frozen states (common code, Paper protocol checks).\"\"\"\n",
        "\"\"\"Length-confound check (Paper \\u00a75): word-length-only AUROC must sit far below \"\"\"\n",
        "\"\"\"probe AUROC (TQA 0.546, HE 0.610, FD 0.511; probes exceed it by >=0.34), ruling \"\"\"\n",
        "\"\"\"out length shortcuts. Intervention sweep (\\u00a77 Fig.4, App R): h' = h + alpha*delta-hat; \"\"\"\n",
        "\"\"\"positive alpha projects away from hallucination direction (MC1 rises), negative \"\"\"\n",
        "\"\"\"reinforces it; random directions show no trend.\"\"\"\n",
        "def length_only_auroc(pairs, y):\n",
        "    lens = torch.tensor([len((q + a).split()) for q, a, _ in [(p[0], p[1], None) for p in pairs] for a in [p[1]]] + [len((p[0] + p[2]).split()) for p in pairs], dtype=torch.double)\n",
        "    return auroc_score(y, lens[: len(y)])\n",
        "\n",
        "def intervention_sweep_alpha(X, y, alphas=(-2, -1.5, -1, -0.5, 0, 0.5, 1, 1.5, 2)):\n",
        "    d = mean_shift_delta(X.double(), y)\n",
        "    dhat = (d / d.norm().clamp_min(1e-12)).float()\n",
        "    mu, sd = X.mean(0, keepdim=True), X.std(0, keepdim=True).clamp_min(1e-12)\n",
        "    Xn = ((X - mu) / sd).float()\n",
        "    w = (mean_shift_delta(Xn.double(), y).float())\n",
        "    w = w / w.norm().clamp_min(1e-12)\n",
        "    return {float(a): (Xn + float(a) * dhat.unsqueeze(0)) @ w for a in alphas}\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Compatibility: The Hallucination Signal Is a Mean Shift (Lee, Seo, Lim 2026, arXiv:2608.28930)",
        "",
        "- **STACK:** probe heads + extractor + checkpoint loop + Corrupt eval sets + SABER branch scoring; any Vocab/Scale/Context model underneath (probes read states, never weights). Effect-size vs CV-uniform LayerMix may both score the same run.",
        "- **ALTERNATIVE (pick 1):** one probe head per decision; one aggregation rule (layermix | singleoracle | alllayeravg); PDF-text vs repo-faithful LayerMix per run (§12 documents both); PLS truncation k per run.",
        "- **NEVER-SAME-PATH:** none among model axes (audited). Methodological bans (not compile paths): never read PLS-DA k=2 subspace numbers as full-signal numbers (underperforms full-dim by construction, Table 16); never transfer paired-example directions to free-form generation (paper's own pilot: collapses to 0.477).",
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Backprop: LayerMix (arXiv:2608.28930, s10-12) x later papers up to 2609.04463 (additive back-links; no prior line touched)\n",
        "\n",
        "- **Paper 11 hands LayerMix a second label for the identical probe machinery.** L2-LR, stratified 5-fold CV, last-token states: hallucination-vs-factual (s10) and arithmetic-correctness (s23) probes train side-by-side on the same frozen states with no new data plumbing - a joint probe panel is implementable today.\n",
        "- **Circuit loading appends as one scalar feature to every probe head** (l2lr/fisherlda/shrinkage/meandiff/svd/plsda/mlp). Paper 11's s3.4-vs-controls question is the same statistical question s10 answers the same way (unique variance beyond controls); the verbal-arithmetic items are a new paired-eval family for the Corrupt sets - format brittleness (right answer, wrong circuit) is hallucination-adjacent.\n",
        "- **How LayerMix fares into future dev:** mean-shift direction x circuit loading is the natural two-feature detector (direction + engagement), but Fig.3C's entropy-rise forces loading-conditioned calibration, or confident-wrong verbal items slip through. Risk to record: loading needs a trained anchor task; mean-shift does not - the two features have different data requirements.\n",
        "\n",
        "Ref-graph line (independent citation check, does not touch the content lines above): paper 11 shares ZERO references with LayerMix (42 refs scanned: probe/hallucination literature - Hewitt 2019, Marks 2023, Zou 2023, Azaria 2023, Kadavath 2022 - none among paper 11's 35 S2 references; paper 11's App D cites no probe literature at all, only Gromping 2006). The L2-LR + CV resemblance is CONVERGENT, not inherited - the graph forces that honest reading. Author bridge (second-order only): Jacob Andreas co-authors Hernandez et al. 2023 (in LayerMix refs) and senior-authors paper 11. Adaptable missing edge: paper 11 never runs Hewitt-style selectivity controls on its correctness setup - directly addable.\n",
        "\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 11. Scale-Up Axes \u2013 Vocab, Model Scale, Context (for meaningful LayerMix results)",
        "",
        "The §10 pipeline runs on char-64 / tiny-64 by default, where geometry is weak and LayerMix over 3 layers is degenerate. This section adds three independent OPTAL axes (all additive; every Impl keeps its own single-tag cell):",
        "",
        "- **Vocab**: char64 (repo default, any English encodable) vs word1k/10k/20k/40k/50k top-K word vocabs with `<unk>` (need a bigger corpus: OpenWebText/TinyStories chunks, streamed once then cached). Bigger vocabs shorten sequences ~4-5x, which is what makes QA pairs fittable.",
        "- **Scale**: tiny64 (64/3L/4H, sanity baseline) vs small256 (256/8L/8H) vs faithful512 (512/12L/8H, paper-like band geometry with room for a top-5). Config-only; retrain required.",
        "- **Context**: ctx64 (10 words, truncates pairs) vs ctx256 (~40 words, short QA fits) vs ctx512 (full pairs with head+tail packing) vs ctx1024 (~150 words, small multi-hop fits) vs ctx2048 (single-pass ceiling; needs small batches past 1024). New position table; retrain required.",
        "- **Corrupt**: corpus-mined hallucination operators (entityswap / negationflip / randomsplice) that manufacture labeled paired data offline from the training corpus itself. Plain always-present codeblocks like the probes (bundle rule); one hallucination type each.",
        "- **Checkpoint + inference probing** (common code at the end): probe geometry DURING training (curve of AUROC vs step) and score live generations at inference."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Multi-scale corpus loader (common code; feeds all Vocab Impls).\"\"\"\n",
        "\"\"\"tiny_shakespeare.txt ships with the repo. Word vocabs need more text: stream \"\"\"\n",
        "\"\"\"an OpenWebText/TinyStories chunk once via HF datasets (cached to data/), \"\"\"\n",
        "\"\"\"else fall back to repeated Shakespeare when offline. No model logic touched.\"\"\"\n",
        "def load_corpus_chunks(source=\"shakespeare\", max_chars=2000000):\n",
        "    from pathlib import Path as _P\n",
        "    if source == \"shakespeare\":\n",
        "        with open(_P.cwd() / \"data\" / \"tiny_shakespeare.txt\") as f:\n",
        "            return f.read()\n",
        "    cache = _P.cwd() / \"data\" / \"corpus_cache\" / f\"{source}.txt\"\n",
        "    if cache.exists():\n",
        "        return cache.read_text(encoding=\"utf-8\")[:max_chars]\n",
        "    try:\n",
        "        from datasets import load_dataset as _ld\n",
        "        repo = {\"openweb-chunk\": \"Skylion007/openwebtext\", \"tinystories\": \"roneneldan/TinyStories\"}[source]\n",
        "        ds = _ld(repo, split=\"train\", streaming=True)\n",
        "        buf, total = [], 0\n",
        "        for row in ds:\n",
        "            t = row.get(\"text\", \"\")\n",
        "            buf.append(t)\n",
        "            total += len(t)\n",
        "            if total >= max_chars:\n",
        "                break\n",
        "        text = \"\\n\".join(buf)[:max_chars]\n",
        "        cache.parent.mkdir(parents=True, exist_ok=True)\n",
        "        cache.write_text(text, encoding=\"utf-8\")\n",
        "        return text\n",
        "    except Exception as e:\n",
        "        print(f\"  corpus load failed ({e}); falling back to Shakespeare.\")\n",
        "        with open(_P.cwd() / \"data\" / \"tiny_shakespeare.txt\") as f:\n",
        "            return f.read()\n"
      ]
    },
    @Impl::Vocab::char64{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Char vocab (~64 symbols, repo default). Same site as the word vocabs below: \"\"\"\n",
        "\"\"\"sets vocab_sz + token_to_int/int_to_token/encode/decode. Any English text is \"\"\"\n",
        "\"\"\"encodable; sequences run ~4-5x longer than word tokens (hence Context axis).\"\"\"\n",
        "tokens = sorted(set(text))\n",
        "vocab_sz = len(tokens)\n",
        "token_to_int = {t: i for i, t in enumerate(tokens)}\n",
        "int_to_token = {i: t for t, i in token_to_int.items()}\n",
        "encode = lambda s: [token_to_int.get(c, 0) for c in s]\n",
        "decode = lambda ids: \"\".join([int_to_token[i] for i in ids])\n",
        "print(f\"char64 {vocab_sz=}\")\n"
      ]
    }
    }@},
    @Impl::Vocab::word1k{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Word vocab top-1000 + <unk>/<pad> (needs openweb-chunk/tinystories corpus).\"\"\"\n",
        "\"\"\"Smallest step beyond chars: embedding table ~1002 x emb_dim, sequences ~4x shorter.\"\"\"\n",
        "import re as _re\n",
        "from collections import Counter as _Counter\n",
        "_words = _re.findall(r\"[A-Za-z']+\", text.lower())\n",
        "_top = [w for w, _ in _Counter(_words).most_common(1000)]\n",
        "tokens = [\"<pad>\", \"<unk>\"] + _top\n",
        "vocab_sz = len(tokens)\n",
        "token_to_int = {t: i for i, t in enumerate(tokens)}\n",
        "int_to_token = {i: t for t, i in token_to_int.items()}\n",
        "encode = lambda s: [token_to_int.get(w, 1) for w in _re.findall(r\"[A-Za-z']+\", s.lower())]\n",
        "decode = lambda ids: \" \".join([int_to_token[i] for i in ids])\n",
        "print(f\"word1k {vocab_sz=}\")\n"
      ]
    }
    }@},
