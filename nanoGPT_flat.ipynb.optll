    }@}
    @Impl::Scale::gpt2_124m{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Scale gpt2_124m (emb 768, 12 layers, 12 heads, ~124M). Same class, same \"\"\"\n",
        "\"\"\"block layout - just the dims the external suites (\u00a728) ask for. Purely a \"\"\"\n",
        "\"\"\"size parameterization: instantiated with the repo's own init and trained by \"\"\"\n",
        "\"\"\"\u00a79 on the in-repo corpus, like every other scale. (The verified \"\"\"\n",
        "\"\"\"openai-community/gpt2 tensor mapping lives in nanogpt_pipeline.py only, for \"\"\"\n",
        "\"\"\"deferred ablation work - this notebook never loads external chains.)\"\"\"\n",
        "class gpt2_faithful_Head(nn.Module):\n",
        "    \"\"\"GPT-2 keeps biases on the q/k/v Linears (the repo Head is bias=False);\n",
        "    late-binding this name gives this scale a faithful attention\n",
        "    parameterization with identical attention math (checkpoint-agnostic).\"\"\"\n",
        "\n",
        "    def __init__(self, head_sz, emb_dim):\n",
        "        super().__init__()\n",
        "        self.head_sz, self.emb_dim = head_sz, emb_dim\n",
        "        self.key = QKVLinear(emb_dim, head_sz)\n",
        "        self.query = QKVLinear(emb_dim, head_sz)\n",
        "        self.value = QKVLinear(emb_dim, head_sz)\n",
        "        self.register_buffer(\"tril\", torch.tril(torch.ones(ctx_len, ctx_len)))\n",
        "\n",
        "    def forward(self, x, kv=None):\n",
        "        B, T, C = x.shape\n",
        "        q = self.query(x)\n",
        "        k = self.key(x)\n",
        "        v = self.value(x)\n",
        "        if kv is not None:\n",
        "            k, v = kv\n",
        "        wei = attn_scores(q, k) * (self.head_sz ** -0.5)\n",
        "        wei = wei.masked_fill(self.tril[:T, :T] == 0, float(\"-inf\"))\n",
        "        wei = F.softmax(wei, dim=-1)\n",
        "        return attn_combine(wei, v)\n",
        "\n",
        "Head = gpt2_faithful_Head\n",
        "SCALE = {\"emb_dim\": 768, \"n_layers\": 12, \"n_heads\": 12}\n",
        "model = NanoGPT(vocab_sz, SCALE[\"emb_dim\"], ctx_len, SCALE[\"n_layers\"], SCALE[\"n_heads\"]).to(device)\n",
        "n_params_tot = sum(p.numel() for p in model.parameters())\n",
        "print(f\"gpt2_124m {n_params_tot / 1e6:.2f} M parameters\")\n",
        "_model_provenance = \"self-trained via \u00a79 for the selected path; no external checkpoint loaded\"\n",
        "print(_model_provenance)\n"
      ]
    },
    }@}
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"reseat_ctx: change a compiled model's context length at the parameterization\"\"\"\n",
        "\"\"\"level - rebuilds the position table AND every causal-mask buffer that was \"\"\"\n",
        "\"\"\"sized from ctx_len at instantiation (the repo Head, MultiHead variants and \"\"\"\n",
        "\"\"\"gpt2_faithful_Head each register their own tril). Without it, a context \"\"\"\n",
        "\"\"\"larger than the instantiated one breaks on masked_fill shape mismatch.\"\"\"\n",
        "def reseat_ctx(model, new_len):\n",
        "    dev = next(model.parameters()).device\n",
        "    emb = model.token_embedding.weight.shape[1]\n",
        "    model.position_embedding = torch.nn.Embedding(new_len, emb).to(dev)\n",
        "    model.ctx_len = new_len\n",
        "    rebuilt = 0\n",
        "    for m in model.modules():\n",
        "        if isinstance(getattr(m, \"tril\", None), torch.Tensor):\n",
        "            m.tril = torch.tril(torch.ones(new_len, new_len, device=dev))\n",
        "            rebuilt += 1\n",
        "    print(f\"reseat_ctx {new_len}: position table + {rebuilt} causal mask(s)\")\n"
      ]
    },
    @Impl::Context::ctx64{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Context 64 (repo default, ~10 words). QA pairs truncate to answer tails; paired \"\"\"\n",
        "\"\"\"probing still runs (same pipeline) but length-confound risk is highest here.\"\"\"\n",
        "ctx_len = 64\n",
        "model.ctx_len = ctx_len\n",
        "print(f\"ctx64 {ctx_len=}\")\n"
      ]
    },
    }@}
    @Impl::Context::ctx256{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Context 256 (~40 words): short QA pairs fit whole. New position table, so this \"\"\"\n",
        "\"\"\"Impl re-seats position_embedding then requires retraining (no logic change).\"\"\"\n",
        "ctx_len = 256\n",
        "reseat_ctx(model, ctx_len)\n",
        "print(f\"ctx256 {ctx_len=}\")\n"
      ]
    },
    }@}
    @Impl::Context::ctx512{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"Context 512 (full pairs with head+tail packing: keep question head, answer tail).\"\"\"\n",
        "\"\"\"Same re-seat + retrain recipe as ctx256. Use with word vocabs (char-512 is short).\"\"\"\n",
        "ctx_len = 512\n",
        "reseat_ctx(model, ctx_len)\n",
        "print(f\"ctx512 {ctx_len=}\")\n",
        "def pack_pair_ids(q_ids, a_ids, ctx_len):\n",
        "    keep_q = max(0, ctx_len - len(a_ids))\n",
        "    return (q_ids[:keep_q] + a_ids)[-ctx_len:]\n"
      ]
    },
    }@}
