      "outputs": [],
      "source": [
        "\"\"\"Context 512 (full pairs with head+tail packing: keep question head, answer tail).\"\"\"\n",
        "\"\"\"Same re-seat + retrain recipe as ctx256. Use with word vocabs (char-512 is short).\"\"\"\n",
        "ctx_len = 512\n",
        "model.position_embedding = torch.nn.Embedding(ctx_len, model.token_embedding.weight.shape[1]).to(device)\n",
        "model.ctx_len = ctx_len\n",
        "print(f\"ctx512 {ctx_len=}\")\n",
        "def pack_pair_ids(q_ids, a_ids, ctx_len):\n",
        "    keep_q = max(0, ctx_len - len(a_ids))\n",
        "    return (q_ids[:keep_q] + a_ids)[-ctx_len:]\n"
      ]
