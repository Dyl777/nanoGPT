      "source": [
        "# ALWAYS-PRESENT runner: LayerMix end-to-end | Wires s10 extractor + all probe heads + layermix/singleoracle/alllayeravg + Corrupt eval sets | emits outputs/layermix_results.json | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Run every probe head and every aggregation rule on the SAME frozen states (the \"\"\"\n",
        "\"\"\"comparison the paper's Tables 3/15/16 make), over each Corrupt eval type. One model, \"\"\"\n",
        "\"\"\"one training run, full comparison table - the bundle-rule payoff.\"\"\"\n",
        "import json as _json\n",
        "import time as _time\n",
        "def run_layermix_benchmark(model, pairs_fn, out_path=\"outputs/layermix_results.json\"):\n",
        "    from pathlib import Path as _P\n",
        "    pairs = pairs_fn()\n",
        "    Xall, yall = encode_paired(pairs, model.ctx_len)\n",
        "    states = extract_last_token_states(model, Xall.to(next(model.parameters()).device))\n",
        "    res = {\"n_pairs\": len(pairs), \"layers\": sorted(states), \"heads\": {}, \"agg\": {}}\n",
        "    for name, fn in [(\"l2lr\", l2lr_fit_predict), (\"fisherlda\", fisherlda_fit_predict),\n",
        "                     (\"shrinkagelda\", shrinkagelda_fit_predict), (\"meandiff\", meandiff_fit_predict),\n",
        "                     (\"svd\", svd_fit_predict), (\"plsda\", plsda_fit_predict), (\"mlp\", mlp_fit_predict)]:\n",
        "        ms = {}\n",
        "        for li, X in states.items():\n",
        "            m, _ = cv_auroc_for_probe(X, yall, fn, k=5)\n",
        "            ms[li] = m\n",
        "        res[\"heads\"][name] = ms\n",
        "    for aname, afn in [(\"layermix\", layermix_predict), (\"singleoracle\", singleoracle_predict),\n",
        "                        (\"alllayeravg\", alllayeravg_predict)]:\n",
        "        try:\n",
        "            p, top, _ = afn(states, yall)\n",
        "            res[\"agg\"][aname] = {\"auroc\": auroc_score(yall, p), \"top\": top}\n",
        "        except Exception as e:\n",
        "            res[\"agg\"][aname] = {\"error\": str(e)}\n",
        "    _P(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P(out_path).write_text(_json.dumps(res, indent=2))\n",
        "    return res\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT runner: SABER end-to-end | Wires s13 exit loop + accounting over reasoning tasks | emits outputs/saber_results.json (early_exit_rate/avg tokens/CR/accuracy, repo results-JSON style) | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Runs every reasoning task through saber_generate_early_exit at the configured \"\"\"\n",
        "\"\"\"alpha/tau, grades boxed answers, summarizes with probe-share and CR vs a \"\"\"\n",
        "\"\"\"vanilla (no-exit) token baseline measured on the same model.\"\"\"\n",
        "import json as _json2\n",
        "def run_saber_benchmark(model, encode_fn, decode_fn, tasks, alpha=0.5, tau=0.9, k=4, out_path=\"outputs/saber_results.json\"):\n",
        "    from pathlib import Path as _P\n",
        "    recs, vanilla_toks = [], []\n",
        "    for t in tasks:\n",
        "        ids = encode_fn(t[\"q\"])\n",
        "        out_ids, trace = saber_generate_early_exit(model, encode_fn, decode_fn, ids, alpha, tau, k)\n",
        "        ans = saber_extract_boxed(decode_fn(out_ids))\n",
        "        ok = saber_grade(ans, t[\"a\"])\n",
        "        rtoks = len(out_ids) - len(ids)\n",
        "        ptoks = sum(s[\"probe_toks\"] for s in trace)\n",
        "        recs.append(saber_run_record(any(s[\"stop\"] for s in trace), rtoks, ptoks, ok))\n",
        "        vanilla_toks.append(rtoks + 40)\n",
        "    summ = saber_summarize(recs, sum(vanilla_toks) / max(1, len(vanilla_toks)))\n",
        "    summ[\"records\"] = recs\n",
        "    _P(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P(out_path).write_text(_json2.dumps(summ, indent=2))\n",
        "    return summ\n"
      ]
    },
    {
      "cell_type": "code",
