      "outputs": [],
      "source": [
        "\"\"\"Word vocab top-50000 + <unk>/<pad>. Max feasible here (GPT-2 order); use with \"\"\"\n",
        "\"\"\"faithful512 + ctx512 for the closest-to-paper nanoGPT recreation.\"\"\"\n",
        "import re as _re\n",
        "from collections import Counter as _Counter\n",
        "_words = _re.findall(r\"[A-Za-z']+\", text.lower())\n",
        "_top = [w for w, _ in _Counter(_words).most_common(50000)]\n",
        "tokens = [\"<pad>\", \"<unk>\"] + _top\n",
        "vocab_sz = len(tokens)\n",
        "token_to_int = {t: i for i, t in enumerate(tokens)}\n",
        "int_to_token = {i: t for t, i in token_to_int.items()}\n",
        "encode = lambda s: [token_to_int.get(w, 1) for w in _re.findall(r\"[A-Za-z']+\", s.lower())]\n",
        "decode = lambda ids: \" \".join([int_to_token[i] for i in ids])\n",
        "print(f\"word50k {vocab_sz=}\")\n"
      ]
    },
    }@}
    @Impl::Vocab::gpt2bpe{
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "\"\"\"GPT-2 BPE vocab (50257 merges, tiktoken). Same site as the char/word vocabs:\n",
        "\"\"\"sets vocab_sz + encode/decode (+ empty int_to_token since ids are not\n",
        "\"\"\"enumerable). The vocab the external suites (§28) need: tiktoken ids map the\n",
        "\"\"\"50257-wide embedding table 1:1, so likelihood scoring and greedy decoding of\n",
        "\"\"\"real MMLU/GSM8K/MBPP-style text works with the gpt2bpe Vocab selection.\"\"\"\n",
        "import tiktoken as _tiktoken\n",
        "_bpe = _tiktoken.get_encoding(\"gpt2\")\n",
        "vocab_sz = _bpe.n_vocab\n",
        "token_to_int = {}\n",
        "int_to_token = {}\n",
        "encode = lambda s: list(_bpe.encode(s, allowed_special=set()))\n",
        "decode = lambda ids: _bpe.decode([int(i) for i in ids if 0 <= int(i) < vocab_sz])\n",
        "print(f\"gpt2bpe {vocab_sz=}\")\n"
      ]
    },
    }@}
    @Impl::Scale::tiny64{
