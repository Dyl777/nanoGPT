      "source": [
        "# ALWAYS-PRESENT runner: shared-circuits end-to-end | Wires s23 cells B-H: exposure training, Fig.2/3 accuracy+loading, Jaccard ordering, App C patch, App D probes+LMG, Table 1 + Fig.6 balanced design | emits outputs/sharedcircuits_results.json | plain codeblock, no Impl tag by design.\n",
        "def run_sharedcircuits_benchmark(make_model_fn, n_train=900, n_eval=240, ctx_len=256,\n",
        "                                 train_weights=(0.75, 0.25, 0.0, 0.0), steps=1200,\n",
        "                                 batch=64, eta=3e-3, seed=0,\n",
        "                                 out_path=\"outputs/sharedcircuits_results.json\"):\n",
        "    \"\"\"End-to-end claim test. Training exposure defaults to numeric-majority + \"\"\"\n",
        "    \"\"\"English-minority (the controlled analogue of pretraining exposure); Spanish and \"\"\"\n",
        "    \"\"\"Italian are unseen. Asserts the MECHANISM (ordering + loading signal), not paper \"\"\"\n",
        "    \"\"\"magnitudes: nanoGPT scale cannot reproduce 13-model statistics.\"\"\"\n",
        "    import json as _j\n",
        "    import time as _t\n",
        "    from pathlib import Path as _P\n",
        "    t0 = _t.time()\n",
        "    train_items = sc_gen_items(n_train, seed)\n",
        "    eval_items = sc_gen_items(n_eval, seed + 999)\n",
        "    ex_item = sc_gen_items(1, seed + 31337)[0]\n",
        "    built_tr, built_ev = {}, {}\n",
        "    for f in SC_FMT:\n",
        "        built_tr[f] = sc_build_rows(train_items, f, ex_item, ctx_len)\n",
        "        built_ev[f] = sc_build_rows(eval_items, f, ex_item, ctx_len)\n",
        "    unk = sum(b[\"n_unknown_chars\"] for b in list(built_tr.values()) + list(built_ev.values()))\n",
        "    assert unk == 0, \"vocab-unsafe chars in renderers (see s23 Cell A adaptation 1)\"\n",
        "    model = make_model_fn()\n",
        "    pool = sc_pool_from_built([built_tr[f] for f in SC_FMT], train_weights)\n",
        "    tr = sc_train_exposure(model, pool, steps=steps, batch=batch, eta=eta, seed=seed)\n",
        "    acc = {f: sc_answer_em(model, built_ev[f][\"rows\"]) for f in SC_FMT}\n",
        "    atts_num = []\n",
        "    for r in built_ev[\"numeric\"][\"rows\"]:\n",
        "        a = sc_attrib_item(model, r)\n",
        "        if a is not None:\n",
        "            atts_num.append(a[\"attrib\"])\n",
        "    if not atts_num:\n",
        "        res = {\"paper\": \"arXiv:2609.04463\", \"seed\": seed, \"feasible\": False,\n",
        "               \"reason\": (\"no attributions kept on the numeric anchor (every item \"\n",
        "               \"dropped by the identical-output or zero-margin filter; train longer.\"),\n",
        "               \"accuracy\": acc, \"seconds\": round(_t.time() - t0, 1)}\n",
        "        _P(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "        _P(out_path).write_text(_j.dumps(res, indent=2, default=str), encoding=\"utf-8\")\n",
        "        print(_j.dumps(res, indent=2))\n",
        "        return res\n",
        "    S, k = sc_topk(sc_aggregate(atts_num), 1.0)\n",
        "    per_fmt = [sc_run_format(model, built_ev[f], S) for f in SC_FMT]\n",
        "    Agg = {}\n",
        "    for f in SC_FMT:\n",
        "        aa = []\n",
        "        for r in built_ev[f][\"rows\"]:\n",
        "            a = sc_attrib_item(model, r)\n",
        "            if a is not None:\n",
        "                aa.append(a[\"attrib\"])\n",
        "        Agg[f] = sc_aggregate(aa) if aa else None\n",
        "    jac = {f: (sc_jaccard(Agg[f], Agg[\"numeric\"]) if Agg[f] is not None else None)\n",
        "           for f in (\"english\", \"spanish\", \"italian\")}\n",
        "    causal = [sc_run_causal(model, built_ev[f], S) for f in SC_FMT]\n",
        "    appD = [sc_run_appD(model, built_ev[f], S) for f in SC_FMT]\n",
        "    t1 = sc_table1_live(model, built_ev, seed=seed)\n",
        "    mx = sc_cross_matrix_live(model, built_ev, seed=seed)\n",
        "    plot = sc_plot_main(per_fmt, out_prefix=\"outputs/sc_live\")\n",
        "    res = {\"paper\": \"arXiv:2609.04463\", \"seed\": seed, \"feasible\": True, \"steps\": steps,\n",
        "           \"train_weights\": train_weights, \"ctx_len\": ctx_len,\n",
        "           \"n_unknown_chars\": unk, \"circuit_k\": k,\n",
        "           \"accuracy\": acc,\n",
        "           \"ordering_numeric_ge_english_ge_spanish_ge_italian\": bool(\n",
        "               acc[\"numeric\"] >= acc[\"english\"] >= acc[\"spanish\"] >= acc[\"italian\"]),\n",
        "           \"jaccard_vs_numeric\": jac,\n",
        "           \"jaccard_ordering_en_ge_es_ge_it\": bool(\n",
        "               (jac[\"english\"] or -1) >= (jac[\"spanish\"] or -1) >= (jac[\"italian\"] or -1)),\n",
        "           \"point_biserial\": {d[\"fmt\"]: {\"r\": d[\"r\"], \"p\": d[\"p\"], \"n\": d[\"n\"],\n",
        "                                                 \"n_correct\": d[\"n_correct\"]} for d in per_fmt},\n",
        "           \"causal\": causal, \"appD\": [\n",
        "               {\"fmt\": a[\"fmt\"], \"auc_resid_best\": max(a[\"auc_resid\"]),\n",
        "                \"auc_mlp_best\": max(a[\"auc_mlp\"]), \"lmg\": a[\"lmg\"], \"n\": a[\"n\"]}\n",
        "               for a in appD],\n",
        "           \"table1\": t1, \"cross_matrix\": mx[\"matrix\"],\n",
        "           \"cross_feasible\": mx[\"feasible\"], \"plot\": plot,\n",
        "           \"seconds\": round(_t.time() - t0, 1)}\n",
        "    _P(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P(out_path).write_text(_j.dumps(res, indent=2, default=str), encoding=\"utf-8\")\n",
        "    print(_j.dumps({kk: res[kk] for kk in (\"accuracy\", \"jaccard_vs_numeric\",\n",
        "                                            \"ordering_numeric_ge_english_ge_spanish_ge_italian\",\n",
        "                                            \"jaccard_ordering_en_ge_es_ge_it\")}, indent=2))\n",
        "    return res\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Compatibility: Shared circuits predict whether LLMs generalize across formats in arithmetic reasoning (de Varda, Pandey, Han, Andreas, Fedorenko 2026, arXiv:2609.04463)\n",
        "\n",
        "- **STACK:** AP hooks + probes + LMG read frozen states on any live path (matmul/addernet, layernorm/regularisedbn, decoder/encdec, all Attn impls - the `ffwd.net[2]` site exists in both FeedForward variants); circuit loading as a LayerMix probe-head feature (s3.4-vs-s10 same 5-fold L2-LR machinery, different label); loading + SABER RSS/CS as joint stability readouts (mechanism vs confidence, same last-token site); loading tracked over grokking clocks (s16) as a regime-shift signal; AP re-run on WRP-pruned checkpoints (does S_m survive block removal); prefix-steered states (s21) still carry loadings; lam (s22) + loading as joint readout features (prior vs arithmetic-circuit engagement).\n",
        "- **ALTERNATIVE (pick 1 per run):** anchor format for S (numeric default; any of the 4 looped, never pathed); exposure mix (numeric-only vs numeric+English vs full - changes the asymmetry, document it); Jaccard (paper) vs intersection/k (base repo) for overlap - report which; S_all vs S_correct vs S_incorrect per Table-1 question.\n",
        "- **NEVER-SAME-PATH:** loadings compared across different S_m definitions (always divide by the defining aggregate's own top-1%); verbal accuracy cited without the >=30-correct rule check; small-runner magnitudes presented as paper-magnitude evidence (mechanism only at this scale); out-of-vocab renderer chars silently collapsing to newline (the s16 failure mode - s23 asserts zero unknowns).\n",
        "\n",
        "### Relations: SharedCircuits (arXiv:2609.04463) x All Previous Papers (standing rule)\n",
        "\n",
        "- **vs LayerMix (arXiv:2608.28930, s10-12): STACK (expected, high value).** Same probe machinery (L2-LR, stratified 5-fold CV, last-token states) with different labels (hallucination vs arithmetic correctness); LayerMix heads and correctness probes can train side-by-side on the same frozen states, and circuit loading appends as one more probe feature. Untested combo, flagged as priority.\n",
        "- **vs SABER (arXiv:2608.27963, s13): STACK (expected).** Both use Jaccard-family similarity (SC multiset-Jaccard on answers vs top-1% Jaccard on units) and both read stability at decision points; loading (does the model use the arithmetic circuit) complements RSS/CS (does its answer stay stable). Joint readout untested.\n",
        "- **vs Grokking (arXiv:2609.10657, s14/s16): STACK (expected, highest value).** s16 trains the transformer on arithmetic; s23 localizes arithmetic circuits in it. The paper's s7 open question (attention-architecture grokking) and s23's anchor design meet here: run AP at Tmem vs Tgrok checkpoints to test whether the numeric circuit IS the grokked solution. Untested combo, flagged as priority.\n",
        "- **vs ConvMem (arXiv:2609.10441, s15): NONE (expected).** Long-context scaffolding vs format-generalization circuits; the only shared surface is arithmetic-flavored evaluation (NIAH needles vs arithmetic items). No shared code path.\n",
        "- **vs RiLM (arXiv:2609.10305, s19): STACK (expected).** GeodesicHead changes the readout geometry that AP's logits flow through; re-running S_m under geodesicflat tests whether the arithmetic circuit survives the head swap. Norm-band geometry (Fig.3 RiLM) and loading-accuracy curves (Fig.3 here) are the same plot shape on different objects. Untested.\n",
        "- **vs WRP (arXiv:2609.09883, s20): STACK (expected).** Pruning removes whole blocks; AP localizes units. Re-running the S_m pipeline on WRP-pruned checkpoints measures whether the arithmetic circuit is cut or spared - the causal complement to WRP's recovery-free eval. No shared removal site (units vs blocks), so no Prune-technique interaction today.\n",
        "- **vs TASCO (arXiv:2609.11393, s21): STACK (expected).** Prefix optimization steers the same forward pass AP reads; loadings under RP/SAP prefixes test whether stability-aware adaptation re-engages the numeric circuit on verbal items - the direct mechanism test of TASCO's transfer claim. Untested.\n",
        "- **vs Ignorance (arXiv:2609.02959, s22): STACK (expected).** lam (prior loading) and circuit loading are the two scalar readouts of 'what the model leans on': high-lam + low-loading = confident ignorance on verbal arithmetic, the precise joint prediction both papers imply. Joint feature untested.\n",
        "- **vs Attention (arXiv:1706.03762) + BERT (arXiv:1810.04805, graded-only): NONE.** Reads whatever backbone path is live; verbal formats need no new attention math.\n",
        "\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 24. Citation Graph \\u2013 references of the current and all prior papers (independent check; additive, touches nothing above)\n",
        "\n",
        "What was built and how (honesty first): paper 11's out-edges come from the Semantic Scholar API (35 references, 0 issues/PRs reviewable anywhere); papers 1-10's out-edges were extracted PDF-locally (arXiv PDFs + pymupdf, `HEAD = Surname(,|and) ... YEAR.` scan with context audit, arXiv-ID regex over refs blocks) after S2/OpenAlex throttled - evidence kept at `refgraph.json` plus term/name scans. CONFIRMED in-repo edges: BERT cites Attention (Vaswani 2017, in refs); RiLM cites Attention ([2] Vaswani et al.). CONFIRMED absences: no 2026 in-repo paper cites any other in-repo paper (no in-repo arXiv IDs in any refs block; no de Varda/Fedorenko/Pandey-as-Sana/Kataria hits); papers 3-10 do not cite BERT or Attention except RiLM (no Vaswani/Devlin hits elsewhere). Paper 11 cites NONE of papers 1-10. Head counts are lower bounds (numbered/IEEE styles under-split); every load-bearing claim below was verified by reading the matched context, and same-surname-different-work traps are called out explicitly (Mingjie Sun vs Alan Sun; Nanda-grokking vs Nanda-AP; Pandey-Llama vs Pandey-Sana; Andreas-Krause vs Andreas-Jacob; Marr-vs-'Marry Me a Little').\n",
        "\n",
        "Headline result: paper 11's method ancestors (attribution patching Nanda/Syed, circuit stability Sun-2025, cross-lingual circuits Ferrando/Wendler, LMG Gromping, arithmetic circuits Hanna/Stolfo-2023) are DISJOINT from every in-repo paper's refs except via second-order author bridges. The content interconnections in s23-Relations and the backprop (A) paragraphs were written from paper texts WITHOUT this graph; the (B) ref lines are the independent second opinion - where both agree (e.g., grokking x circuits), the bridge is load-bearing; where the graph says NONE (e.g., ConvMem), the content NONE is corroborated rather than assumed.\n",
        "\n",
        "Ref-graph lines for the two papers with no notebook section (their content relations already live in s23):\n",
        "\n",
        "ATTENTION: Ref-graph line: Attention (2017) is cited by BERT and by RiLM ([2] Vaswani et al.); it cites nothing in-repo (predates everything). Paper 11 never cites it - the field's implicit-foundation pattern: the architecture is assumed, not referenced. Noted, not fixed.\n",
        "\n",
        "BERT: Ref-graph line: BERT cites Attention (Vaswani 2017, verified in refs); cited by none in-repo; graded-only. No edge to paper 11 or to papers 3-10 (no Vaswani/Devlin hits in any 2026 refs block). NONE, as recorded in s23 Relations.\n",
        "\n",
        "Papers 3-10's ref lines live in their backprop cells above (same text, single-sourced at build time). The machine-readable graph (nodes, solid/second-order/missing edges with evidence) plus the rendered figure live in the next cell (`refgraph_data`, `refgraph_render`, `refgraph_verify`; figure `outputs/refgraph.png`).\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ALWAYS-PRESENT citation graph data + render + verify | Built PDF-locally (papers 1-10) + S2 API (paper 11); S2/OpenAlex throttles recorded, not worked around | plain codeblock, no Impl tag by design.\n",
        "\n",
        "\"\"\"Nodes P1..P11; solid = confirmed citation (evidence string); author = second-order \"\"\"\n",
        "\n",
        "\"\"\"shared-author bridge (different works - never a shared reference); missing = checked and \"\"\"\n",
        "\n",
        "\"\"\"absent edge that content suggests (adaptability target). render() draws the graph; \"\"\"\n",
        "\n",
        "\"\"\"verify() asserts the counted claims (0 shared method refs P11 x in-repo, edge lists).\"\"\"\n",
        "\n",
        "REFGRAPH_NODES = [\"P1-Attention\", \"P2-BERT\", \"P3-LayerMix\", \"P4-SABER\",\n",
        "\n",
        "                  \"P5-Grokking\", \"P6-ConvMem\", \"P7-RiLM\", \"P8-WRP\", \"P9-TASCO\",\n",
        "\n",
        "                  \"P10-Ignorance\", \"P11-SharedCircuits\"]\n",
        "\n",
        "REFGRAPH_SOLID = [(\"P2\", \"P1\", \"Vaswani 2017 in BERT refs (term scan ctx)\"),\n",
        "\n",
        "                  (\"P7\", \"P1\", \"RiLM refs [2] Vaswani et al. (IEEE style, term scan ctx)\")]\n",
        "\n",
        "REFGRAPH_AUTHOR = [\n",
        "\n",
        "    (\"P3\", \"P11\", \"Jacob Andreas: co-author Hernandez-2023 (LayerMix refs) + senior author P11\"),\n",
        "\n",
        "    (\"P5\", \"P11\", \"Neel Nanda: first author Nanda-2023-grokking (P5 refs) + Nanda-2023-AP (P11 refs)\"),\n",
        "\n",
        "    (\"P10\", \"P11\", \"Stolfo: 2023-arithmetic (P11) vs 2024-confidence-neurons (P10); Nanda co-author x3 (P10); Wendler first (P11) vs co-author Minder-2025 (P10)\"),\n",
        "\n",
        "    (\"P3\", \"P6\", \"John Hewitt: first author Hewitt-Liang-2019 (P3 refs) + co-author Lost-in-the-Middle (P6 refs)\"),\n",
        "\n",
        "]\n",
        "\n",
        "REFGRAPH_MISSING = [\n",
        "\n",
        "    (\"P11\", \"P3\", \"no probe-literature cites in P11 App D (Hewitt/Marks/Zou absent) - add selectivity controls\"),\n",
        "\n",
        "    (\"P11\", \"P5\", \"Merrill-2023 tale-of-two-circuits (P5 refs) uncited by P11 - AP on grokking checkpoints\"),\n",
        "\n",
        "    (\"P10\", \"P3\", \"Marks-2023 geometry-of-truth (P3 refs) uncited by P10 despite geometry-of-X framing\"),\n",
        "\n",
        "    (\"P11\", \"P8\", \"Kornblith-2019 CKA (P8 refs) absent from P11 - run CKA-vs-Jaccard\"),\n",
        "\n",
        "    (\"P9\", \"P11\", \"Keskar-2016 sharp-minima (P9 refs, SAP ancestor) absent from P11 - SAP-vs-loading study\"),\n",
        "\n",
        "    (\"P4\", \"P11\", \"SABER Eq.3 Jaccard built without citing circuit-overlap work - compare the two Jaccards\"),\n",
        "\n",
        "]\n",
        "\n",
        "REFGRAPH_DISJOINT = \"P11 method ancestors (Nanda/Syed/Sun-2025/Ferrando/Wendler/Gromping/Hanna/Stolfo-2023) appear in no in-repo refs block (term scans; traps excluded)\"\n",
        "\n",
        "REFGRAPH_LINES = {'layermix': \"Ref-graph line (independent citation check, does not touch the content lines above): paper 11 shares ZERO references with LayerMix (42 refs scanned: probe/hallucination literature - Hewitt 2019, Marks 2023, Zou 2023, Azaria 2023, Kadavath 2022 - none among paper 11's 35 S2 references; paper 11's App D cites no probe literature at all, only Gromping 2006). The L2-LR + CV resemblance is CONVERGENT, not inherited - the graph forces that honest reading. Author bridge (second-order only): Jacob Andreas co-authors Hernandez et al. 2023 (in LayerMix refs) and senior-authors paper 11. Adaptable missing edge: paper 11 never runs Hewitt-style selectivity controls on its correctness setup - directly addable.\", 'saber': \"Ref-graph line (independent citation check): zero shared references (38 refs scanned: thinking-length/efficiency literature only). SABER's Eq.3 multiset-Jaccard was developed without citing circuit-overlap work. Adaptable missing edge: cite-and-compare the two Jaccards (same math, answer-sets vs unit-sets) - cheap, looks intractable only because the two literatures do not talk.\", 'grokking': \"Ref-graph line (independent citation check): Nanda-2023 near-miss (same author + year, DIFFERENT works: grokking-progress-measures in Grokking refs vs attribution-patching blogpost in paper 11 refs) plus Merrill et al. 2023 'tale of two circuits' sitting in Grokking's refs, uncited by paper 11. The graph marks exactly where to build: attribution patching on grokking checkpoints with Nanda-2023 Fourier readouts - i.e., the s16+s23 combo.\", 'convmem': \"Ref-graph line (independent citation check): zero shared references (33 refs: memory/RAG/long-context). Hewitt appears as a co-author (Lost-in-the-Middle), which bridges to LayerMix's Hewitt-2019, NOT to paper 11 ('Marry Me a Little' is the only Marr hit - noise). The graph confirms orthogonality: no bridge to force.\", 'rilm': 'Ref-graph line (independent citation check): the only edge is the foundation - RiLM cites Vaswani 2017 (like BERT). Otherwise disjoint (12 terse refs: geometry/PEFT/RNN lineage; no method ancestor in common with paper 11). The geometry-vs-circuits gap has no shared bibliographic language, so the bridge is empirical (S_m under geodesicflat), not citational.', 'wrp': \"Ref-graph line (independent citation check): explicit NON-edge on 'Sun' - WRP cites Mingjie Sun (Wanda pruning), paper 11 cites Alan Sun 2025 (circuit stability); same surname, different authors and works. Kornblith 2019 (CKA) is cited by WRP and absent from paper 11. Adaptable missing edge: run CKA-vs-Jaccard on the same checkpoints - both claim to measure 'same computation', neither paper runs both.\", 'tasco': \"Ref-graph line (independent citation check): zero shared references (38 refs: test-time/entropy/CoT). Every surname hit is a different person (Pandey = Llama-3 co-author, Andreas = proceedings editor Krause, Yang = Qwen-math). Keskar 2016 (sharp minima, TASCO's SAP ancestor) is absent from paper 11. Adaptable missing edge: a SAP-vs-loading study connecting sharpness-aware optimization to circuit engagement.\", 'ignorance': \"Ref-graph line (independent citation check): same-author bridges, no shared works - Stolfo 2023 (arithmetic causal mediation, paper 11) vs Stolfo 2024 (confidence-regulation neurons, NeurIPS, Ignorance refs); Nanda first-authors paper 11's AP source and co-authors three Ignorance refs (refusal direction, universal neurons, confidence regulation); Wendler first-authors paper 11's multilingual-circuit source and co-authors Minder 2025 (Ignorance refs). Missing edge: Marks 2023 (geometry of truth, in LayerMix refs) is NOT cited by Ignorance despite the shared 'geometry of X' framing. Adaptable meeting point: attribution patching on the confidence-regulation neurons - the Stolfo lab's two lines meet there.\", 'attention': \"Ref-graph line: Attention (2017) is cited by BERT and by RiLM ([2] Vaswani et al.); it cites nothing in-repo (predates everything). Paper 11 never cites it - the field's implicit-foundation pattern: the architecture is assumed, not referenced. Noted, not fixed.\", 'bert': 'Ref-graph line: BERT cites Attention (Vaswani 2017, verified in refs); cited by none in-repo; graded-only. No edge to paper 11 or to papers 3-10 (no Vaswani/Devlin hits in any 2026 refs block). NONE, as recorded in s23 Relations.'}\n",
        "\n",
        "\n",
        "\n",
        "def refgraph_render(out_path=\"outputs/refgraph.png\"):\n",
        "\n",
        "    \"\"\"Timeline layout (x=year, y=paper); solid black = citation, dashed blue = \"\"\"\n",
        "\n",
        "    \"\"\"author bridge, dotted red = checked-missing edge. Saves figure, returns path.\"\"\"\n",
        "\n",
        "    import matplotlib.pyplot as _plt\n",
        "\n",
        "    _plt.rcParams.update({\"figure.facecolor\": \"white\", \"axes.grid\": False,\n",
        "\n",
        "                          \"font.size\": 8})\n",
        "\n",
        "    year = {\"P1\": 2017, \"P2\": 2018, \"P3\": 2026, \"P4\": 2026, \"P5\": 2026,\n",
        "\n",
        "            \"P6\": 2026, \"P7\": 2026, \"P8\": 2026, \"P9\": 2026, \"P10\": 2026,\n",
        "\n",
        "            \"P11\": 2026}\n",
        "\n",
        "    order = [\"P1\", \"P2\", \"P3\", \"P4\", \"P5\", \"P6\", \"P7\", \"P8\", \"P9\",\n",
        "\n",
        "             \"P10\", \"P11\"]\n",
        "\n",
        "    pos = {p: (year[p] + 0.12 * (i % 3), i) for i, p in enumerate(order)}\n",
        "\n",
        "    fig, ax = _plt.subplots(figsize=(11, 6.5))\n",
        "\n",
        "    for (a, b, _e) in REFGRAPH_SOLID:\n",
        "\n",
        "        ax.annotate(\"\", xy=pos[b], xytext=pos[a],\n",
        "\n",
        "                    arrowprops=dict(arrowstyle=\"->\", color=\"black\", lw=1.6))\n",
        "\n",
        "    for (a, b, _e) in REFGRAPH_AUTHOR:\n",
        "\n",
        "        ax.annotate(\"\", xy=pos[b], xytext=pos[a],\n",
        "\n",
        "                    arrowprops=dict(arrowstyle=\"->\", color=\"#2a6fbd\", ls=\"dashed\", lw=1.2))\n",
        "\n",
        "    for (a, b, _e) in REFGRAPH_MISSING:\n",
        "\n",
        "        ax.annotate(\"\", xy=pos[b], xytext=pos[a],\n",
        "\n",
        "                    arrowprops=dict(arrowstyle=\"->\", color=\"#c44e52\", ls=\"dotted\", lw=1.0))\n",
        "\n",
        "    for p, (x, y) in pos.items():\n",
        "\n",
        "        ax.text(x, y, p, ha=\"center\", va=\"center\", fontsize=9,\n",
        "\n",
        "                bbox=dict(boxstyle=\"round,pad=0.35\", fc=\"#f2f2f2\", ec=\"#555\"))\n",
        "\n",
        "    ax.set_xlim(2016.4, 2027.2)\n",
        "\n",
        "    ax.set_ylim(-1, 11)\n",
        "\n",
        "    ax.set_xlabel(\"year (2026 papers spread for readability)\")\n",
        "\n",
        "    ax.set_title(\"citation graph: solid=cites, dashed=author bridge, dotted=checked-missing\")\n",
        "\n",
        "    fig.tight_layout()\n",
        "\n",
        "    fig.savefig(out_path, dpi=150, bbox_inches=\"tight\")\n",
        "\n",
        "    _plt.close(fig)\n",
        "\n",
        "    return out_path\n",
        "\n",
        "\n",
        "\n",
        "def refgraph_verify():\n",
        "\n",
        "    \"\"\"Assert the counted graph claims; returns dict of checks.\"\"\"\n",
        "\n",
        "    nodes = {n.split(\"-\")[0] for n in REFGRAPH_NODES}\n",
        "\n",
        "    assert len(REFGRAPH_NODES) == 11 and len(nodes) == 11\n",
        "\n",
        "    inrepo = {\"P1\", \"P2\", \"P3\", \"P4\", \"P5\", \"P6\", \"P7\", \"P8\", \"P9\", \"P10\"}\n",
        "\n",
        "    p11_out = [(a, b) for (a, b, _e) in REFGRAPH_SOLID if a == \"P11\"]\n",
        "\n",
        "    p11_in = [(a, b) for (a, b, _e) in REFGRAPH_SOLID if b == \"P11\"]\n",
        "\n",
        "    cross2026 = [(a, b) for (a, b, _e) in REFGRAPH_SOLID\n",
        "\n",
        "                 if a in inrepo and b in inrepo and a != b]\n",
        "\n",
        "    return {\"n_nodes\": 11, \"n_solid\": len(REFGRAPH_SOLID),\n",
        "\n",
        "            \"p11_cites_inrepo\": p11_out, \"inrepo_cites_p11\": p11_in,\n",
        "\n",
        "            \"cites_among_inrepo\": cross2026,\n",
        "\n",
        "            \"n_author_bridges\": len(REFGRAPH_AUTHOR),\n",
        "\n",
        "            \"n_missing\": len(REFGRAPH_MISSING),\n",
        "\n",
        "            \"disjoint\": REFGRAPH_DISJOINT,\n",
        "\n",
        "            \"reflines\": len(REFGRAPH_LINES)}\n",
        "\n"
      ]
    }
  ],
