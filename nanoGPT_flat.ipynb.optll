        "        self.iface_lns = nn.ModuleList([nn.LayerNorm(self.iface_width) for _ in range(_K)])\n",
        "        self.iface_alphas = nn.Parameter(torch.full((_K,), 0.5))\n",
        "        self.iface_E0 = nn.Linear(emb_dim, self.iface_width)\n",
        "        self.iface_Dterm = nn.Linear(self.iface_width, emb_dim)\n",
        "        self._iface = {}\n",
}@}
