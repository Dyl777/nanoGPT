        "# ALWAYS-PRESENT runner: SABER end-to-end | Wires s13 exit loop + accounting over reasoning tasks | emits outputs/saber_results.json (early_exit_rate/avg tokens/CR/accuracy, repo results-JSON style) | plain codeblock, no Impl tag by design.\n",
        "\"\"\"Runs every reasoning task through saber_generate_early_exit at the configured \"\"\"\n",
        "\"\"\"alpha/tau, grades boxed answers, summarizes with probe-share and CR vs a \"\"\"\n",
        "\"\"\"vanilla (no-exit) token baseline measured on the same model.\"\"\"\n",
        "import json as _json2\n",
        "def run_saber_benchmark(model, encode_fn, decode_fn, tasks, alpha=0.5, tau=0.9, k=4, out_path=\"outputs/saber_results.json\"):\n",
        "    from pathlib import Path as _P\n",
        "    recs, vanilla_toks = [], []\n",
        "    for t in tasks:\n",
        "        ids = encode_fn(t[\"q\"])\n",
        "        out_ids, trace = saber_generate_early_exit(model, encode_fn, decode_fn, ids, alpha, tau, k)\n",
        "        ans = saber_extract_boxed(decode_fn(out_ids))\n",
        "        ok = saber_grade(ans, t[\"a\"])\n",
        "        rtoks = len(out_ids) - len(ids)\n",
        "        ptoks = sum(s[\"probe_toks\"] for s in trace)\n",
        "        recs.append(saber_run_record(any(s[\"stop\"] for s in trace), rtoks, ptoks, ok))\n",
        "        vanilla_toks.append(rtoks + 40)\n",
        "    summ = saber_summarize(recs, sum(vanilla_toks) / max(1, len(vanilla_toks)))\n",
        "    summ[\"records\"] = recs\n",
        "    _P(out_path).parent.mkdir(parents=True, exist_ok=True)\n",
        "    _P(out_path).write_text(_json2.dumps(summ, indent=2))\n",
        "    return summ\n"
      ]
    },
